---
// "Stuck?": one line on every quickstart (/start and each platform page) and
// every troubleshooting page, sending a reader who is stuck to #support on the
// bitHuman Discord (the docs' tracked invite, DISCORD_URL). DocLayout places it
// after the page body by the page's `type`; /start places it under the picker.
// It is chrome, not page copy: the markdown twins and the search index leave it out.
// /start is not a prose page, so the callout carries its own link style (www's
// .mk-link: an underline, so the link never relies on colour alone).
import { DISCORD_URL } from "../config/nav";
---

<aside class="stuck" aria-label="Get help" data-pagefind-ignore>
  <p><strong>Stuck?</strong> Ask in <a href={DISCORD_URL} rel="noopener">#support on Discord</a> with your platform and version.</p>
</aside>

<style>
  /* the site's one neutral callout (prose.css blockquote) */
  .stuck {
    margin: var(--s-6) 0 0;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--color-border);
    border-radius: var(--r-10);
    background: var(--color-surface-2);
    color: var(--color-text);
  }
  .stuck p { margin: 0; color: var(--color-text); }
  .stuck a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .stuck a:hover { color: var(--color-primary-hover); }
</style>
