---
// The header, two rows (docs v2 shell).
// Row 1: mark + "Docs", the search field (⌘K), then Console, Discord (the mark
// and "Discord"; on a phone the mark alone stays, where Console moves into the
// drawer; DISCORD_URL is bithuman.ai/discord, the tracked invite), the theme
// icon and the one primary pill. Row 2: the section tabs, the active one with a
// 2 px coral underline; from 768 to 1279 px the row scrolls, below 768 px the
// tabs, the section's own pages (the `drawer` slot) and the CTA sit in a drawer.
import { TOP_NAV, API_SECRET_URL, CONSOLE_URL, DISCORD_URL } from "../config/nav";
import DiscordMark from "./DiscordMark.astro";
const links = TOP_NAV;
// Status lives in the footer; the Overview tab holds the resource pages.
const path = Astro.url.pathname;
const under = (href: string) => path === href || (href !== "/" && path.startsWith(href + "/"));
const isActive = (l: { href: string; match?: string[] }) => [l.href, ...(l.match ?? [])].some(under);
const hasDrawer = Astro.slots.has("drawer");
---

<header class="nav" data-pagefind-ignore>
  <div class="nav-row1">
    <a class="brand" href="/" aria-label="bitHuman docs home">
      <img src="/images/bitHuman-logo-circle-52.webp" alt="" width="24" height="24" />
      <span>Docs</span>
    </a>

    <button class="nav-search" id="nav-search" type="button" aria-label="Search" onclick="window.__bhOpenSearch && window.__bhOpenSearch()">
      <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"
        ><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="m14 14 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg
      >
      <span class="nav-search-txt">Search</span>
      <kbd data-search-key>⌘K</kbd>
    </button>

    <div class="nav-actions">
      <a class="nav-console" href={CONSOLE_URL} rel="noopener">Console</a>
      <a class="nav-discord" href={DISCORD_URL} rel="noopener" aria-label="Join the bitHuman community on Discord" title="Join us on Discord">
        <DiscordMark size={18} />
        <span class="nav-discord-txt">Discord</span>
      </a>
      <button class="icon-btn" type="button" aria-label="Toggle theme" onclick="__bhToggleTheme()">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"
          ><circle cx="10" cy="10" r="4" fill="currentColor"></circle><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16"></path></g></svg
        >
        <svg class="i-moon" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"
          ><path d="M16 11.5A6.5 6.5 0 0 1 8.5 4a6.5 6.5 0 1 0 7.5 7.5Z" fill="currentColor"></path></svg
        >
      </button>
      <a class="btn-cta" href={API_SECRET_URL} target="_blank" rel="noopener">Get API secret</a>
      <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-drawer" onclick="__bhToggleMenu(this)">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>

  <div class="nav-row2">
    <nav class="nav-tabs" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class:list={["nav-tab", { active: isActive(l) }]} aria-current={isActive(l) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="mobile-menu" id="nav-drawer">
    <nav class="mm-group" aria-label="Sections">
      {links.map((l) => <a href={l.href} class:list={{ active: isActive(l) }}>{l.label}</a>)}
    </nav>
    {hasDrawer && <div class="mm-sep"></div>}
    {hasDrawer && <div class="mm-section"><slot name="drawer" /></div>}
    <div class="mm-sep"></div>
    <nav class="mm-group mm-console" aria-label="Account">
      <a href={CONSOLE_URL} rel="noopener">Console</a>
    </nav>
    <a class="mm-cta" href={API_SECRET_URL} target="_blank" rel="noopener">Get API secret</a>
  </div>
</header>

<script>
  // The search shortcut is Ctrl+K everywhere but on Apple keyboards, and the
  // hint should name the key the reader actually has.
  if (!/Mac|iPhone|iPad|iPod/.test(navigator.platform)) {
    document.querySelectorAll("[data-search-key]").forEach((k) => (k.textContent = "Ctrl K"));
  }
  // Keep the active tab in view when the row scrolls (768–1279 px).
  document.querySelector(".nav-tab.active")?.scrollIntoView({ block: "nearest", inline: "center" });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-row1 {
    height: var(--hdr-h);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--s-6);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
    font-size: var(--ft-lg);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }
  .brand img { border-radius: var(--r-pill); }

  .nav-search {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    width: 240px;
    height: 36px;
    padding-inline: var(--s-3);
    border: 1px solid var(--color-border);
    border-radius: var(--r-6);
    background: var(--color-surface-2);
    color: var(--color-text-tertiary);
    font-size: var(--ft-sm);
    transition: border-color var(--t-fast) var(--ease);
  }
  .nav-search:hover { border-color: var(--color-border-strong); }
  .nav-search-txt { flex: 1; text-align: left; }
  .nav-search kbd { font-family: var(--font-sans); font-size: var(--ft-xs); color: var(--color-text-tertiary); }

  .nav-actions { margin-left: auto; display: flex; align-items: center; gap: var(--s-2); }
  .nav-console {
    padding: var(--s-2) var(--s-3);
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    transition: color var(--t-fast) var(--ease);
  }
  .nav-console:hover { color: var(--color-text); }
  /* Discord, the community home: the mark in Discord's colour and the word, a quiet
     outlined pill beside Console (the coral pill stays the one primary action). */
  .nav-discord {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 36px;
    padding-inline: var(--s-3);
    border: 1px solid var(--color-border);
    border-radius: var(--r-pill);
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .nav-discord :global(svg) { color: var(--color-discord); flex: none; }
  .nav-discord:hover { color: var(--color-text); border-color: var(--color-border-strong); background: var(--color-surface-2); }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--r-6);
    background: transparent;
    color: var(--color-text-secondary);
    transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .icon-btn:hover { color: var(--color-text); background: var(--color-surface-2); }
  .i-moon { display: none; }
  :root[data-theme="dark"] .i-sun { display: none; }
  :root[data-theme="dark"] .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .i-sun { display: none; }
    :root:not([data-theme="light"]) .i-moon { display: block; }
  }
  .btn-cta {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding-inline: var(--s-4);
    border-radius: var(--r-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    transition: background var(--t-fast) var(--ease);
  }
  .btn-cta:hover { background: var(--color-primary-hover); }
  .menu-btn { display: none; }

  /* row 2: the tabs */
  .nav-row2 {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--s-6);
  }
  .nav-tabs {
    height: var(--tabs-h);
    display: flex;
    align-items: stretch;
    gap: var(--s-6);
  }
  .nav-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    flex: none;
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--t-fast) var(--ease);
  }
  .nav-tab:hover { color: var(--color-text); }
  .nav-tab.active { color: var(--color-text); }
  .nav-tab.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-primary);
  }

  /* the drawer (below 768 px) */
  .mobile-menu { display: none; }

  @media (max-width: 1279px) {
    .nav-search { width: 180px; }
    /* The tab row scrolls instead of dropping tabs (the 1024 px bug). */
    .nav-row2 { overflow-x: auto; scrollbar-width: none; }
    .nav-row2::-webkit-scrollbar { display: none; }
  }
  /* 768–1023: the tab row stays and a drawer holds the section's pages */
  @media (max-width: 1023px) {
    .menu-btn { display: inline-flex; }
    .mobile-menu {
      display: none;
      flex-direction: column;
      max-height: calc(100vh - var(--nav-h));
      overflow-y: auto;
      padding: var(--s-2) var(--s-6) var(--s-6);
      border-top: 1px solid var(--color-border);
      background: var(--color-bg);
    }
    :root.nav-open .mobile-menu { display: flex; }
    .mm-group { display: flex; flex-direction: column; }
    .mobile-menu a {
      display: block;
      padding: var(--s-2) 0;
      font-size: var(--ft-md);
      color: var(--color-text-secondary);
    }
    .mobile-menu a.active, .mobile-menu a:hover { color: var(--color-text); }
    .mm-sep { height: 1px; margin-block: var(--s-2); background: var(--color-border); }
    .mobile-menu a.mm-cta {
      margin-top: var(--s-2);
      padding: var(--s-3) var(--s-4);
      border-radius: var(--r-pill);
      text-align: center;
      background: var(--color-primary);
      color: var(--color-on-primary);
      font-weight: var(--fw-medium);
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    /* the tabs are on screen already */
    .mm-group[aria-label="Sections"], .mm-group[aria-label="Sections"] + .mm-sep { display: none; }
  }
  /* below 768: compact header; tabs, section pages and CTA live in the drawer */
  @media (max-width: 767px) {
    .nav-row1 { padding-inline: var(--s-4); gap: var(--s-3); }
    .nav-row2 { display: none; }
    .nav-search { width: 36px; padding: 0; justify-content: center; border: 0; background: transparent; margin-left: auto; }
    .nav-search-txt, .nav-search kbd { display: none; }
    .nav-actions { margin-left: 0; gap: var(--s-1); }
    .nav-console, .btn-cta { display: none; }
    /* a phone keeps the Discord mark alone, the size of the other icon buttons */
    .nav-discord { width: 36px; padding: 0; justify-content: center; border-color: transparent; border-radius: var(--r-6); }
    .nav-discord-txt { display: none; }
    .mobile-menu { padding-inline: var(--s-4); }
  }
</style>
