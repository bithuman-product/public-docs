---
// A hub page: an H1, one line of purpose, then groups of cards. The cards are
// the site's one Card; a hub adds no card style of its own.
import Base from "../layouts/Base.astro";
import Button from "./Button.astro";
import Card from "./Card.astro";

interface HubCard { title: string; desc: string; href: string; badge?: string; external?: boolean; }
/** `was`: the ids this group had under an older name (docs v2 W2b), kept so old links land here. */
interface Group { label: string; line?: string; cards: HubCard[]; was?: string[]; }
interface CTA { label: string; href: string; variant?: "primary" | "secondary"; external?: boolean; }
interface Props {
  title: string;
  tagline: string;
  ctas?: CTA[];
  groups: Group[];
  /** The search section label this hub belongs to (the section chips in ⌘K search). */
  section?: string;
}
const { title, tagline, ctas = [], groups, section } = Astro.props;
const idOf = (s: string) => "g-" + s.replace(/\W+/g, "-").toLowerCase();
---

<Base title={`${title} — bitHuman docs`} description={tagline}>
  <div class="container hub" data-pagefind-filter={section ? `section:${section}` : undefined}>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Docs</a> <span aria-hidden="true">/</span> <span>{title}</span></nav>
    <h1>{title}</h1>
    <p class="lede" data-subtitle>{tagline}</p>
    {ctas.length > 0 && (
      <div class="hub-cta">
        {ctas.map((c) => <Button href={c.href} variant={c.variant ?? "primary"} external={c.external}>{c.label}</Button>)}
      </div>
    )}
    {groups.map((g) => (
      <section class="hub-group" aria-labelledby={idOf(g.label)}>
        {(g.was ?? []).map((id) => <span id={id} class="hub-was"></span>)}
        <div class="band-head">
          <h2 id={idOf(g.label)}>{g.label}</h2>
          {g.line && <p>{g.line}</p>}
        </div>
        <ul class="card-grid cols-3" role="list">
          {g.cards.map((c) => <li><Card href={c.href} title={c.title} line={c.desc || undefined} badge={c.badge} external={c.external} /></li>)}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .hub { padding-block: var(--s-8) var(--s-12); }
  .crumb { font-size: var(--ft-sm); color: var(--color-text-tertiary); margin-bottom: var(--s-3); }
  .crumb a { color: var(--color-text-tertiary); }
  .crumb a:hover { color: var(--color-primary); }
  .hub h1 { font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: -0.02em; }
  .lede { margin-top: var(--s-3); font-size: var(--ft-lg); color: var(--color-text-secondary); max-width: 62ch; }
  .hub-cta { display: flex; gap: var(--s-3); margin-top: var(--s-6); flex-wrap: wrap; }
  .hub-group { margin-top: var(--s-10); }

</style>
