---
// A line drawing of where the avatar renders: a phone, a Mac, a browser, a
// Linux PC, a terminal or the cloud. Inline SVG in the text colour, no image
// request; the label beside it names the device, so the drawing is decorative.
import { DEVICE_PATHS, type DeviceKind } from "../data/device-frames.ts";
interface Props { device: DeviceKind; size?: number }
const { device, size = 44 } = Astro.props;
---
<svg class="device-frame" width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={DEVICE_PATHS[device]} />
