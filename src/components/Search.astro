---
// ⌘K search over the Pagefind index (built by `pagefind --site dist` after
// `astro build`, so it works on the built site, not in `astro dev`). The
// Pagefind engine loads on first open; this component draws its own results:
// section chips over the results (the section filter every page carries),
// each result tagged with its section, and a "Popular" list while the box is
// empty. Arrow keys move through the results; Esc closes.
import { SECTIONS } from "../config/nav";

const POPULAR = [
  { label: "Quickstart", href: "/start" },
  { label: "iOS & iPadOS", href: "/platforms/ios" },
  { label: "Android", href: "/platforms/android" },
  { label: "Web embed", href: "/platforms/web" },
  { label: "Deployment options", href: "/deploy" },
  { label: "Pricing and credits", href: "/pricing" },
  { label: "Performance", href: "/performance" },
];
const ORDER = Object.values(SECTIONS).map((s) => s.label);
---

<div id="search-modal" class="sm" aria-hidden="true" data-pagefind-ignore="all" data-order={JSON.stringify(ORDER)}>
  <div class="sm-backdrop" data-sm-close></div>
  <div class="sm-panel" role="dialog" aria-modal="true" aria-label="Search docs">
    <div class="sm-head">
      <svg class="sm-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="sm-q" class="sm-q" type="search" placeholder="Search the docs" autocomplete="off" spellcheck="false" aria-label="Search the docs" aria-controls="sm-results" aria-describedby="sm-status" />
      <button class="sm-close" type="button" data-sm-close aria-label="Close search">Esc</button>
    </div>
    <div class="sm-facets" role="group" aria-label="Filter by section" hidden></div>
    <div class="sm-body">
      <p id="sm-status" class="sm-status" aria-live="polite"></p>
      <ol id="sm-results" class="sm-results" aria-label="Results"></ol>
      <div class="sm-popular">
        <p class="sm-label">Popular</p>
        <ul>
          {POPULAR.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  type Sub = { title: string; url: string; excerpt: string };
  type Data = { url: string; meta: { title?: string }; excerpt: string; filters?: Record<string, string[]>; sub_results?: Sub[] };
  type PF = {
    options: (o: object) => Promise<void>;
    init: () => Promise<void>;
    filters: () => Promise<object>;
    debouncedSearch: (q: string, o: object, ms: number) => Promise<null | { results: { data: () => Promise<Data> }[]; totalFilters?: Record<string, Record<string, number>> }>;
  };

  const modal = document.getElementById("search-modal")!;
  const input = modal.querySelector<HTMLInputElement>("#sm-q")!;
  const list = modal.querySelector<HTMLOListElement>("#sm-results")!;
  const status = modal.querySelector<HTMLElement>("#sm-status")!;
  const facets = modal.querySelector<HTMLElement>(".sm-facets")!;
  const popular = modal.querySelector<HTMLElement>(".sm-popular")!;
  const order: string[] = JSON.parse(modal.dataset.order || "[]");
  let pf: Promise<PF | null> | null = null;
  let section = "";
  let opener: HTMLElement | null = null;

  const load = () =>
    (pf ??= import(/* @vite-ignore */ `${"/pagefind/"}pagefind.js`)
      .then(async (m: PF) => { await m.options({ excerptLength: 22 }); await m.init(); await m.filters(); return m; })
      .catch(() => null));

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const path = (u: string) => u.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/$/, "") || "/";
  // Pagefind excerpts are text with <mark> around matches; keep only those tags.
  const unesc = (s: string) => s.replace(/&(amp|lt|gt|quot|#39|#x27);/g, (_, e) => ({ amp: "&", lt: "<", gt: ">", quot: '"', "#39": "'", "#x27": "'" })[e as string]!);
  const excerpt = (s: string) => esc(unesc(s.replace(/<\/?mark>/g, "\u0001"))).replace(/\u0001([^\u0001]*)\u0001/g, "<mark>$1</mark>");

  function renderFacets(counts: Record<string, number>, total: number) {
    const names = Object.keys(counts).filter((k) => counts[k] > 0).sort((a, b) => order.indexOf(a) - order.indexOf(b));
    facets.hidden = names.length < 2 && !section;
    facets.innerHTML = [["", total] as [string, number], ...names.map((n) => [n, counts[n]] as [string, number])]
      .map(([n, c]) => `<button type="button" class="sm-facet" data-section="${esc(n)}" aria-pressed="${n === section}">${esc(n || "All")} <span>${c}</span></button>`)
      .join("");
  }

  async function run() {
    const q = input.value.trim();
    popular.hidden = !!q;
    if (!q) { list.innerHTML = ""; status.textContent = ""; facets.hidden = true; return; }
    const engine = await load();
    if (!engine) { status.textContent = "Search is available on the published site."; return; }
    const res = await engine.debouncedSearch(q, section ? { filters: { section } } : {}, 150);
    if (!res || q !== input.value.trim()) return;
    const top = await Promise.all(res.results.slice(0, 10).map((r) => r.data()));
    const counts = res.totalFilters?.section ?? {};
    const total = (res as { unfilteredResultCount?: number }).unfilteredResultCount ?? res.results.length;
    renderFacets(counts, total);
    status.textContent = top.length ? `${res.results.length} result${res.results.length === 1 ? "" : "s"}` : `No results for “${q}”.`;
    list.innerHTML = top.map((d) => {
      const sec = d.filters?.section?.[0];
      // a section of the page is worth a line only when its heading names what was typed
      const words = q.toLowerCase().split(/\s+/).filter((w) => w.length > 1);
      const subs = (d.sub_results ?? []).filter((s) => s.url !== d.url && words.some((w) => s.title.toLowerCase().includes(w))).slice(0, 2);
      return `<li><a class="sm-hit" href="${esc(path(d.url))}"><span class="sm-top">${sec ? `<span class="sm-sec">${esc(sec)}</span>` : ""}<span class="sm-title">${esc(d.meta.title ?? d.url)}</span></span><span class="sm-ex">${excerpt(d.excerpt)}</span></a>` +
        (subs.length ? `<ul class="sm-subs">${subs.map((s) => `<li><a class="sm-hit sm-sub" href="${esc(path(s.url.split("#")[0]) + (s.url.includes("#") ? "#" + s.url.split("#")[1] : ""))}">${esc(s.title)}</a></li>`).join("")}</ul>` : "") + `</li>`;
    }).join("");
  }

  function open() {
    opener = document.activeElement as HTMLElement | null;
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    input.focus();
    input.select();
    load();
  }
  function close() {
    if (!modal.classList.contains("open")) return;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    opener?.focus?.();
  }
  (window as any).__bhOpenSearch = open;

  input.addEventListener("input", run);
  facets.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>(".sm-facet");
    if (!b) return;
    section = b.dataset.section ?? "";
    run();
  });
  modal.querySelectorAll("[data-sm-close]").forEach((el) => el.addEventListener("click", close));
  modal.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
    const links = [...modal.querySelectorAll<HTMLAnchorElement>(popular.hidden ? ".sm-hit" : ".sm-popular a")];
    if (!links.length) return;
    e.preventDefault();
    const i = links.indexOf(document.activeElement as HTMLAnchorElement);
    const next = e.key === "ArrowDown" ? (i < 0 ? 0 : Math.min(i + 1, links.length - 1)) : i <= 0 ? -1 : i - 1;
    (next < 0 ? input : links[next]).focus();
  });
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      modal.classList.contains("open") ? close() : open();
    } else if (e.key === "Escape") close();
  });
</script>

<style>
  .sm { position: fixed; inset: 0; z-index: 200; display: none; }
  .sm.open { display: block; }
  .sm-backdrop { position: absolute; inset: 0; background: var(--color-scrim); backdrop-filter: blur(3px); }
  .sm-panel {
    position: relative; display: flex; flex-direction: column;
    max-width: 640px; max-height: min(640px, 80vh); margin: 10vh auto 0;
    background: var(--color-elevated); border: 1px solid var(--color-border); border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg); overflow: hidden;
  }
  .sm-head { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--color-border); }
  .sm-icon { flex: none; color: var(--color-text-tertiary); }
  .sm-q { flex: 1; min-width: 0; border: 0; background: none; color: var(--color-text); font: inherit; font-size: var(--ft-lg); padding: var(--s-1) 0; }
  .sm-q:focus { outline: none; }
  .sm-q::-webkit-search-cancel-button { display: none; }
  .sm-close { flex: none; font-size: var(--ft-xs); color: var(--color-text-tertiary); background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--r-sm); padding: 0.2rem 0.45rem; cursor: pointer; }
  .sm-facets { display: flex; flex-wrap: wrap; gap: var(--s-2); padding: var(--s-3) var(--s-4) 0; }
  .sm-facets[hidden] { display: none; }
  .sm-facets :global(.sm-facet) { padding: 0.2rem 0.7rem; border: 0; border-radius: var(--r-pill); background: none; color: var(--color-text-secondary); font: inherit; font-size: var(--ft-xs); font-weight: var(--fw-regular); cursor: pointer; }
  .sm-facets :global(.sm-facet span) { color: var(--color-text-tertiary); font-weight: var(--fw-regular); margin-left: 0.15rem; }
  .sm-facets :global(.sm-facet:hover) { color: var(--color-text); }
  .sm-facets :global(.sm-facet[aria-pressed="true"]) { background: var(--color-surface-3); color: var(--color-text); }
  .sm-facets :global(.sm-facet:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .sm-body { overflow-y: auto; padding: var(--s-2) var(--s-2) var(--s-3); }
  .sm-status { margin: var(--s-1) var(--s-2) var(--s-2); font-size: var(--ft-xs); color: var(--color-text-tertiary); }
  .sm-status:empty { display: none; }
  .sm-results, .sm-popular ul, .sm-results :global(.sm-subs) { list-style: none; margin: 0; padding: 0; }
  .sm-results :global(.sm-hit) { display: flex; flex-direction: column; gap: 0.2rem; padding: var(--s-2) var(--s-3); border-radius: var(--r-md); color: var(--color-text); text-decoration: none; }
  .sm-results :global(.sm-hit:hover), .sm-results :global(.sm-hit:focus-visible) { background: var(--color-surface-2); outline: none; }
  .sm-results :global(.sm-hit:focus-visible) { box-shadow: inset 0 0 0 2px var(--color-primary); }
  .sm-results :global(.sm-top) { display: flex; align-items: center; gap: var(--s-2); min-width: 0; }
  .sm-results :global(.sm-sec) { flex: none; font-size: var(--ft-xs); color: var(--color-text-tertiary); }
  .sm-results :global(.sm-title) { font-weight: var(--fw-medium); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sm-results :global(.sm-ex) { font-size: var(--ft-sm); line-height: var(--lh-snug); color: var(--color-text-secondary); }
  .sm-results :global(mark) { background: none; color: var(--color-text); font-weight: var(--fw-medium); }
  .sm-results :global(.sm-subs) { margin: -0.1rem 0 var(--s-1) var(--s-4); border-left: 1px solid var(--color-border); }
  .sm-results :global(.sm-sub) { padding: var(--s-1) var(--s-3); font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .sm-popular[hidden] { display: none; }
  .sm-label { margin: var(--s-1) var(--s-2) var(--s-2); font-size: var(--ft-xs); font-weight: var(--fw-regular);  color: var(--color-text-tertiary); }
  .sm-popular a { display: block; padding: var(--s-2) var(--s-3); border-radius: var(--r-md); color: var(--color-text); text-decoration: none; font-size: var(--ft-sm); }
  .sm-popular a:hover, .sm-popular a:focus-visible { background: var(--color-surface-2); outline: none; }
  .sm-popular a:focus-visible { box-shadow: inset 0 0 0 2px var(--color-primary); }
  @media (max-width: 640px) {
    .sm-panel { margin: 0; max-width: none; max-height: 100dvh; height: 100dvh; border-radius: 0; border: 0; }
  }
</style>
