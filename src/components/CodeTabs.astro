---
// Code in tabs, rendered at build time. With JavaScript off every panel shows
// under its label; with it on one panel shows, and src/scripts/tabs-sync.ts
// keeps every group with the same key (lang, platform, model) on the reader's
// last choice, site-wide. Copy leaves out the `# →` lines that show output.
import { Code } from "astro:components";
import { groupOf, keyFor, stripOutput, type StateName } from "../lib/ui-state";

interface Tab {
  label: string;
  lang: string;
  code: string;
}
interface Props {
  tabs: Tab[];
  title?: string;
  /** Which choice these tabs follow; inferred from the labels when omitted. */
  group?: StateName;
}
const { tabs, title, group } = Astro.props;
const name = group ?? groupOf(tabs.map((t) => t.label));
const themes = { light: "github-light-high-contrast", dark: "github-dark" } as const;
// A stable id from the content, so builds are reproducible.
let h = 0;
for (const c of JSON.stringify(tabs)) h = (Math.imul(h, 31) + c.charCodeAt(0)) | 0;
const uid = `ct-${(h >>> 0).toString(36)}`;
const single = tabs.length === 1;
---

<div class="codetabs" data-codetabs data-tabs={single ? undefined : ""} data-group={name}>
  <div class="ct-bar">
    {single ? (
      <span class="ct-one">{tabs[0].label}</span>
    ) : (
      <div class="ct-tabs" role="tablist" aria-label={title ?? "Code examples"}>
        {tabs.map((t, i) => (
          <button type="button" class:list={["ct-tab", { active: i === 0 }]} role="tab" id={`${uid}-${i}`} aria-controls={`${uid}-${i}-p`}
            aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={t.label} data-key={keyFor(name, t.label)}>
            {t.label}
          </button>
        ))}
      </div>
    )}
    <button type="button" class="ct-copy" data-copy aria-label="Copy code">
      <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      <span>Copy</span>
    </button>
  </div>
  <div class="ct-panels">
    {tabs.map((t, i) => (
      <div class:list={["ct-panel", { active: i === 0 }]} role={single ? undefined : "tabpanel"} id={`${uid}-${i}-p`}
        aria-labelledby={single ? undefined : `${uid}-${i}`} data-raw={stripOutput(t.code)}>
        {!single && <p class="ct-label">{t.label}</p>}
        <Code code={t.code} lang={t.lang as any} themes={themes} />
      </div>
    ))}
  </div>
</div>

<script>
  import "../scripts/tabs-sync";
  document.querySelectorAll<HTMLElement>("[data-codetabs]").forEach((root) => {
    const btn = root.querySelector<HTMLElement>("[data-copy]");
    btn?.addEventListener("click", async () => {
      const active = root.querySelector<HTMLElement>(".ct-panel.active");
      try {
        await navigator.clipboard.writeText(active?.dataset.raw ?? "");
        const label = btn.querySelector("span")!;
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy"), 1400);
      } catch (_) {}
    });
  });
</script>

<style>
  .codetabs {
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-code-bg);
    box-shadow: var(--shadow-sm);
  }
  .ct-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.3rem 0.45rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }
  .ct-tabs { display: flex; gap: 0.12rem; flex-wrap: wrap; }
  .ct-tab {
    padding: 0.32rem 0.7rem;
    border: 0;
    border-radius: var(--r-md);
    background: none;
    color: var(--color-text-secondary);
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
    transition: all var(--t-fast) var(--ease);
  }
  .ct-tab:hover { color: var(--color-text); }
  .ct-tab.active { color: var(--color-primary); background: var(--color-primary-soft); }
  .ct-tab:focus-visible, .ct-copy:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  .ct-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.6rem;
    border: 0;
    border-radius: var(--r-md);
    background: none;
    color: var(--color-text-tertiary);
    font-size: var(--ft-xs);
    transition: color var(--t-fast) var(--ease);
  }
  .ct-copy:hover { color: var(--color-text); }
  .ct-one { padding: 0.32rem 0.7rem; font-size: var(--ft-xs); font-weight: var(--fw-medium); color: var(--color-text-tertiary); }
  .ct-tabs { display: none; }
  :global(.js) .ct-tabs { display: flex; }
  .ct-label { margin: 0; padding: var(--s-2) var(--s-6) 0; font-size: var(--ft-xs); font-weight: var(--fw-medium); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-tertiary); }
  :global(.js) .ct-label { display: none; }
  :global(.js) .ct-panel:not(.active) { display: none; }
  .ct-panel + .ct-panel { border-top: 1px solid var(--color-border); }
  :global(.js) .ct-panel + .ct-panel { border-top: 0; }
  .codetabs :global(pre) {
    margin: 0;
    padding: var(--s-4) var(--s-6);
    font-family: var(--font-mono);
  }
</style>
