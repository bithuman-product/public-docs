---
// The bitHuman banner at the head of the Platforms hub, one image per theme
// (owner, 2026-09-29: first on the home page, then moved here because it
// clashed with the home page's images below it). Both images are in the page and
// [data-theme] on <html> shows one, the way the nav's sun and moon icons swap,
// so a reader's theme toggle swaps the banner with no script and no request.
// It sits above the fold, so neither image is lazy; the light one (the
// markup's default theme) is the one a first paint needs and gets priority. Both are cut to the light
// banner's 1400:391 frame, so a toggle does not move the page.
const light = "/images/banner/bithuman-banner";
const dark = "/images/banner/bithuman-banner-black";
const sizes = "(max-width: 560px) calc(100vw - 32px), (max-width: 1200px) calc(100vw - 48px), 1152px";
---

<figure class="platforms-banner" data-pagefind-ignore>
  <picture class="hb-light">
    <source type="image/webp" srcset={`${light}-800.webp 800w, ${light}-1400.webp 1400w`} sizes={sizes} />
    <img src="/images/bithuman-banner.jpg" width="1400" height="391" alt="The word bitHuman spelled in furry, colourful letters with small cartoon creatures" loading="eager" fetchpriority="high" decoding="async" />
  </picture>
  <picture class="hb-dark">
    <source type="image/webp" srcset={`${dark}-800.webp 800w, ${dark}-1386.webp 1386w`} sizes={sizes} />
    <img src="/images/bitHuman_banner_black.jpg" width="1386" height="554" alt="The word bitHuman spelled in furry, colourful letters with small cartoon creatures" loading="eager" decoding="async" />
  </picture>
</figure>

<style>
  .platforms-banner { margin: 0; }
  .platforms-banner img {
    display: block; width: 100%; height: auto; aspect-ratio: 1400 / 391;
    object-fit: cover; object-position: 50% 50%; border-radius: var(--r-lg);
  }
  .hb-dark { display: none; }
  :root[data-theme="dark"] .hb-light { display: none; }
  :root[data-theme="dark"] .hb-dark { display: block; }
</style>
