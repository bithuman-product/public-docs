---
// A small label under an H1 or on a card: where it renders, what it needs,
// the plan, a model, a version or a speed. Neutral surface; the kind only
// picks the icon. The label vocabulary is fixed in STYLE.md.
interface Props { kind?: "availability" | "where" | "needs" | "model" | "version" | "speed" | "time"; label: string; href?: string }
const { kind = "where", label, href } = Astro.props;
const ICON: Record<string, string> = {
  availability: '<path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/>',
  where: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  needs: '<path d="M9 11l2 2 4-4"/><rect x="4" y="4" width="16" height="16" rx="3"/>',
  model: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>',
  version: '<path d="M4 12l8-8h7v7l-8 8z"/><circle cx="15.5" cy="8.5" r="1.3"/>',
  speed: '<path d="M4 16a8 8 0 1 1 16 0"/><path d="M12 16l4-5"/>',
  time: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
};
const Tag = href ? "a" : "span";
---
<Tag class:list={["chip", `chip-${kind}`]} href={href}>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICON[kind]} />
  {label}
</Tag>
