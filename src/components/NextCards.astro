---
// The foot of every page: one to three places to go next, as cards.
import Card from "./Card.astro";
interface Item { href: string; title: string; line?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <nav class="next-cards" aria-labelledby="next-cards-title" data-pagefind-ignore>
    <h2 id="next-cards-title" class="next-title">Next</h2>
    <div class:list={["card-grid", `cols-${Math.min(items.length, 3)}`]}>
      {items.map((i) => <Card href={i.href} title={i.title} line={i.line} h={3} />)}
    </div>
  </nav>
)}
<style>
  .next-cards { margin-top: var(--s-12); }
  .next-title { font-size: var(--ft-sm); font-weight: var(--fw-medium); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-tertiary); margin: 0 0 var(--s-3); }
</style>
