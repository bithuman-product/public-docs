---
// What a reader should see after running a block: output, a file, or a result.
interface Props { summary?: string; open?: boolean }
const { summary = "Expected", open = true } = Astro.props;
---
<details class="expected" open={open}>
  <summary>{summary}</summary>
  <div class="expected-body"><slot /></div>
</details>
<!-- styles: components.css (".prose details.expected"), shared with the ```expected block -->
