---
// The footer, one design everywhere: row 1 the site links (Status first, with
// the live service dot; Discord, the community home, with its mark), row 2 the
// legal links and the ©.
import { FOOTER_LINKS, LEGAL_LINKS, DISCORD_URL } from "../config/nav";
import DiscordMark from "./DiscordMark.astro";
const year = 2026;
---

<footer class="footer" data-pagefind-ignore>
  <div class="footer-inner">
    <nav class="footer-row" aria-label="Site">
      {
        FOOTER_LINKS.map((l) => (
          <a href={l.href} {...(l.external ? { rel: "noopener" } : {})} {...(l.href.startsWith("https://status.") ? { id: "bh-status", title: "Service status" } : {})}>
            {l.href.startsWith("https://status.") && <span class="status-dot" aria-hidden="true" />}
            {l.href === DISCORD_URL && <DiscordMark size={16} class="footer-discord" />}
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="footer-row footer-legal">
      {LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
      <span class="footer-copy">© {year} bitHuman</span>
    </div>
  </div>
</footer>

<script>
  // Live service health: the public, CORS-enabled status summary colours the
  // dot beside "Status". Fails silently (the dot stays neutral).
  (async () => {
    const el = document.getElementById("bh-status");
    if (!el) return;
    try {
      const r = await fetch("https://status.bithuman.ai/summary.json", { cache: "no-store" });
      if (!r.ok) return;
      const d = await r.json();
      const cls = ({ operational: "op", degraded: "deg", down: "down" } as Record<string, string>)[d.status];
      if (cls) el.classList.add(cls);
      if (d.text) el.setAttribute("title", d.text);
    } catch (_) {
      /* CORS/offline — leave the dot neutral */
    }
  })();
</script>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--s-16);
  }
  .footer-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--s-8) var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-6);
    font-size: var(--ft-sm);
  }
  .footer-row a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--color-text-secondary);
    transition: color var(--t-fast) var(--ease);
  }
  .footer-row a:hover { color: var(--color-text); }
  .footer-row :global(.footer-discord) { color: var(--color-discord); flex: none; }
  .footer-legal { font-size: var(--ft-xs); }
  .footer-legal a, .footer-copy { color: var(--color-text-tertiary); }
  .footer-copy { margin-left: auto; }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--color-text-tertiary);
    flex: none;
  }
  #bh-status.op .status-dot { background: var(--color-status-ok); }
  #bh-status.deg .status-dot { background: var(--color-status-warn); }
  #bh-status.down .status-dot { background: var(--color-status-down); }
  @media (max-width: 767px) {
    .footer-inner { padding-inline: var(--s-4); }
    .footer-copy { margin-left: 0; width: 100%; }
  }
</style>
