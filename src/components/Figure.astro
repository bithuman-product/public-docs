---
// Real captures: the ```figure block (one capture in its device frame, with
// its provenance) and the example gallery's cards. The markup is drawn at build
// time by src/lib/showcase.ts from src/data/examples.ts; DocLayout renders this
// component only on a page that places one. The script plays a muted loop
// only while it is on screen (never with reduced motion or Save-Data) and
// swaps in the recording with sound and captions on a click.
---

<script>
  import "../scripts/figure";
</script>

<style is:global>
  /* the frame: a phone's bezel, or a window's title bar */
  .fig-media { position: relative; display: block; overflow: hidden; width: 100%; box-sizing: border-box; background: var(--color-surface-3); border: 1px solid var(--color-border); border-radius: var(--r-lg); isolation: isolate; }
  .fig-media > picture, .fig-media img, .fig-media video { display: block; width: 100%; height: 100%; }
  .fig-media img, .fig-media video { object-fit: cover; object-position: 50% 30%; margin: 0 !important; border: 0 !important; border-radius: inherit !important; max-height: none !important; background: none !important; }
  .fig-media > :is(.fig-loop, .fig-clip) { position: absolute; left: var(--dev-pad, 0); top: var(--dev-top, 0); width: calc(100% - 2 * var(--dev-pad, 0px)); height: calc(100% - var(--dev-top, 0px) - var(--dev-pad, 0px)); }
  /* The loop sits 1 px inside the poster on every side: a strictly smaller paint
     is never a new Largest Contentful Paint, so a loop starting after load
     cannot move the page's LCP from the poster to itself. */
  .fig-media > .fig-loop { left: calc(var(--dev-pad, 0px) + 1px); top: calc(var(--dev-top, 0px) + 1px); width: calc(100% - 2 * var(--dev-pad, 0px) - 2px); height: calc(100% - var(--dev-top, 0px) - var(--dev-pad, 0px) - 2px); }
  .fig-loop { opacity: 0; transition: opacity var(--t-med) var(--ease); pointer-events: none; }
  .fig-loop.on { opacity: 1; }
  .fig-clip { object-fit: contain !important; background: var(--color-media-bg) !important; z-index: 2; }
  /* the loop covers exactly the poster (never a pixel more, so it is not a new, larger paint) */
  .dev-iphone, .dev-android { --dev-pad: 5px; --dev-top: 5px; padding: var(--dev-pad); border: 0; background: var(--color-bezel); border-radius: var(--r-device); box-shadow: 0 0 0 1px var(--color-border-strong); }
  .dev-iphone > picture, .dev-android > picture { overflow: hidden; border-radius: var(--r-device-screen); }
  .dev-iphone > :is(.fig-loop, .fig-clip), .dev-android > :is(.fig-loop, .fig-clip) { border-radius: var(--r-device-screen) !important; }
  /* window frames: a plain 1 px frame, no title bar and no window dots (docs v2) */
  .dev-mac > picture img, .dev-linux-pc > picture img, .dev-browser > picture img, .dev-terminal > picture img { border-radius: 0 !important; }
  /* "Play with sound": a pill over the capture */
  .fig-sound {
    position: absolute; z-index: 1; left: 50%; bottom: 12px; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 0 14px; border-radius: var(--r-pill);
    background: var(--color-overlay); color: var(--color-on-overlay) !important; font-size: var(--ft-sm); font-weight: var(--fw-medium);
    text-decoration: none !important; white-space: nowrap; backdrop-filter: blur(6px);
  }
  .fig-sound:hover { background: var(--color-overlay-strong); }
  .fig-sound:focus-visible { outline: 2px solid var(--color-on-overlay); outline-offset: 2px; }
  /* a figure on a page */
  .prose figure.fig { margin: var(--s-5) 0 var(--s-6); max-width: 280px; text-align: left; }
  .prose figure.fig figcaption { margin-top: var(--s-2); font-size: var(--ft-xs); line-height: var(--lh-snug); color: var(--color-text-tertiary); }
  .prose figure.fig .fig-cap { display: block; }
  .prose figure.fig .fig-more { margin: var(--s-1) 0 0; border: 0; padding: 0; }
  .prose figure.fig .fig-more > summary { display: inline; cursor: pointer; list-style: none; padding: 0; font-size: var(--ft-xs); font-weight: var(--fw-regular); color: var(--color-text-tertiary); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-border-strong); }
  .prose figure.fig .fig-more > summary::-webkit-details-marker { display: none; }
  .prose figure.fig .fig-more > summary::before, .prose figure.fig .fig-more > summary::after { content: none; }
  .prose figure.fig .fig-more > summary:hover { color: var(--color-text); }
  .prose figure.fig .fig-prov { display: block; margin: var(--s-1) 0 0; }
  .prose .lead > figure.fig { max-width: none; }
  @media (max-width: 760px) { .prose figure.fig { max-width: 240px; } .prose .lead > figure.fig { margin-inline: auto; } }
  @media (prefers-reduced-motion: reduce) { .fig-loop { display: none; } }
</style>
