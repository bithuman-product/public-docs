---
import Hub from "../../components/Hub.astro";
import { hubMeta } from "../../config/hubs";

const groups = [
  {
    label: "Start here",
    featured: true,
    cards: [
      { title: "Models", desc: "The four models — what each renders, where each runs, and which one to pick.", href: "/concepts/models" },
      { title: "Avatars and the .imx format", desc: "The single portable file that packages an avatar — where it comes from and how to inspect it.", href: "/concepts/avatars-imx" },
    ],
  },
  {
    label: "Model guides",
    cards: [
      { title: "Essence 2", desc: "The standard photorealistic model — served from bitHuman's cloud chain (GPU, Apple Silicon, CPU), from your own CPU servers, and opt-in in the viewer's browser. The default.", href: "/concepts/essence-2" },
      { title: "Expression 2", desc: "Stylized characters and creatures — fully generated motion from one portrait image.", href: "/concepts/expression-2" },
      { title: "Talking video", desc: "Render a finished MP4 from text or audio with any model — the asynchronous output mode.", href: "/concepts/talking-video" },
      { title: "Essence 1", desc: "The first-generation avatar model — two thirds of every agent on the platform, and the one that runs on virtually any CPU. Maintained.", href: "/concepts/essence-1" },
      { title: "Expression 1", desc: "The first-generation expressive model — facial animation generated from a portrait. GPU-only, and maintained.", href: "/concepts/expression-1" },
    ],
  },
  {
    label: "Core",
    cards: [
      { title: "Audio streaming", desc: "The push/drain pattern every SDK shares — PCM in, lip-synced frames out at the model's own rate (20 fps for Expression 2, 25 for Essence).", href: "/concepts/audio-streaming" },
      { title: "Agent lifecycle", desc: "From a face and voice to a live talking avatar — generate, poll, resolve, drive.", href: "/concepts/agent-lifecycle" },
    ],
  },
  {
    label: "Architecture",
    cards: [
      { title: "Architecture", desc: "The essence engine, the SDKs that wrap it, and the ABI + hardware matrices.", href: "/concepts/architecture" },
    ],
  },
];
---
<Hub
  title="Concepts"
  tagline={hubMeta("concepts").description}
  ctas={[{ label: "Models", href: "/concepts/models" }, { label: "Audio streaming", href: "/concepts/audio-streaming", variant: "secondary" }]}
  groups={groups}
/>
