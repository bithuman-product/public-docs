---
// /api/reference: every operation in src/openapi/bithuman.yaml, rendered at
// build time as one static page. No third-party script and nothing to run:
// each operation has an anchor (its operationId), its parameters, request
// body and responses, and curl, Python and Node samples generated from one
// request definition (src/lib/openapi.ts). The site search indexes it, and the
// same contract is served raw at /api/openapi.yaml for code generators.
import Base from "../../layouts/Base.astro";
import { Code } from "astro:components";
import ApiToc from "../../components/ApiToc.astro";
import { hubMeta } from "../../config/hubs";
import { apiSpec, mdHtml, type Operation } from "../../lib/openapi";

const title = "API reference";
const description = hubMeta("api/reference").description;
const api = apiSpec();
import { codeTheme } from "../../lib/code-theme.mjs";
const statusKind = (s: string) => (s.startsWith("2") ? "ok" : s.startsWith("3") ? "redirect" : s.startsWith("4") ? "client" : "server");
const lead = (op: Operation) => op.params.filter((p) => p.where !== "header" || !/^(api-secret|authorization)$/i.test(p.name));
const jsonLd = [{
  "@type": "TechArticle",
  "@id": "https://docs.bithuman.ai/api/reference#article",
  headline: "bitHuman REST API reference",
  description,
  url: "https://docs.bithuman.ai/api/reference",
}];
const GUIDES = [
  ["Organizations", "/api/organizations"], ["Providers", "/api/providers"], ["Runtime sessions", "/api/runtime-sessions"],
  ["API secrets", "/api/api-keys"], ["Knowledge", "/api/knowledge"],
];
---

<Base title={`${title} — bitHuman docs`} description={description} type="article" jsonLd={jsonLd} markdown="/api/reference.md">
  <div class="ar">
    <aside class="ar-side" data-pagefind-ignore>
      <p class="ar-side-h">Endpoints <span class="ar-count">{api.count}</span></p>
      <ApiToc tags={api.tags} label="Endpoints" />
    </aside>

    <div class="ar-main" data-pagefind-weight="0.5" data-pagefind-filter="section:API">
      <nav class="ar-crumb" aria-label="Breadcrumb" data-pagefind-ignore><a href="/">Docs</a> <span aria-hidden="true">/</span> <a href="/api">API</a> <span aria-hidden="true">/</span> <span>Reference</span></nav>
      <h1>API reference</h1>
      <p class="ar-lede">{description}</p>
      <ul class="ar-facts" role="list">
        <li><span>Base URL</span><code>https://api.bithuman.ai</code></li>
        <li><span>Authentication</span><span><code>api-secret: $BITHUMAN_API_SECRET</code> header · <a href="/api/authentication">Authentication</a></span></li>
        <li><span>OpenAPI 3.1</span><span><a href="/api/openapi.yaml" download>openapi.yaml</a> for Postman, Insomnia or a generated client</span></li>
      </ul>
      <details class="ar-toc-m" data-pagefind-ignore>
        <summary>Jump to an endpoint <span class="ar-count">{api.count}</span></summary>
        <ApiToc tags={api.tags} label="Endpoints menu" />
      </details>
      <p class="ar-note">Every sample runs as pasted after <code>export BITHUMAN_API_SECRET=…</code>; pick curl, Python or Node once and every sample follows. The account endpoints under <code>/v2</code> and knowledge have their own pages: {GUIDES.map(([t, h], i) => <Fragment>{i > 0 && " · "}<a href={h}>{t}</a></Fragment>)}.</p>

      {api.tags.map((t) => (
        <section class="ar-tag" aria-labelledby={`tag/${t.slug}`}>
          <h2 id={`tag/${t.slug}`}>{t.name}</h2>
          {t.description && <div class="ar-desc" set:html={mdHtml(t.description)} />}
          {t.operations.map((op) => (
            <section class="ar-op" aria-labelledby={op.id}>
              <h3 id={op.id}><span class={`ar-m ar-m-${op.method.toLowerCase()}`}>{op.method}</span> <code class="ar-path">{op.path}</code></h3>
              <p class="ar-sum">{op.summary}{op.keyless && <span class="chip ar-chip">No API secret needed</span>}{op.deprecated && <span class="chip ar-chip">Deprecated</span>}</p>
              <div class="ar-grid">
                <div class="ar-doc">
                  {op.description && <div class="ar-desc" set:html={mdHtml(op.description)} />}
                  {lead(op).length > 0 && (
                    <Fragment>
                      <p class="ar-h">Parameters</p>
                      <table class="ar-table">
                        <thead><tr><th scope="col">Name</th><th scope="col">In</th><th scope="col">Type</th><th scope="col">Description</th></tr></thead>
                        <tbody>{lead(op).map((p) => (
                          <tr><td><code>{p.where === "query" ? `${p.name}=` : p.name}</code>{p.required && <span class="ar-req">required</span>}</td><td>{p.where}</td><td>{p.type}</td><td set:html={mdHtml(p.description)} /></tr>
                        ))}</tbody>
                      </table>
                    </Fragment>
                  )}
                  {op.body.length > 0 && (
                    <Fragment>
                      <p class="ar-h">Request body <span class="ar-ct">{op.bodyType}</span></p>
                      <table class="ar-table">
                        <thead><tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Description</th></tr></thead>
                        <tbody>{op.body.map((f) => (
                          <tr><td><code>{f.name}</code>{f.required && <span class="ar-req">required</span>}</td><td>{f.type}</td><td set:html={mdHtml(f.description)} /></tr>
                        ))}</tbody>
                      </table>
                    </Fragment>
                  )}
                  <p class="ar-h">Responses</p>
                  <ul class="ar-resp" role="list">
                    {op.responses.map((r) => (
                      <li><span class={`ar-s ar-s-${statusKind(r.status)}`}>{r.status}</span><div set:html={mdHtml(r.description)} /></li>
                    ))}
                  </ul>
                </div>
                <div class="ar-code">
                  {op.samples.length > 1 ? (
                    <div class="md-tabs" data-md-tabs data-tabs data-group="lang">
                      <div class="mdt-bar" role="tablist" aria-label="Code examples">
                        {op.samples.map((s, k) => (
                          <button type="button" role="tab" class="mdt-tab" id={`${op.id}-t${k}`} aria-controls={`${op.id}-t${k}-p`} aria-selected={k === 0 ? "true" : "false"} tabindex={k === 0 ? 0 : -1} data-tab={s.label}>{s.label}</button>
                        ))}
                      </div>
                      {op.samples.map((s, k) => (
                        <div class:list={["mdt-panel", { active: k === 0 }]} role="tabpanel" id={`${op.id}-t${k}-p`} aria-labelledby={`${op.id}-t${k}`}>
                          <p class="mdt-label">{s.label}</p>
                          <Code code={s.code} lang={s.lang as any} theme={codeTheme as any} />
                        </div>
                      ))}
                    </div>
                  ) : op.samples.map((s) => <Code code={s.code} lang={s.lang as any} theme={codeTheme as any} />)}
                  {op.responses.filter((r) => r.example).slice(0, 1).map((r) => (
                    <div class="ar-example">
                      <p class="ar-h">Response <span class={`ar-s ar-s-${statusKind(r.status)}`}>{r.status}</span></p>
                      <Code code={r.example!} lang="json" theme={codeTheme as any} />
                    </div>
                  ))}
                </div>
              </div>
              <p class="ar-id">Operation ID <code>{op.id}</code> · <a href={`#${op.id}`}>Link</a></p>
            </section>
          ))}
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  import "../../scripts/tabs-sync";
</script>

<style is:global>
  .ar { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: var(--s-10); max-width: var(--container-wide, 1400px); margin: 0 auto; padding: 0 var(--s-6); }
  .ar-side { position: sticky; top: calc(var(--nav-h) + var(--s-4)); align-self: start; max-height: calc(100vh - var(--nav-h) - var(--s-8)); overflow-y: auto; padding: var(--s-6) 0 var(--s-8); font-size: var(--ft-sm); }
  .ar-side-h, .ar-toc-m > summary { display: flex; align-items: center; gap: var(--s-2); margin: 0 0 var(--s-3); font-size: var(--ft-xs); font-weight: var(--fw-regular);  color: var(--color-text-tertiary); }
  .ar-count { padding: 0 6px; border-radius: var(--r-pill); background: var(--color-surface-2); color: var(--color-text-secondary); }
  .ar-side .ar-toc-group + .ar-toc-group, .ar-toc-m .ar-toc-group + .ar-toc-group { margin-top: var(--s-4); }
  .ar .ar-toc-tag { display: block; margin-bottom: var(--s-1); font-weight: var(--fw-medium); color: var(--color-text); }
  .ar .ar-toc ul { list-style: none; margin: 0; padding: 0; }
  .ar .ar-toc li a { display: flex; align-items: baseline; gap: var(--s-2); padding: 3px 0; color: var(--color-text-secondary); line-height: var(--lh-snug); }
  .ar .ar-toc li a:hover { color: var(--color-text); }
  .ar .ar-toc .ar-m { flex: none; width: 2.6rem; font-size: var(--fs-12); }
  .ar-toc-m { display: none; margin-top: var(--s-4); padding: var(--s-3) var(--s-4); border: 1px solid var(--color-border); border-radius: var(--r-lg); font-size: var(--ft-sm); }
  .ar-toc-m > summary { margin: 0; cursor: pointer; list-style: none; }
  .ar-toc-m > summary::-webkit-details-marker { display: none; }
  .ar-toc-m[open] > summary { margin-bottom: var(--s-3); }

  .ar-main { min-width: 0; padding: var(--s-6) 0 var(--s-12); }
  .ar-crumb { font-size: var(--ft-sm); color: var(--color-text-tertiary); }
  .ar-crumb a { color: var(--color-text-tertiary); }
  .ar-main h1 { margin-top: var(--s-3); font-size: var(--fh-2xl); letter-spacing: -0.02em; }
  .ar-lede { margin-top: var(--s-3); max-width: 70ch; font-size: var(--ft-lg); color: var(--color-text-secondary); }
  .ar-facts { display: grid; gap: var(--s-2); margin: var(--s-5) 0 0; padding: var(--s-4) var(--s-5); list-style: none; border: 1px solid var(--color-border); border-radius: var(--r-lg); background: var(--color-surface-2); font-size: var(--ft-sm); }
  .ar-facts li { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--s-3); }
  .ar-facts li > span:first-child { color: var(--color-text-tertiary); }
  .ar-note { margin-top: var(--s-4); max-width: 80ch; font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .ar-main code { font-family: var(--font-mono); font-size: var(--fs-14); overflow-wrap: anywhere; }
  .ar-main a { color: var(--color-primary); font-weight: var(--fw-medium); }
  /* A link inside running text is underlined, not told apart by colour alone. */
  .ar-desc a, .ar-note a, .ar-table a, .ar-resp a, .ar-facts a { text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--color-primary) 45%, transparent); text-underline-offset: 2px; }

  .ar-tag { margin-top: var(--s-12); }
  .ar-tag > h2 { padding-top: var(--s-4); border-top: 1px solid var(--color-border); font-size: var(--fh-lg); scroll-margin-top: calc(var(--nav-h) + var(--s-4)); }
  .ar-desc { margin-top: var(--s-2); max-width: 75ch; font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .ar-desc p { margin: 0 0 var(--s-2); }
  .ar-desc ul { margin: 0 0 var(--s-2); padding-left: 1.2rem; }
  .ar-desc table { width: 100%; margin: var(--s-2) 0; border-collapse: collapse; font-size: var(--ft-xs); }
  .ar-desc th, .ar-desc td { padding: 4px 8px 4px 0; border-bottom: 1px solid var(--color-border); text-align: left; vertical-align: top; }
  .ar-desc pre { margin: var(--s-2) 0; padding: var(--s-3); overflow-x: auto; border-radius: var(--r-md); background: var(--color-code-bg); color: var(--color-code-text); font-size: var(--ft-xs); }

  .ar-op { margin-top: var(--s-10); }
  .ar-op > h3 { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); font-size: var(--ft-lg); scroll-margin-top: calc(var(--nav-h) + var(--s-4)); }
  .ar-path { font-size: var(--ft-md) !important; font-weight: var(--fw-medium); color: var(--color-text); }
  .ar-sum { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); margin-top: var(--s-1); font-weight: var(--fw-medium); color: var(--color-text); }
  .ar-chip { font-weight: var(--fw-regular); }
  .ar-m { display: inline-block; padding: 1px 7px; border-radius: var(--r-sm); font-family: var(--font-mono); font-size: var(--fs-12); font-weight: var(--fw-regular); letter-spacing: 0.02em; text-align: center; background: var(--color-surface-3); color: var(--color-text); }
  .ar-m-get { background: color-mix(in srgb, var(--green-500) 16%, transparent); }
  .ar-m-post { background: color-mix(in srgb, var(--blue-500) 16%, transparent); }
  .ar-m-put, .ar-m-patch { background: color-mix(in srgb, var(--amber-500) 20%, transparent); }
  .ar-m-delete { background: color-mix(in srgb, var(--red-500) 16%, transparent); }
  .ar-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-6); margin-top: var(--s-3); align-items: start; }
  .ar-doc, .ar-code { min-width: 0; }
  .ar-code { position: sticky; top: calc(var(--nav-h) + var(--s-4)); display: grid; gap: var(--s-3); }
  .ar-code pre { margin: 0; padding: var(--s-3) var(--s-4); border-radius: var(--r-lg); border: 1px solid var(--color-border); font-size: var(--ft-xs); max-height: 420px; overflow: auto; }
  .ar-code .md-tabs { margin: 0; }
  .ar-h { display: flex; align-items: center; gap: var(--s-2); margin: var(--s-4) 0 var(--s-2); font-size: var(--ft-xs); font-weight: var(--fw-regular);  color: var(--color-text-tertiary); }
  .ar-example .ar-h { margin-top: 0; }
  .ar-ct { text-transform: none; letter-spacing: 0; font-family: var(--font-mono); color: var(--color-text-secondary); }
  .ar-table { width: 100%; border-collapse: collapse; font-size: var(--ft-sm); }
  .ar-table th { padding: 0 var(--s-3) var(--s-1) 0; border-bottom: 1px solid var(--color-border-strong); text-align: left; font-size: var(--ft-xs); font-weight: var(--fw-regular); color: var(--color-text-tertiary); }
  .ar-table td { padding: var(--s-2) var(--s-3) var(--s-2) 0; border-bottom: 1px solid var(--color-border); vertical-align: top; color: var(--color-text-secondary); }
  .ar-table td:first-child { white-space: nowrap; color: var(--color-text); }
  .ar-table td p { margin: 0; }
  .ar-req { display: block; font-size: var(--ft-xs); color: var(--color-primary); }
  .ar-resp { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--s-2); font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .ar-resp li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--s-3); align-items: start; }
  .ar-resp li p { margin: 0; }
  .ar-s { display: inline-block; padding: 1px 6px; border-radius: var(--r-sm); font-family: var(--font-mono); font-size: var(--ft-xs); font-weight: var(--fw-regular); text-align: center; background: var(--color-surface-3); color: var(--color-text); }
  .ar-s-ok { background: color-mix(in srgb, var(--green-500) 16%, transparent); }
  .ar-s-client { background: color-mix(in srgb, var(--amber-500) 20%, transparent); }
  .ar-s-server { background: color-mix(in srgb, var(--red-500) 16%, transparent); }
  .ar-id { margin-top: var(--s-3); font-size: var(--ft-xs); color: var(--color-text-tertiary); }

  @media (max-width: 1279px) { .ar-grid { grid-template-columns: minmax(0, 1fr); } .ar-code { position: static; } }
  @media (max-width: 1023px) {
    .ar { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0 var(--s-4); }
    .ar-side { display: none; }
    .ar-toc-m { display: block; }
    .ar-facts li { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .ar-table, .ar-table tbody, .ar-table tr, .ar-table td { display: block; }
    .ar-table thead { display: none; }
    .ar-table tr { padding: var(--s-2) 0; border-bottom: 1px solid var(--color-border); }
    .ar-table td { padding: 2px 0; border: 0; }
  }
</style>
