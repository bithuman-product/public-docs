---
// /api/reference (docs v2 W5, SPEC §3, §5): the index of every operation in
// src/openapi/bithuman.yaml. Each operation is documented once, on its resource
// page (scripts/api-pages.json: the reviewed operation → page + H2 map), with
// curl, Python and Node; this page lists them by tag and links there. Each row
// keeps the operationId as its id and each tag keeps its old `tag/<slug>` id, so
// an old link (/api/reference#getAgent) still lands on the right row without
// JavaScript, and a one-line script sends the reader straight to the operation's
// page. No third-party script. The same contract is served raw at
// /api/openapi.yaml for code generators.
import Base from "../../layouts/Base.astro";
import { hubMeta } from "../../config/hubs";
import { SECTIONS } from "../../config/nav";
import { apiSpec } from "../../lib/openapi";
import { apiPages } from "../../lib/endpoint-block";

const title = "API reference";
const description = hubMeta("api/reference").description;
const api = apiSpec();
const pages = apiPages();
const href = (id: string) => {
  const r = pages[id];
  if (!r) throw new Error(`/api/reference: ${id} is not in scripts/api-pages.json`);
  return `${r.page}#${r.slug}`;
};
const jump = Object.fromEntries(api.tags.flatMap((t) => t.operations.map((op) => [op.id, href(op.id)])));
const jsonLd = [{
  "@type": "TechArticle",
  "@id": "https://docs.bithuman.ai/api/reference#article",
  headline: "bitHuman REST API reference",
  description,
  url: "https://docs.bithuman.ai/api/reference",
}];
const HAND = [
  ["Organizations", "/api/organizations"], ["Providers", "/api/providers"], ["API secrets", "/api/api-keys"],
  ["Rate limits", "/api/rate-limits"], ["Realtime", "/api/realtime"],
];
---

<Base title={`${title} — bitHuman docs`} description={description} type="article" jsonLd={jsonLd} markdown="/api/reference.md">
  <div class="container ari" data-pagefind-weight="0.5" data-pagefind-filter={`section:${SECTIONS.api.label}`}>
    <h1>API reference</h1>
    <p class="ari-lede">{description}</p>
    <ul class="ari-facts" role="list">
      <li><span>Base URL</span><code>https://api.bithuman.ai</code></li>
      <li><span>Authentication</span><span><code>api-secret: $BITHUMAN_API_SECRET</code> header · <a href="/api/authentication">Authentication</a></span></li>
      <li><span>OpenAPI 3.1</span><span><a href="/api/openapi.yaml" download>openapi.yaml</a> for Postman, Insomnia or a generated client</span></li>
    </ul>
    <p class="ari-note">{api.count} operations. Each one is documented on its resource page with curl, Python and Node samples. Endpoints outside the OpenAPI spec have their own pages: {HAND.map(([t, h], i) => <Fragment>{i > 0 && " · "}<a href={h}>{t}</a></Fragment>)}.</p>

    {api.tags.map((t) => (
      <section class="ari-tag" aria-labelledby={`tag/${t.slug}`}>
        <h2 id={`tag/${t.slug}`}>{t.name}</h2>
        <table class="ari-table">
          <thead><tr><th scope="col">Method</th><th scope="col">Path</th><th scope="col">Operation</th></tr></thead>
          <tbody>{t.operations.map((op) => (
            <tr id={op.id}>
              <td><span class={`ep-m ep-m-${op.method.toLowerCase()}`}>{op.method}</span></td>
              <td><code class="ari-path">{op.path}</code></td>
              <td><a href={href(op.id)}>{op.summary}</a>{op.deprecated && <span class="chip ari-chip">Deprecated</span>}</td>
            </tr>
          ))}</tbody>
        </table>
      </section>
    ))}
  </div>
  <script is:inline data-jump={JSON.stringify(jump)}>(()=>{var m=JSON.parse(document.currentScript.dataset.jump),g=()=>{var h=decodeURIComponent(location.hash.slice(1)),t=m[h.split("/").pop()];t&&location.replace(t)};g();addEventListener("hashchange",g)})()</script>
</Base>

<style>
  .ari { padding-block: var(--s-8) var(--s-12); max-width: 960px; }
  .ari h1 { font-size: var(--fh-2xl); letter-spacing: -0.02em; }
  .ari-lede { margin-top: var(--s-3); font-size: var(--ft-lg); color: var(--color-text-secondary); max-width: 62ch; }
  .ari-facts { list-style: none; margin: var(--s-6) 0 0; padding: 0; display: grid; gap: var(--s-2); font-size: var(--ft-sm); }
  .ari-facts li { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: var(--s-3); }
  .ari-facts li > span:first-child { color: var(--color-text-tertiary); }
  .ari-note { margin-top: var(--s-4); font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .ari-tag { margin-top: var(--s-10); }
  .ari-tag h2 { font-size: var(--fh-md, 1.25rem); scroll-margin-top: var(--nav-h); }
  .ari-table { width: 100%; margin-top: var(--s-3); border-collapse: collapse; font-size: var(--ft-sm); }
  .ari-table th { text-align: left; font-weight: var(--fw-medium); color: var(--color-text-tertiary); padding: var(--s-2) var(--s-3) var(--s-2) 0; border-bottom: 1px solid var(--color-border); }
  .ari-table td { padding: var(--s-2) var(--s-3) var(--s-2) 0; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .ari-table tr { scroll-margin-top: calc(var(--nav-h) + var(--s-4)); }
  .ari-table tr:target { background: color-mix(in srgb, var(--color-primary) 8%, transparent); }
  .ari-table th:first-child, .ari-table td:first-child { width: 5.5em; }
  .ari-path { font-size: var(--ft-xs); overflow-wrap: anywhere; background: none; border: 0; padding: 0; }
  .ari-chip { margin-left: var(--s-2); }
  @media (max-width: 560px) {
    .ari h1 { font-size: var(--fh-xl); }
    .ari-facts li { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .ari-table thead { display: none; }
    .ari-table tr { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--s-3); padding: var(--s-2) 0; border-bottom: 1px solid var(--color-border); }
    .ari-table td { border: 0; padding: 0; width: auto !important; }
    .ari-table td:last-child { grid-column: 1 / -1; margin-top: var(--s-1); }
  }
</style>
