---
// /api/reference — the OpenAPI spec rendered by Scalar, inside the site's own
// layout: the same <head> as every content page (canonical, description, Open
// Graph, structured data), the site nav and footer, the site theme, and a
// <noscript> route to the spec and the endpoint pages for anything that does
// not run JavaScript. It used to be a standalone document with its own head,
// no canonical, no links and a forced light theme.
//
// Scalar is pinned. Its palette follows the site: the light overrides below
// apply under `.light-mode` (Scalar puts that class on <body>) and dark mode
// is Scalar's own dark theme with the coral accent — the site's theme toggle
// drives both, so Scalar's toggle is hidden.
import Base from "../../layouts/Base.astro";
import { hubMeta } from "../../config/hubs";
import { getCollection } from "astro:content";

const SCALAR_VERSION = "1.69.2";
const title = "REST API reference — bitHuman docs";
const description = hubMeta("api/reference").description;

// The endpoint pages, for the no-JavaScript path.
const apiPages = (await getCollection("docs", (e: any) => !e.data.draft && e.data.section === "api"))
  .sort((a: any, b: any) => (a.data.order ?? 100) - (b.data.order ?? 100))
  .map((e: any) => ({ href: `/${e.id}`, label: e.data.label ?? e.data.title }));

const configuration = {
  url: "/api/openapi.yaml",
  theme: "default",
  layout: "modern",
  hideDarkModeToggle: true,
  showSidebar: true,
  searchHotKey: "k",
  hideClientButton: false,
  defaultHttpClient: { targetKey: "shell", clientKey: "curl" },
  hiddenClients: [],
  // Auto-expand all operations so the docs read like a single page,
  // not a tree of click-to-expand panels.
  defaultOpenAllTags: true,
  favicon: "/bithuman-mark.png",
};
---

<Base title={title} description={description} type="article">
  <div class="apiref">
    <noscript>
      <div class="container apiref-noscript">
        <h1>REST API reference</h1>
        <p>
          This console renders the OpenAPI spec in your browser and needs JavaScript.
          The same contract is served raw at <a href="/api/openapi.yaml">/api/openapi.yaml</a>,
          and every endpoint group has its own page:
        </p>
        <ul>
          {apiPages.map((p) => (
            <li><a href={p.href}>{p.label}</a></li>
          ))}
        </ul>
      </div>
    </noscript>
    {/* Not id="api-reference": the bundle auto-mounts an empty, second
        instance on that id, and the page would carry two. */}
    <div id="bh-api-reference"></div>
  </div>

  <script is:inline src={`https://cdn.jsdelivr.net/npm/@scalar/api-reference@${SCALAR_VERSION}`}></script>
  <script is:inline define:vars={{ configuration }}>
    (function () {
      var html = document.documentElement;
      var mode = function () { return html.getAttribute("data-theme") === "dark" ? "dark" : "light"; };
      // Scalar keys its palette on a body class; the site keys its own on
      // <html data-theme>. Start Scalar in the site's mode and follow the
      // site toggle from then on.
      window.Scalar.createApiReference("#bh-api-reference", Object.assign({}, configuration, {
        forceDarkModeState: mode(),
      }));
      new MutationObserver(function () {
        var m = mode();
        document.body.classList.toggle("dark-mode", m === "dark");
        document.body.classList.toggle("light-mode", m === "light");
      }).observe(html, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>
</Base>

<style is:global>
  /* ==========================================================================
     bitHuman Scalar theme. Scalar's own variables + class names (verified
     against the @scalar/api-reference bundle on jsdelivr). Everything with a
     colour in it sits under `.light-mode`, the class Scalar puts on <body>;
     dark mode is Scalar's dark theme plus the coral accent and the same
     layout rules.
     ========================================================================== */
  .apiref { min-height: 60vh; }
  .apiref-noscript { padding-block: var(--space-8); max-width: 60ch; }
  .apiref-noscript h1 { font-size: var(--fh-2xl); }
  .apiref-noscript p { margin-top: var(--space-4); color: var(--color-text-secondary); }
  .apiref-noscript ul { margin-top: var(--space-4); columns: 2; }
  .apiref-noscript a { color: var(--color-primary); }

  :root {
    /* === Brand === */
    --bh-coral:        #FF5757;
    --bh-coral-hover:  #FF7474;
    --bh-coral-soft:   #FFEDED;
    --bh-coral-deep:   #E04545;
    --bh-link:         var(--bh-coral-deep);

    /* === Typography: the site's own fonts === */
    --scalar-font: "Roboto", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    --scalar-font-code: "Roboto Mono", ui-monospace, monospace;

    --scalar-color-accent: var(--bh-coral);

    /* === Header: Scalar's own header row is empty here (0), and the
       site nav above it is sticky, so the sidebar and the sticky code
       cards offset by the nav's height === */
    --scalar-header-height: 0px;
    --scalar-custom-header-height: var(--nav-h);
    --scalar-header-call-to-action-color: var(--bh-coral);

    /* === Sidebar geometry === */
    --scalar-sidebar-width: 280px;
    --scalar-sidebar-padding: 12px;
    --scalar-sidebar-indent: 16px;
    --scalar-sidebar-indent-border-active: var(--bh-coral);
    --scalar-sidebar-indent-border-hover: var(--bh-coral-hover);
    --scalar-sidebar-font-weight: 400;
    --scalar-sidebar-font-weight-active: 600;

    /* === Buttons === */
    --scalar-button-1: var(--bh-coral);
    --scalar-button-1-color: #ffffff;
    --scalar-button-1-hover: var(--bh-coral-hover);

    /* === HTTP method badges === */
    --scalar-color-green: #16a34a;
    --scalar-color-blue: #2563eb;
    --scalar-color-orange: #ea580c;
    --scalar-color-red: var(--bh-coral);

    /* === Wider content === */
    --scalar-content-max-width: 1400px;
  }

  body.light-mode {
    --scalar-color-1: #0d0d0d;
    --scalar-color-2: #404040;
    --scalar-color-3: #6b7280;

    --scalar-background-1: #ffffff;
    --scalar-background-2: #fafafa;
    --scalar-background-3: #f7f7f8;
    --scalar-background-accent: var(--bh-coral-soft);
    --scalar-border-color: #e5e7eb;

    --scalar-header-background-1: #ffffff;
    --scalar-header-background-2: #ffffff;
    --scalar-header-color-1: #0d0d0d;
    --scalar-header-color-2: #6b7280;
    --scalar-header-border-color: #e5e7eb;

    --scalar-sidebar-indent-border: var(--scalar-border-color);
    --scalar-sidebar-background-1: #fafafa;
    --scalar-sidebar-border-color: #e5e7eb;
    --scalar-sidebar-color-1: #0d0d0d;
    --scalar-sidebar-color-2: #525252;
    --scalar-sidebar-color-active: var(--bh-coral-deep);
    --scalar-sidebar-item-active-background: var(--bh-coral-soft);
    --scalar-sidebar-item-hover-background: #f0f0f3;
    --scalar-sidebar-item-hover-color: var(--bh-coral-deep);
    --scalar-sidebar-search-background: #ffffff;
    --scalar-sidebar-search-border-color: #e5e7eb;
    --scalar-sidebar-search-color: #0d0d0d;
  }

  body.dark-mode {
    --bh-link: var(--bh-coral);
    --bh-coral-soft: rgba(255, 87, 87, 0.16);
    --scalar-background-accent: rgba(255, 87, 87, 0.16);
    --scalar-sidebar-item-active-background: rgba(255, 87, 87, 0.16);
    --scalar-sidebar-color-active: var(--bh-coral);
    --scalar-sidebar-item-hover-color: var(--bh-coral);
  }

  /* ============================================================
     LAYOUT — dominant middle column, no API-client squish.
     On prose-only sections Scalar puts "Server / Authentication /
     Client Libraries" panels in the right rail; those are hidden so the
     prose column takes the width. Endpoint pages stack the code samples
     under the spec at full width.
     ============================================================ */
  .references-rendered .introduction-card,
  .references-rendered .sticky-cards {
    display: none !important;
  }
  .references-rendered .section-column.section-column:nth-of-type(2):empty,
  .references-rendered .section-column.section-column:nth-of-type(2):has(.introduction-card),
  .references-rendered .section-column.section-column:nth-of-type(2):has(.sticky-cards) {
    display: none !important;
  }
  .references-rendered .section-columns.section-columns {
    flex-direction: column !important;
    gap: 24px !important;
  }
  .references-rendered .section-column.section-column {
    flex: 1 1 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
  }
  .references-rendered .section-column.section-column:nth-of-type(2) .sticky-cards,
  .references-rendered .section-column.section-column:nth-of-type(2) .examples,
  .references-rendered .section-column.section-column:nth-of-type(2) .operation-example-card {
    max-width: 100% !important;
    width: 100% !important;
    position: static !important;
  }

  /* Scalar's marketing top bar (Developer Tools / Configure / Share) */
  .references-classic-header,
  .references-classic-header-container,
  .references-classic-header-content,
  .references-developer-tools {
    display: none !important;
  }

  /* ============================================================
     TYPOGRAPHY — sizes only; colours come from Scalar's palette
     ============================================================ */
  .references-rendered h1,
  .references-rendered h2,
  .references-rendered h3,
  .references-rendered h4 {
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }
  .references-rendered h1 {
    font-size: 2.25rem !important;
    margin-top: 0;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }
  .references-rendered h2 {
    font-size: 1.5rem !important;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--scalar-border-color);
  }
  .references-rendered h3 {
    font-size: 1.15rem !important;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .references-rendered p,
  .references-rendered li {
    font-size: 0.975rem;
    line-height: 1.7;
  }
  .references-rendered p { margin: 0.75rem 0; }
  .references-rendered li { margin: 0.3rem 0; }

  .references-rendered a {
    color: var(--bh-link) !important;
    text-decoration: underline;
    text-decoration-color: var(--bh-coral-soft) !important;
    text-underline-offset: 2.5px;
    text-decoration-thickness: 1.5px;
    transition: color 120ms ease, text-decoration-color 120ms ease;
  }
  .references-rendered a:hover {
    color: var(--bh-coral) !important;
    text-decoration-color: var(--bh-coral) !important;
  }

  /* Tag heading — coral underline */
  .references-rendered h1::after {
    content: "";
    display: block;
    width: 32px;
    height: 3px;
    background: var(--bh-coral);
    margin-top: 0.75rem;
    border-radius: 2px;
  }

  /* ============================================================
     CODE — the site's mono font, and a long curl line wraps
     instead of clipping at the card edge
     ============================================================ */
  .references-rendered pre,
  .references-rendered code {
    font-family: var(--scalar-font-code) !important;
  }
  .references-rendered pre {
    border-radius: 8px;
    padding: 1rem 1.25rem !important;
    margin: 1.25rem 0 !important;
    font-size: 13.5px !important;
    line-height: 1.6 !important;
  }
  .references-rendered pre,
  .references-rendered pre code,
  .references-rendered pre code span {
    white-space: pre-wrap !important;
    overflow-wrap: anywhere !important;
  }
  .references-rendered code:not(pre code) {
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.88em;
    font-weight: 500;
    border: none;
  }

  /* ============================================================
     TABLES and BLOCKQUOTES
     ============================================================ */
  .references-rendered table {
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1.25rem 0;
    width: 100%;
    border: 1px solid var(--scalar-border-color);
    border-radius: 8px;
    overflow: hidden;
  }
  .references-rendered th,
  .references-rendered td {
    padding: 0.6rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--scalar-border-color);
  }
  .references-rendered th {
    background: var(--scalar-background-2);
    font-weight: 600;
    font-size: 0.84rem;
  }
  .references-rendered tr:last-child td { border-bottom: none; }

  .references-rendered blockquote {
    margin: 1.25rem 0;
    padding: 0.8rem 1.1rem;
    background: var(--bh-coral-soft);
    border-left: 3px solid var(--bh-coral);
    border-radius: 0 8px 8px 0;
    font-size: 0.95rem;
  }
  .references-rendered blockquote p { margin: 0; }

  /* ============================================================
     SIDEBAR — group headings small and grey, items regular weight
     ============================================================ */
  .t-doc__sidebar .text-sidebar-c-2.font-bold {
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: var(--scalar-color-3) !important;
    margin-top: 1.5rem !important;
    margin-bottom: 0.4rem !important;
  }
  .t-doc__sidebar .text-sidebar-c-2.font-bold svg { display: none; }
  .t-doc__sidebar button {
    font-size: 13.5px !important;
    line-height: 1.4 !important;
    padding-top: 0.35rem !important;
    padding-bottom: 0.35rem !important;
  }
  .t-doc__sidebar button.bg-sidebar-b-active,
  .t-doc__sidebar .bg-sidebar-b-active,
  .t-doc__sidebar [aria-current="true"],
  .t-doc__sidebar [aria-current="page"] {
    background: var(--scalar-sidebar-item-active-background) !important;
    color: var(--scalar-sidebar-color-active) !important;
    font-weight: 600 !important;
    border-radius: 6px;
  }
  .t-doc__sidebar .text-sidebar-c-active { color: var(--scalar-sidebar-color-active) !important; }
  .t-doc__sidebar .bg-sidebar-indent-border-active { background-color: var(--bh-coral) !important; }
  .t-doc__sidebar button:hover {
    background: var(--scalar-sidebar-item-hover-background) !important;
    color: var(--scalar-sidebar-color-1) !important;
  }

  /* "Get a free API secret →" as a pill button */
  .references-rendered p > a[href*="bithuman.ai/developer/api-keys"] {
    display: inline-block;
    background: var(--bh-coral);
    color: #ffffff !important;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: 0.4rem;
    transition: background 120ms ease;
  }
  .references-rendered p > a[href*="bithuman.ai/developer/api-keys"]:hover {
    background: var(--bh-coral-hover);
    color: #ffffff !important;
  }

  .references-footer { opacity: 0.4; font-size: 11px; }

  /* ============================================================
     LIGHT MODE ONLY — Scalar's API client is a dark "terminal"
     panel by design; in the light theme it is lightened to match
     the page. Dark mode keeps Scalar's own.
     ============================================================ */
  body.light-mode .references-rendered .examples,
  body.light-mode .references-rendered .examples .scalar-card,
  body.light-mode .references-rendered .examples .scalar-card-content,
  body.light-mode .references-rendered .examples .scalar-code-block,
  body.light-mode .references-rendered .examples .scalar-card-header,
  body.light-mode .references-rendered .examples .scalar-card-footer {
    --scalar-background-1: #ffffff;
    --scalar-background-2: #fafafa;
    --scalar-background-3: #f7f7f8;
    --scalar-color-1: #0d0d0d;
    --scalar-color-2: #404040;
    --scalar-color-3: #6b7280;
    --scalar-border-color: #e5e7eb;
    background-color: #f7f7f8 !important;
    color: #0d0d0d !important;
    border-color: #e5e7eb !important;
  }
  body.light-mode .references-rendered .examples .scalar-card-content,
  body.light-mode .references-rendered .examples [class*="custom-scroll"] {
    background-color: #ffffff !important;
  }
  body.light-mode .references-rendered .examples .scalar-code-block > [class*="bg-b-3"],
  body.light-mode .references-rendered .examples .scalar-code-block > div:first-child {
    background-color: #fafafa !important;
    border-bottom: 1px solid #e5e7eb !important;
    color: #0d0d0d !important;
  }
  body.light-mode .references-rendered .examples .scalar-code-block .line-number,
  body.light-mode .references-rendered .examples [class*="line-number"] {
    color: #9ca3af !important;
  }
  body.light-mode .references-rendered .examples .scalar-code-block pre,
  body.light-mode .references-rendered .examples .scalar-code-block code,
  body.light-mode .references-rendered .examples .scalar-code-block .line {
    color: #1f2328 !important;
    background-color: transparent !important;
  }
  body.light-mode .references-rendered .examples button {
    background-color: #ffffff !important;
    color: #0d0d0d !important;
    border-color: #e5e7eb !important;
  }
  body.light-mode .references-rendered .examples button:hover { background-color: #fafafa !important; }
  body.light-mode .references-rendered .examples button[class*="primary"],
  body.light-mode .references-rendered .examples .send-request-button {
    background-color: var(--bh-coral) !important;
    color: #ffffff !important;
    border-color: transparent !important;
  }
  body.light-mode .references-rendered .examples button[class*="primary"]:hover,
  body.light-mode .references-rendered .examples .send-request-button:hover {
    background-color: var(--bh-coral-hover) !important;
  }
  body.light-mode .references-rendered .examples [class*="dropdown"],
  body.light-mode .references-rendered .examples [aria-haspopup="menu"] {
    color: #0d0d0d !important;
  }
  body.light-mode .references-rendered .examples [class*="method"] { background-color: transparent !important; }

  body.light-mode .references-rendered pre {
    background: #f7f7f8 !important;
    border: 1px solid #e5e7eb !important;
    color: #0d0d0d !important;
  }
  body.light-mode .references-rendered code:not(pre code) {
    background: #f3f3f5 !important;
    color: #0d0d0d !important;
  }
  /* highlight.js, GitHub-light */
  body.light-mode .hljs, body.light-mode .hljs-built_in, body.light-mode .hljs-symbol {
    color: #1f2328 !important;
    background: transparent !important;
  }
  body.light-mode .hljs-keyword, body.light-mode .hljs-selector-tag, body.light-mode .hljs-literal, body.light-mode .hljs-section, body.light-mode .hljs-link { color: #cf222e !important; }
  body.light-mode .hljs-string, body.light-mode .hljs-attr { color: #0a3069 !important; }
  body.light-mode .hljs-number, body.light-mode .hljs-meta { color: #0550ae !important; }
  body.light-mode .hljs-comment, body.light-mode .hljs-quote { color: #6e7781 !important; font-style: italic; }
  body.light-mode .hljs-title, body.light-mode .hljs-name, body.light-mode .hljs-type { color: #8250df !important; }
  body.light-mode .hljs-variable, body.light-mode .hljs-template-variable { color: #953800 !important; }
  body.light-mode .hljs-tag { color: #116329 !important; }
</style>
