---
import Hub from "../../components/Hub.astro";
import { hubMeta } from "../../config/hubs";

const groups = [
  {
    label: "Start here",
    featured: true,
    cards: [
      { title: "Quickstart", desc: "Make your first API call and drive a live agent in minutes.", href: "/api/quickstart" },
      { title: "Authentication", desc: "API secrets, runtime tokens, and key setup.", href: "/api/authentication" },
      { title: "Overview", desc: "REST API for generating avatars, synthesizing voice, driving live sessions, and embedding agents — from any language.", href: "/api/overview" },
    ],
  },
  {
    label: "Build",
    cards: [
      { title: "Agents", desc: "Generate, resolve, update, and drive agents — speak & add context.", href: "/api/agents" },
      { title: "Text to speech", desc: "31-language TTS, OpenAI-compatible voice endpoints.", href: "/api/text-to-speech" },
      { title: "Gestures & animations", desc: "Trigger waves, nods, and idle motion via the Dynamics API.", href: "/api/dynamics" },
      { title: "File upload", desc: "Upload portraits and assets for agent generation.", href: "/api/files" },
      { title: "Knowledge bases", desc: "Ingest documents and URLs, build knowledge bases, and rebuild them — programmatically.", href: "/api/knowledge" },
      { title: "Realtime voice", desc: "Mint a short-lived client secret to open an OpenAI-Realtime voice session from the browser.", href: "/api/realtime" },
      { title: "Bring your own keys", desc: "Store your own LLM, STT, and TTS provider keys and have your agents use them.", href: "/api/providers" },
    ],
  },
  {
    label: "Account & teams",
    cards: [
      { title: "API secrets", desc: "Create, list, reveal, and delete your account's API secrets programmatically.", href: "/api/api-keys" },
      { title: "Runtime sessions", desc: "List live avatar sessions, read a transcript, terminate a session, or revoke every runtime key at once.", href: "/api/runtime-sessions" },
      { title: "Teams & orgs", desc: "Create a team, invite members, manage roles and org-scoped API secrets, and track per-member usage.", href: "/api/organizations" },
    ],
  },
  {
    label: "Deliver",
    cards: [
      { title: "Talking video", desc: "Render a finished MP4 from text or audio — submit and poll.", href: "/api/video" },
      { title: "Embed widget", desc: "Mint a token and drop a live agent into any page.", href: "/api/embedding" },
    ],
  },
  {
    label: "Operate & reference",
    cards: [
      { title: "API reference", desc: "Full, interactive endpoint reference with try-it-out.", href: "/api/reference", badge: "Interactive" },
      { title: "Billing", desc: "Credit summaries and the realtime usage model.", href: "/api/billing" },
      { title: "Webhooks", desc: "Subscribe to agent and render lifecycle events.", href: "/api/webhooks" },
      { title: "Rate limits", desc: "Quotas and limits per endpoint.", href: "/api/rate-limits" },
      { title: "Errors", desc: "Every error code the API returns — and how to recover from each.", href: "/api/errors" },
    ],
  },
];
---
<Hub
  eyebrow="Cloud API"
  title="API Platform"
  tagline={hubMeta("api").description}
  ctas={[{ label: "New here? Start here", href: "/start" }, { label: "API reference", href: "/api/reference", variant: "secondary" }]}
  groups={groups}
/>
