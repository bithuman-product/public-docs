---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";

// Without this page a mistyped or stale URL answered with the host's own plain
// text — "The page could not be found / NOT_FOUND / iad1::…" — no navigation,
// no search, no way back. This site moves URLs often enough to carry
// hundreds of redirects, so landing on one that was missed is a normal thing to happen to a
// reader, and it should leave them inside the docs.

const places = [
  { title: "Quickstart", desc: "Talk to a live avatar, then run your own.", href: "/start" },
  { title: "Platforms", desc: "iOS & iPadOS, Android, Web, Python, the CLI, LiveKit and REST.", href: "/platforms" },
  { title: "Deployment options", desc: "The bitHuman cloud, your servers, on the device, no GPU, fully offline.", href: "/deploy" },
  { title: "Models", desc: "Essence 2 and Expression 2, and where each renders.", href: "/models" },
  { title: "Build", desc: "Recipes, your own avatar and the example gallery.", href: "/build" },
  { title: "API", desc: "Create, drive and embed agents over REST.", href: "/api" },
];
---

<Base
  title="Page not found — bitHuman docs"
  description="That page is not here. Search the docs, or start from the quickstart, the platforms or the API."
>
  <section class="nf">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p class="lede">
        It may have moved, or the link may be old. Search the docs — or pick up
        from one of these.
      </p>
      <p class="acts">
        <button class="find" type="button" onclick="window.__bhOpenSearch && window.__bhOpenSearch()">
          Search the docs
        </button>
        <a class="home" href="/">Docs home</a>
      </p>

      <ul class="card-grid cols-3 grid" role="list">
        {places.map((p) => <li><Card href={p.href} title={p.title} line={p.desc} h={2} /></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: var(--space-10) var(--space-12); }
  .nf h1 { font-size: var(--fh-2xl); margin-top: var(--space-2); max-width: 18ch; }
  .lede { margin-top: var(--space-3); max-width: 44ch; font-size: var(--ft-lg); color: var(--color-text-secondary); }
  .acts { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .find {
    padding: 0.6rem 1.1rem;
    border: 0;
    border-radius: var(--r-full);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
  }
  .find:hover { background: var(--color-primary-hover); }
  .home {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--r-full);
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
  }
  .home:hover { color: var(--color-text); border-color: var(--color-border-strong); }

  .grid { margin-top: var(--space-8); }
</style>
