---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import MovedAnchors from "../../components/MovedAnchors.astro";
import PlatformsBanner from "../../components/PlatformsBanner.astro";
import { hubMeta } from "../../config/hubs";
import { PLATFORM_PAGES } from "../../data/platforms";
import { RENDERS_LABEL } from "../../data/labels";
import HUB_MOVED from "../../data/hub-moved.json";
import { PLATFORM_GROUPS, PLATFORM_REFERENCE } from "../../data/platforms-hub";

// The Platforms hub (docs v2 SPEC §3, hub budget): the banner, a card per
// platform page grouped the way the sidebar is, and one support matrix. Cards
// carry a title and one line, no chips; where each renders, the time to a first
// result and the reference come from src/data/platforms.ts in the matrix.
// Versions live on /downloads.
const meta = hubMeta("platforms");
const GROUPS = PLATFORM_GROUPS;
const REFERENCE = PLATFORM_REFERENCE;
const gid = (name: string) => `g-${name.replace(/\W+/g, "-").toLowerCase()}`;
---

<Base title="Platforms — bitHuman docs" description={meta.description}>
  <div class="container hub" data-pagefind-filter="section:Platforms">
    <h1>Platforms</h1>
    <p class="lede" data-subtitle>{meta.description}</p>
    <div class="banner"><PlatformsBanner /></div>

    {GROUPS.map((g) => (
      <section class="hub-group" aria-labelledby={gid(g.name)}>
        <div class="band-head">
          <h2 id={gid(g.name)}>{g.name}</h2>
          <p>{g.line}</p>
        </div>
        <ul class="card-grid cols-3" role="list">
          {PLATFORM_PAGES.filter((p) => p.group === g.name).map((p) => (
            <li><Card variant="platform" href={p.href} title={p.title} line={p.line} icon={p.icon} /></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="hub-group" aria-labelledby="support-matrix">
      <div class="band-head"><h2 id="support-matrix">Support matrix</h2></div>
      <div class="prose matrix">
        <div class="table-wrap"><table>
          <thead><tr><th>Platform</th><th>Where it renders</th><th>First result</th><th>Reference</th></tr></thead>
          <tbody>
            {PLATFORM_PAGES.map((p) => (
              <tr>
                <td data-label="Platform"><a href={p.href}>{p.title}</a></td>
                <td data-label="Where it renders">{p.renders.map((r) => RENDERS_LABEL[r]).join(" · ")}</td>
                <td data-label="First result">{p.time ?? "—"}</td>
                <td data-label="Reference">{REFERENCE[p.id] ? <a href={REFERENCE[p.id].href}>{REFERENCE[p.id].title}</a> : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
      </div>
    </section>
    <MovedAnchors moved={HUB_MOVED["/platforms"]} quiet />
  </div>
</Base>

<style>
  /* W8 (owner, 2026-09-30: "proper margins, larger cards", the banner "placed
     naturally"): one centred column like the landing; the banner is a rounded
     panel under the title, the card grid a step larger. */
  .hub { max-width: 1120px; padding-block: var(--s-10) var(--s-16); }
  .hub h1 { font-size: var(--fs-h1); line-height: var(--lh-h1); }
  .lede { margin-top: var(--s-3); font-size: var(--fs-18); line-height: var(--lh-18); color: var(--color-text-secondary); max-width: 62ch; }
  .banner { margin-top: var(--s-8); }
  .hub-group { margin-top: var(--s-12); }
  .hub-group .band-head { margin-bottom: var(--s-5); }
  .hub-group :global(.card-grid) { gap: var(--s-5); }
  .hub-group :global(.card-platform) { padding: var(--s-6); gap: var(--s-3); min-height: 168px; }
  .hub-group :global(.card-platform .card-icon) { width: 28px; height: 28px; color: var(--color-text); }
  .hub-group :global(.card-platform .card-icon svg) { width: 24px; height: 24px; }
  .hub-group :global(.card-platform .card-title h3) { font-size: var(--ft-lg); }
  .matrix { max-width: none; }
  .matrix :global(.table-wrap) { margin: 0; }
  @media (max-width: 560px) {
    .hub { padding-block: var(--s-6) var(--s-12); }
    .banner { margin-top: var(--s-6); }
    .hub-group :global(.card-platform) { padding: var(--s-4); min-height: 0; }
  }
</style>
