---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import LiveDemo from "../components/LiveDemo.astro";
import PathTable from "../components/PathTable.astro";
import PerfHeadline from "../components/PerfHeadline.astro";
import { hubMeta } from "../config/hubs";

const meta = hubMeta("");
---

<Base title="bitHuman docs" description={meta.description}>
  <section class="home-hero">
    <div class="container hero-grid">
      <div>
        <h1>Realtime talking avatars from one portrait</h1>
        <p class="lede"><strong>Essence 2</strong> renders a photoreal person, up to 1080p at 25 fps (1080×1920 portrait for a standard identity). <strong>Expression 2</strong> renders any character at 416×720, 20 fps. Run them from the cloud API, a web page, a terminal, Python, Apple and Android apps, or a LiveKit agent.</p>
        <div class="hero-cta">
          <Button href="/start">Get started</Button>
          <Button href="https://www.bithuman.ai/developer/api-keys" variant="secondary" external>Get an API secret</Button>
        </div>
      </div>
      <LiveDemo />
    </div>
  </section>

  <section class="home-block">
    <div class="container">
      <h2 id="choose-your-path">Choose your path</h2>
      <p class="muted">Every way to run bitHuman, with the first command for each. The same avatars work everywhere.</p>
      <PathTable />
    </div>
  </section>

  <section class="home-block alt">
    <div class="container">
      <h2 id="performance">How fast it runs</h2>
      <p class="muted">Frames per second, measured end to end on current releases.</p>
      <PerfHeadline />
    </div>
  </section>

  <section class="home-block">
    <div class="container three">
      <a class="mini" href="/concepts/models"><h3>Which model?</h3><p>Essence 2 for photoreal people, Expression 2 for any character.</p></a>
      <a class="mini" href="/guides/pricing"><h3>Pricing</h3><p>Credits pay for session time, talking or idle, by the exact second.</p></a>
      <a class="mini" href="/examples"><h3>Examples</h3><p>Complete apps for iOS, Android, macOS, the web, Python and the CLI.</p></a>
    </div>
  </section>
</Base>

<style>
  .home-hero { padding-block: var(--space-10) var(--space-8); border-bottom: 1px solid var(--color-border); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: var(--space-8); align-items: center; }
  .home-hero h1 { font-size: var(--fh-3xl); line-height: 1.1; letter-spacing: -0.02em; }
  .home-hero .lede { margin-top: var(--space-4); font-size: var(--ft-lg); color: var(--color-text-secondary); max-width: 58ch; }
  .hero-cta { display: flex; gap: var(--space-3); margin-top: var(--space-6); flex-wrap: wrap; }
  .home-block { padding-block: var(--space-8); }
  .home-block.alt { background: var(--color-surface-2); border-block: 1px solid var(--color-border); }
  .home-block h2 { font-size: var(--fh-lg); margin-bottom: var(--space-2); }
  .home-block .muted { margin-bottom: var(--space-4); }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .mini { display: block; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--r-xl); background: var(--color-surface); color: inherit; }
  .mini:hover { border-color: var(--color-primary); }
  .mini h3 { font-size: var(--ft-lg); }
  .mini p { margin-top: var(--space-2); color: var(--color-text-secondary); font-size: var(--ft-sm); }
  @media (max-width: 900px) {
    .hero-grid, .three { grid-template-columns: 1fr; }
    .home-hero h1 { font-size: var(--fh-2xl); }
  }
</style>
