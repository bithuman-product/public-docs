---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import LiveDemo from "../components/LiveDemo.astro";
import PerfHeadline from "../components/PerfHeadline.astro";
import { hubMeta } from "../config/hubs";
import { START_BUILDING, DEPLOYMENTS, MODELS, MODELS_NOTE, GUIDES, RESOURCES } from "../data/home";

// The front door: what bitHuman is and where to click, as cards. Each card is
// one link and one line; the detail lives on the page it opens. The platform
// table with first commands is on /start, the full performance record on
// /performance, and the model comparison on /concepts/models.
const meta = hubMeta("");
---

<Base title="bitHuman docs — realtime AI avatars on-device, self-hosted or offline" description={meta.description}>
  <section class="hero" aria-labelledby="home-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="home-title">Realtime talking avatars from one portrait</h1>
        <p class="lede">Essence 2 for photoreal people, Expression 2 for any character. Run them in the cloud, in your app, or on your own machines.</p>
        <div class="hero-cta">
          <Button href="/start" size="lg">Quickstart</Button>
          <Button href="/api/reference" variant="secondary" size="lg">API reference</Button>
        </div>
      </div>
      <LiveDemo />
    </div>
  </section>

  <section class="band" aria-labelledby="start-building">
    <div class="container">
      <div class="band-head">
        <h2 id="start-building">Start building</h2>
        <a class="band-more" href="/sdk">All SDKs <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="cards cards-4" role="list">
        {START_BUILDING.map((c) => (
          <li>
            <a class="card" href={c.href}>
              <span class="card-icon"><Icon name={c.icon} /></span>
              <h3>{c.title}</h3>
              <p>{c.line}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="deployment">
    <div class="container">
      <div class="band-head">
        <h2 id="deployment">Choose your deployment</h2>
      </div>
      <ul class="cards cards-4 deploy" role="list">
        {DEPLOYMENTS.map((c) => (
          <li>
            <a class="card" href={c.href}>
              <span class="card-icon"><Icon name={c.icon} /></span>
              <span class="card-title"><h3>{c.title}</h3>{c.badge && <span class="badge">{c.badge}</span>}</span>
              <p>{c.line}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="models">
    <div class="container">
      <div class="band-head">
        <h2 id="models">Models</h2>
        <a class="band-more" href="/concepts/models">Compare models <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="cards cards-2" role="list">
        {MODELS.map((m) => (
          <li>
            <a class="card model" href={m.href}>
              <img src={m.image.src} width={m.image.width} height={m.image.height} alt={m.image.alt} loading="lazy" decoding="async" />
              <span class="model-body">
                <h3>{m.title}</h3>
                <p>{m.line}</p>
                <span class="specs">{m.specs.map((s) => <span class="spec">{s}</span>)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="note">{MODELS_NOTE}</p>
    </div>
  </section>

  <section class="band tint" aria-labelledby="performance">
    <div class="container">
      <div class="band-head">
        <h2 id="performance">Performance</h2>
        <a class="band-more" href="/performance">Every platform and how we measure <Icon name="arrow" size={16} /></a>
      </div>
      <PerfHeadline compact />
    </div>
  </section>

  <section class="band" aria-labelledby="guides">
    <div class="container">
      <div class="band-head">
        <h2 id="guides">Popular guides</h2>
        <a class="band-more" href="/guides">All guides <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="guides" role="list">
        {GUIDES.map((g) => (
          <li><a href={g.href}><span>{g.title}</span><Icon name="arrow" size={18} /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band last" aria-labelledby="resources">
    <div class="container">
      <h2 id="resources" class="band-title">Resources</h2>
      <ul class="res" role="list">
        {RESOURCES.map((r) => (
          <li><a href={r.href}><Icon name={r.icon} size={18} />{r.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero { padding-block: var(--space-10) var(--space-6); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: var(--space-8); align-items: center; }
  .hero h1 { font-size: var(--fh-3xl); line-height: 1.08; letter-spacing: -0.025em; max-width: 20ch; }
  .hero .lede { margin-top: var(--space-4); font-size: var(--ft-xl); line-height: var(--lh-snug); color: var(--color-text-secondary); max-width: 44ch; }
  .hero-cta { display: flex; gap: var(--space-3); margin-top: var(--space-6); flex-wrap: wrap; }

  /* ---- sections ---- */
  .band { padding-block: var(--space-6); }
  .band.tint { background: var(--color-surface-2); border-block: 1px solid var(--color-border); padding-block: var(--space-8); margin-block: var(--space-4); }
  .band.last { padding-bottom: var(--space-6); }
  .band-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); flex-wrap: wrap; }
  .band h2 { font-size: var(--fh-md); letter-spacing: -0.01em; }
  .band-title { margin-bottom: var(--space-4); }
  .band-more { display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--ft-sm); font-weight: var(--fw-medium); color: var(--color-primary); }
  .band-more:hover { color: var(--color-primary-hover); }
  .band-more :global(.icon) { transition: transform var(--t-fast) var(--ease); }
  .band-more:hover :global(.icon) { transform: translateX(2px); }

  /* ---- cards ---- */
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .cards-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cards-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cards > li { display: flex; }
  .card {
    display: flex; flex-direction: column; gap: var(--space-2); width: 100%;
    padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--r-xl);
    background: var(--color-surface); color: inherit;
    transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .card:focus-visible { border-radius: var(--r-xl); }
  .card h3 { font-size: var(--ft-md); font-weight: var(--fw-bold); letter-spacing: -0.01em; }
  .card p { font-size: var(--ft-sm); line-height: var(--lh-snug); color: var(--color-text-secondary); }
  .card-icon {
    display: inline-grid; place-items: center; width: 40px; height: 40px; margin-bottom: var(--space-2);
    border-radius: var(--r-lg); background: var(--color-primary-soft); color: var(--color-primary);
  }
  .card-title { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
  .badge {
    font-size: var(--ft-xs); font-weight: var(--fw-medium); line-height: 1.3; padding: 0.2rem 0.55rem; border-radius: var(--r-full);
    background: var(--color-surface-3); color: var(--color-text-secondary); border: 1px solid var(--color-border); text-align: center;
  }

  /* ---- models ---- */
  .model { flex-direction: row; align-items: stretch; gap: var(--space-5); padding: var(--space-3); }
  .model img { width: 132px; aspect-ratio: 3 / 4; height: auto; object-fit: cover; object-position: 50% 12%; border-radius: var(--r-lg); background: var(--color-surface-2); flex: none; }
  .model-body { display: flex; flex-direction: column; justify-content: center; gap: var(--space-2); padding-right: var(--space-3); }
  .model h3 { font-size: var(--ft-xl); }
  .specs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-1); }
  .spec { font-size: var(--ft-xs); font-weight: var(--fw-medium); padding: 0.2rem 0.55rem; border-radius: var(--r-full); background: var(--color-surface-2); color: var(--color-text-secondary); border: 1px solid var(--color-border); }
  .note { margin-top: var(--space-3); font-size: var(--ft-sm); color: var(--color-text-secondary); }

  /* ---- guides ---- */
  .guides { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .guides a {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding: 0.85rem 1rem; border: 1px solid var(--color-border); border-radius: var(--r-lg);
    font-size: var(--ft-sm); font-weight: var(--fw-medium); color: var(--color-text); background: var(--color-surface);
    transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .guides a :global(.icon) { color: var(--color-text-tertiary); flex: none; transition: transform var(--t-fast) var(--ease), color var(--t-fast) var(--ease); }
  .guides a:hover { border-color: var(--color-border-strong); color: var(--color-primary); }
  .guides a:hover :global(.icon) { color: var(--color-primary); transform: translateX(2px); }

  /* ---- resources ---- */
  .res { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .res a {
    display: inline-flex; align-items: center; gap: var(--space-2); padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border); border-radius: var(--r-full); background: var(--color-surface);
    font-size: var(--ft-sm); font-weight: var(--fw-medium); color: var(--color-text);
    transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .res a :global(.icon) { color: var(--color-text-secondary); }
  .res a:hover { border-color: var(--color-border-strong); color: var(--color-primary); }
  .res a:hover :global(.icon) { color: var(--color-primary); }

  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover { transition: none; transform: none; }
  }
  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .hero h1 { max-width: 18ch; }
    .cards-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .guides { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .cards-2 { grid-template-columns: 1fr; }
    .deploy { grid-template-columns: 1fr; }
    .guides { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero { padding-block: var(--space-6) var(--space-5); }
    .hero h1 { font-size: var(--fh-xl); }
    .hero .lede { font-size: var(--ft-lg); }
    .band { padding-block: var(--space-5); }
    .cards { gap: var(--space-3); }
    .card { padding: var(--space-4); }
    .card-icon { width: 36px; height: 36px; margin-bottom: 0; }
    .cards-4:not(.deploy) .card { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: var(--space-2); row-gap: var(--space-2); padding: var(--space-3); }
    .cards-4:not(.deploy) .card-icon { width: 32px; height: 32px; }
    .cards-4:not(.deploy) .card h3 { font-size: var(--ft-sm); }
    .cards-4:not(.deploy) .card p { grid-column: 1 / -1; font-size: var(--ft-xs); }
    .deploy .card { display: grid; grid-template-columns: auto 1fr; column-gap: var(--space-3); row-gap: var(--space-1); }
    .deploy .card-icon { grid-row: span 2; margin-bottom: 0; }
    .deploy .card-title { align-self: end; }
    .model img { width: 96px; }
    .model-body { padding-right: var(--space-1); }
    .model h3 { font-size: var(--ft-lg); }
  }
</style>
