---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Card from "../components/Card.astro";
import LiveDemo from "../components/LiveDemo.astro";
import { FRONT_DOOR_DEMO } from "../data/demo";
import MovedAnchors from "../components/MovedAnchors.astro";
import HUB_MOVED from "../data/hub-moved.json";
import { hubMeta } from "../config/hubs";
import { LANDING, START_BUILDING, DEPLOYMENTS, MODELS, MODELS_V1, GUIDES } from "../data/home";
import { headlineData } from "../lib/perf-headline";

// The front door (docs v2 SPEC §6): a head with two buttons and the live demo,
// then four bands of tiles: Platforms, Models, Where it runs, Start building.
// Every tile is one link; the detail lives on the page it opens. No chips, no
// bullets, no version strip (versions live on /downloads). Speed on the model
// cards is the generated headline (src/partials/performance-headline.md), as
// times real time; nothing here types a number.
const meta = hubMeta("");
const API_SECRET_URL = "https://www.bithuman.ai/developer/api-keys";
const headline = headlineData() ?? [];
const speed = (title: string) => {
  const row = headline.find((r) => r.model === title);
  return row ? `${row.cells.map((c) => `${c.platform} ${c.multiple}`).join(" · ")} real time` : undefined;
};
---

<Base title="bitHuman Docs: real-time AI avatar SDK for iOS, Android, web and Linux" description={meta.description}>
  <section class="hero" aria-labelledby="home-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="home-title">{LANDING.title}</h1>
        <p class="lede" data-subtitle><span class="brand-line">{LANDING.line.split(/(?<=\.) /)[0]}</span> {LANDING.line.split(/(?<=\.) /).slice(1).join(" ")}</p>
        <div class="hero-cta">
          <Button href="/start" size="lg">Quickstart</Button>
          <Button href={API_SECRET_URL} variant="secondary" size="lg">Get your API secret</Button>
        </div>
      </div>
      <div class="hero-demo" id="demo">
        <LiveDemo models={FRONT_DOOR_DEMO} eager label="Talk to a live avatar" />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="platforms">
    <div class="container">
      <div class="band-head">
        <h2 id="platforms">Platforms</h2>
        <a class="band-more" href="/platforms">All platforms <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="card-grid tiles" role="list">
        {START_BUILDING.map((c) => <li><Card href={c.href} title={c.title} icon={c.icon} variant="platform" /></li>)}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="models">
    <div class="container">
      <div class="band-head">
        <h2 id="models">Models</h2>
        <a class="band-more" href="/models">Compare models <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="card-grid cols-2 models-now" role="list">
        {MODELS.map((m) => (
          <li>
            <Card variant="model" href={m.href} title={m.title} line={m.line} note={speed(m.title)} tags={m.tags}
              media={{ src: `${m.poster}-480.webp`, avif: `${m.poster}-480.avif`, width: 480, height: 600, alt: m.alt, sizes: "168px" }} />
          </li>
        ))}
      </ul>
      <ul class="card-grid cols-2 models-v1" role="list">
        {MODELS_V1.map((m) => <li><Card href={m.href} title={m.title} line={m.line} /></li>)}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="where-it-runs">
    <div class="container">
      <div class="band-head">
        <h2 id="where-it-runs">Where it runs</h2>
        <a class="band-more" href="/deploy">Deployment options <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="card-grid cols-4 modes" role="list">
        {DEPLOYMENTS.map((c) => <li><Card href={c.href} title={c.title} line={c.line} icon={c.icon} /></li>)}
      </ul>
    </div>
  </section>

  <section class="band last" aria-labelledby="start-building">
    <div class="container">
      <div class="band-head">
        <h2 id="start-building">Start building</h2>
        <a class="band-more" href="/build">All guides <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="rows" role="list">
        {GUIDES.map((g) => (
          <li>
            <a class="row" href={g.href}>
              <span class="row-icon"><Icon name={g.icon} size={20} /></span>
              <span class="row-body"><span class="row-title">{g.title}</span><span class="row-line">{g.line}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <MovedAnchors moved={HUB_MOVED["/"]} quiet />
</Base>

<style>
  /* W8 (owner, 2026-09-30: "the left/right get separated so much"): the whole
     landing sits in one centred column narrower than the header; the hero's
     text and demo fill that same column, so their edges line up with every
     band below and nothing floats to the far edges. Bigger cards, fewer words. */
  .container { max-width: 1120px; }
  .hero { padding-block: var(--s-16) var(--s-12); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px); gap: var(--s-16); align-items: center; }
  .hero h1 { font-size: var(--fs-h1); line-height: var(--lh-h1); }
  .hero .lede { margin-top: var(--s-4); font-size: var(--fs-18); line-height: var(--lh-18); color: var(--color-text-secondary); max-width: 40ch; }
  .hero-cta { display: flex; gap: var(--s-3); margin-top: var(--s-8); flex-wrap: wrap; }
  .hero-demo { scroll-margin-top: calc(var(--nav-h) + var(--s-4)); }
  .hero-demo :global(.ld-status) { flex-basis: 100%; }
  @media (min-width: 1001px) {
    .hero h1 { font-size: var(--fs-hero); line-height: 1.1; letter-spacing: -0.015em; }
    .hero .lede { font-size: var(--fh-lg); line-height: var(--lh-18); }
    .hero .brand-line { display: block; margin-bottom: var(--s-1); color: var(--color-text); }
  }

  /* ---- bands ---- */
  .band { padding-block: var(--s-10); }
  .band.last { padding-bottom: var(--s-24); }
  .band-head { margin-bottom: var(--s-5); }
  .band-more :global(.icon) { transition: transform var(--t-fast) var(--ease); }
  .band-more:hover :global(.icon) { transform: translateX(2px); }

  /* platform tiles: a larger icon above the name, five across */
  .tiles { --cols: 5; gap: var(--s-4); }
  .tiles :global(.card-platform) { flex-direction: column; align-items: flex-start; justify-content: space-between; gap: var(--s-6); min-height: 112px; padding: var(--s-5) var(--s-5) var(--s-4); }
  .tiles :global(.card-icon) { width: 28px; height: 28px; color: var(--color-text); }
  .tiles :global(.card-icon svg) { width: 24px; height: 24px; }
  .tiles :global(.card-title h3) { font-size: var(--fs-16); line-height: var(--lh-16); font-weight: var(--fw-medium); margin: 0; }

  /* models: the current two large, with portraits; the first generation below, compact */
  .models-now { gap: var(--s-5); }
  .models-now :global(.card-model) { padding: var(--s-4); gap: var(--s-6); }
  .models-now :global(.card-model .card-figure) { width: 168px; }
  .models-now :global(.card-model .card-body) { gap: var(--s-3); }
  .models-v1 { margin-top: var(--s-4); gap: var(--s-5); }
  .models-v1 :global(.card) { padding: var(--s-4) var(--s-5); }

  .modes { gap: var(--s-5); }
  .modes :global(.card) { padding: var(--s-6); gap: var(--s-3); }

  /* start building: icon rows, two columns */
  .rows { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-10); }
  .rows > li { border-top: 1px solid var(--color-border); }
  .row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-3); align-items: start; padding-block: var(--s-5); color: var(--color-text); text-decoration: none; }
  .row-icon { color: var(--color-text-secondary); padding-top: 2px; }
  .row-body { display: flex; flex-direction: column; gap: var(--s-1); }
  .row-title { font-size: var(--fs-16); line-height: var(--lh-16); font-weight: var(--fw-medium); }
  .row-line { font-size: var(--fs-14); line-height: var(--lh-14); color: var(--color-text-secondary); }
  .row:hover .row-title { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 1100px) { .modes { --cols: 2; } }
  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); justify-content: stretch; gap: var(--s-8); }
    .hero-demo { max-width: 420px; }
  }
  @media (max-width: 768px) {
    .tiles { --cols: 2; }
    .rows { grid-template-columns: 1fr; }
    .models-now :global(.card-model .card-figure) { width: 120px; }
  }
  @media (max-width: 640px) { .modes { --cols: 1; } .models-v1 { --cols: 1; } }
  @media (max-width: 560px) {
    .hero { padding-block: var(--s-6) var(--s-6); }
    .band { padding-block: var(--s-6); }
    .tiles :global(.card-platform) { min-height: 0; gap: var(--s-3); padding: var(--s-4); }
    .models-now :global(.card-model .card-figure) { width: 88px; }
  }
</style>
