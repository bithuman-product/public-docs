---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Card from "../components/Card.astro";
import Chip from "../components/Chip.astro";
import LiveDemo from "../components/LiveDemo.astro";
import RunsEverywhere from "../components/RunsEverywhere.astro";
import WhatsNew from "../components/WhatsNew.astro";
import { hubMeta } from "../config/hubs";
import { HERO, START_BUILDING, DEPLOYMENTS, CPU_NOTE, MODELS, MODELS_NOTE, GUIDES, RESOURCES } from "../data/home";
import { contactSalesUrl } from "../config/nav";
import { versionLabel, type Artifact } from "../data/labels";

// The front door: a live avatar first, then the measured proof, then where to
// click, as cards. Each card is one link and one line; the detail lives on the
// page it opens. Speed comes from performance.json only (the Runs everywhere
// band), as times real time, on-device first.
const meta = hubMeta("");
const STRIP: Artifact[] = ["swift", "expression2_android", "essence2_android", "python", "cli", "flutter_plugin"];

const deployMain = DEPLOYMENTS.filter((d) => !d.wide);
const deployWide = DEPLOYMENTS.filter((d) => d.wide);
---

<Base title="bitHuman Docs: real-time AI avatar SDK for iOS, Android, web and Linux" description={meta.description}>
  <section class="hero" aria-labelledby="home-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="home-title">{HERO.title}</h1>
        <p class="lede">{HERO.line}</p>
        <div class="hero-cta">
          <Button href="/start" size="lg">Start in 2 minutes</Button>
          <Button href="#demo" variant="secondary" size="lg">Talk to an avatar</Button>
        </div>
        <ul class="strip" aria-label="Current versions">
          {STRIP.map((a) => <li><Chip kind="version" label={versionLabel(a)} href="/downloads" /></li>)}
        </ul>
      </div>
      <div class="hero-demo" id="demo">
        <LiveDemo eager label="Talk to a live avatar" />
      </div>
    </div>
  </section>

  <section class="band band-proof">
    <div class="container">
      <RunsEverywhere />
    </div>
  </section>

  <section class="band" aria-labelledby="start-building">
    <div class="container">
      <div class="band-head">
        <h2 id="start-building">Start building</h2>
        <a class="band-more" href="/platforms">All platforms <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="card-grid cols-3 compact" role="list">
        {START_BUILDING.map((c) => <li><Card href={c.href} title={c.title} line={c.line} icon={c.icon} variant="platform" /></li>)}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="where-it-runs">
    <div class="container">
      <div class="band-head">
        <h2 id="where-it-runs">Where it runs</h2>
        <a class="band-more" href="/deploy">Deployment options <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="card-grid cols-3" role="list">
        {deployMain.map((c) => <li><Card href={c.href} title={c.title} line={c.line} icon={c.icon} /></li>)}
        {deployWide.map((c) => (
          <li class="span-all">
            <Card href={c.href} title={c.title} line={c.line} note={c.note} icon={c.icon} badge={c.badge} wide />
          </li>
        ))}
      </ul>
      <p class="band-foot">{CPU_NOTE.line}: <a href={CPU_NOTE.href}>{CPU_NOTE.title}</a>. Fully offline is arranged through sales: <a href={contactSalesUrl("offline")}>Contact sales</a>.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="models">
    <div class="container">
      <div class="band-head">
        <h2 id="models">Models</h2>
        <a class="band-more" href="/models">Compare models <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="card-grid cols-2" role="list">
        {MODELS.map((m) => (
          <li>
            <Card variant="model" href={m.href} title={m.title} line={m.line}
              media={{ src: `${m.poster}-480.webp`, avif: `${m.poster}-480.avif`, width: 480, height: 600, alt: m.alt, sizes: "132px" }} />
          </li>
        ))}
      </ul>
      <div class="models-foot">
        <p class="note">{MODELS_NOTE}</p>
        <a class="band-more" href="/models/first-generation">First generation <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="build">
    <div class="container">
      <div class="band-head">
        <h2 id="build">Build</h2>
        <a class="band-more" href="/build">All recipes <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="card-grid cols-3 compact" role="list">
        {GUIDES.map((g) => <li><Card href={g.href} title={g.title} line={g.line} icon={g.icon} variant="platform" /></li>)}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="whats-new">
    <div class="container">
      <WhatsNew />
    </div>
  </section>

  <section class="band last" aria-labelledby="resources">
    <div class="container">
      <h2 id="resources" class="band-title">Resources</h2>
      <ul class="res" role="list">
        {RESOURCES.map((r) => (
          <li><a href={r.href}><Icon name={r.icon} size={18} />{r.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero { padding-block: var(--s-10) var(--s-8); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: var(--s-12); align-items: center; }
  .hero h1 { font-size: var(--fh-hero); line-height: 1.08; letter-spacing: -0.025em; max-width: 18ch; }
  .hero .lede { margin-top: var(--s-5); font-size: var(--ft-xl); line-height: var(--lh-snug); color: var(--color-text-secondary); max-width: 46ch; }
  .hero-cta { display: flex; gap: var(--s-3); margin-top: var(--s-8); flex-wrap: wrap; }
  .strip { list-style: none; margin: var(--s-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .hero-demo { scroll-margin-top: calc(var(--nav-h) + var(--s-4)); }

  /* ---- bands ---- */
  .band { padding-block: var(--s-8); }
  .band.last { padding-bottom: var(--s-8); }
  .band-title { font-size: var(--fh-md); letter-spacing: -0.01em; margin-bottom: var(--s-4); }
  .band-more :global(.icon) { transition: transform var(--t-fast) var(--ease); }
  .band-more:hover :global(.icon) { transform: translateX(2px); }
  .band-foot { margin-top: var(--s-3); font-size: var(--ft-sm); color: var(--color-text-secondary); }

  /* compact platform cards: icon beside the title */
  .compact :global(.card-platform) { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--s-3); align-items: start; }

  /* ---- models ---- */
  .models-foot { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2) var(--s-4); flex-wrap: wrap; margin-top: var(--s-4); }
  .note { font-size: var(--ft-sm); color: var(--color-text-secondary); flex: 1 1 32rem; margin: 0; }

  .band-proof { padding-top: var(--s-4); }

  /* ---- resources ---- */
  .res { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .res a {
    display: inline-flex; align-items: center; gap: var(--s-2); padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border); border-radius: var(--r-pill); background: var(--color-surface);
    font-size: var(--ft-sm); font-weight: var(--fw-medium); color: var(--color-text);
    transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .res a :global(.icon) { color: var(--color-text-secondary); }
  .res a:hover { border-color: var(--color-border-strong); color: var(--color-primary); }
  .res a:hover :global(.icon) { color: var(--color-primary); }

  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-8); }
    .hero h1 { max-width: 20ch; }
  }
  @media (max-width: 560px) {
    .hero { padding-block: var(--s-8) var(--s-6); }
    .hero h1 { font-size: var(--fh-xl); }
    .hero .lede { font-size: var(--ft-lg); }
    .band { padding-block: var(--s-6); }
  }
</style>
