---
import Base from "../../layouts/Base.astro";

// Five platforms, three lines each: install, get a free showcase model, run.
// Every line is a copy-paste excerpt of the platform page it links to — that
// page is the writer, this one quotes it. The performance line quotes
// /sdk/performance: measured, unpaced, from the bytes a developer installs.
const blocks = [
  {
    name: "macOS",
    sub: "Apple Silicon · CLI 2.6.5",
    href: "/sdk/macos",
    install: "curl -fsSL https://raw.githubusercontent.com/bithuman-product/homebrew-bithuman/main/install.sh | sh",
    model: "MODEL=$(bithuman pull marmalade --manifest https://api.bithuman.ai/v1/models/showcase)",
    run: "bithuman run \"$MODEL\"          # then open http://127.0.0.1:8088/",
    perf: "Apple M4 — Expression 2 54 fps · Essence 2 2 fps",
  },
  {
    name: "iOS",
    sub: "a physical iPhone or iPad · Xcode 26+",
    href: "/sdk/ios",
    install: ".package(url: \"https://github.com/bithuman-product/homebrew-bithuman.git\", from: \"2.11.0\")   // product: Expression2",
    model: "curl -fLO \"https://tmoobjxlwcwvxvjeppzq.supabase.co/storage/v1/object/public/web/{showcase/A08CCD3871.avatar,engines/expression-2/mac-arm64-1.0.0.engine}\"",
    run: "# Xcode: Signing & Capabilities → your team → select your iPhone → Run",
    perf: "iPhone 15 (A16) — Expression 2 107 fps · Essence 2 —",
  },
  {
    name: "Android",
    sub: "arm64-v8a · minSdk 26",
    href: "/sdk/android",
    install: "implementation(\"ai.bithuman:expression2-android:0.4.1\")",
    model: "val model = Expression2ModelStore(context).fetch(\"A66GYD8664\")   // anonymous HTTPS",
    run: "./gradlew :app:installDebug",
    perf: "Galaxy S25+ (Snapdragon 8 Elite) — Expression 2 58 fps · Essence 2 —",
  },
  {
    name: "Web",
    sub: "any modern browser",
    href: "/sdk/web",
    install: "# nothing to install",
    model: "CODE=A74NWD9723                  # or any code on /showcase",
    run: "open \"https://www.bithuman.ai/$CODE?rendering_mode=browser\"",
    perf: "Chrome on M4 — no in-tab figure yet; the hosted route plays at 20 / 25 fps",
  },
  {
    name: "Python / Linux",
    sub: "Python 3.10–3.14 · macOS arm64 · Linux x86_64 / aarch64",
    href: "/sdk/python",
    install: "pip install \"bithuman[expression-2]\"",
    model: "curl -fsSLO \"https://tmoobjxlwcwvxvjeppzq.supabase.co/storage/v1/object/public/web/showcase/{A23WJF0199.avatar,demo_sample.wav}\"",
    run: "BITHUMAN_API_SECRET=… python -c 'import bithuman; [print(f.shape) for f in bithuman.open(\"A23WJF0199.avatar\").render(\"demo_sample.wav\")]'",
    perf: "x86 workstation (Ryzen Threadripper PRO 5955WX) — Expression 2 26 fps from Python, 34 from the CLI · Essence 2 1 fps",
  },
];
---

<Base
  title="SDK — bitHuman docs"
  description="Run a bitHuman avatar on your device. Pick a platform — macOS, iOS, Android, Web, Python / Linux: install, get a free model, run."
>
  <section class="sdk">
    <div class="container">
      <h1>Run a bitHuman avatar on your device. Pick a platform.</h1>
      <div class="grid">
        {blocks.map((b) => (
          <article class="block">
            <h2><a href={b.href}>{b.name}</a> <span class="sub">{b.sub}</span></h2>
            <dl>
              <div><dt>Install</dt><dd><pre><code>{b.install}</code></pre></dd></div>
              <div><dt>Get a model</dt><dd><pre><code>{b.model}</code></pre></dd></div>
              <div><dt>Run</dt><dd><pre><code>{b.run}</code></pre></dd></div>
            </dl>
            <p class="guide"><a href={b.href}>Full guide →</a></p>
            <p class="perf"><a href="/sdk/performance">Measured</a>, unpaced: {b.perf}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .sdk { padding-block: var(--space-6) var(--space-10); }
  .sdk h1 { font-size: var(--fh-2xl); max-width: 30ch; }
  .grid { margin-top: var(--space-5); display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); }
  .block { border: 1px solid var(--color-border); border-radius: var(--r-xl); padding: var(--space-4); min-width: 0; }
  .block h2 { margin: 0; font-size: var(--ft-md); font-weight: var(--fw-semibold); }
  .sub { display: block; color: var(--color-text-tertiary); font-size: var(--ft-xs); font-weight: var(--fw-normal); margin-top: 0.15rem; }
  dl { margin: var(--space-3) 0 0; }
  dl div { margin-top: var(--space-2); }
  dt { font-size: var(--ft-xs); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-tertiary); font-weight: var(--fw-medium); }
  dd { margin: 0.2rem 0 0; }
  pre { margin: 0; padding: 0.5rem 0.65rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--r-md); overflow-x: auto; }
  pre code { font-size: 0.78rem; line-height: 1.5; white-space: pre; }
  .guide { margin: var(--space-3) 0 0; font-weight: var(--fw-semibold); }
  .perf { margin: var(--space-2) 0 0; font-size: var(--ft-sm); color: var(--color-text-secondary); }
</style>
