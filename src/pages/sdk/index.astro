---
import Base from "../../layouts/Base.astro";
import Code from "../../components/Code.astro";

// Organised by MODEL, then by platform.
//
// It used to be the other way round, and every card carried both models. That
// repeated the same two names five times, and it hid the thing a reader most
// needs: the two models do NOT run in the same places. Expression 2 has a
// documented on-device path on all five. Essence 2 has one WRITTEN on the CLI
// and the Python library; on iPhone and on Android the SDK ships and was
// measured on a real device, but the step-by-step is not written yet, and in a
// browser the published package is a demo. That is a docs gap on the handsets
// and a product limit only on the web.
// Grouped this way the difference IS the content, rather than something a
// reader has to reconstruct by comparing five cards.
//
// Where the setup is the same for both models — one CLI, one Python package —
// it is written once here and shown in both panes, with the one line that
// actually differs called out on the card.
//
// No frame rate appears on this page. Performance is /sdk/performance, linked
// once, and a card answers "is this my platform and what do I run".
//
// Every command is a copy-paste excerpt of the platform page the card links to;
// that page is the writer, this one quotes it.

const CLI_SETUP = {
  install: "curl -fsSL https://raw.githubusercontent.com/bithuman-product/homebrew-bithuman/main/install.sh | sh",
  model: "bithuman login                    # opens your browser; stores a per-device key on this machine\nbithuman pull marmalade           # prints ~/.cache/bithuman/showcase/marmalade.imx",
  run: "bithuman run \"$(bithuman pull marmalade)\"                                # live avatar in your browser",
};

const MARKS: Record<string, string> = {
  cli: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7.5 9.5 10.5 12l-3 2.5M13 15h3.5"/>`,
  ios: `<rect x="7" y="2" width="10" height="20" rx="2.5"/><line x1="10.5" y1="4.8" x2="13.5" y2="4.8"/>`,
  android: `<rect x="6" y="2" width="12" height="20" rx="2.5"/><line x1="10" y1="18.8" x2="14" y2="18.8"/>`,
  web: `<rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="8.5" x2="21" y2="8.5"/><circle cx="6" cy="6.2" r=".55" fill="currentColor" stroke="none"/><circle cx="8.2" cy="6.2" r=".55" fill="currentColor" stroke="none"/>`,
  python: `<path d="M9 8 5 12l4 4M15 8l4 4-4 4"/>`,
};

interface Card {
  key: string;
  name: string;
  sub: string;
  href: string;
  /** The one thing that differs for this model on this platform. */
  note?: string;
  setup?: { install: string; model: string; code?: string; run: string };
  /** Used instead of `setup` where this site documents no on-device path. */
  elsewhere?: string;
}

interface Model {
  id: string;
  name: string;
  what: string;
  concept: string;
  cards: Card[];
}

const models: Model[] = [
  {
    id: "expression-2",
    name: "Expression 2",
    what: "The whole scene generated from your portrait — head, shoulders, background.",
    concept: "/concepts/expression-2",
    cards: [
      {
        key: "cli",
        name: "macOS & Linux",
        sub: "Apple Silicon · x86_64",
        href: "/sdk/cli",
        note: "One CLI runs both models. `bithuman run` with no argument fetches the free Wise Pup, an Expression 2 identity.",
        setup: CLI_SETUP,
      },
      {
        key: "ios",
        name: "iOS",
        sub: "iPhone or iPad · Xcode 26+",
        href: "/sdk/ios",
        setup: {
          install: ".package(url: \"https://github.com/bithuman-product/homebrew-bithuman.git\", from: \"2.11.0\")\n// product: .product(name: \"Expression2\", package: \"homebrew-bithuman\")",
          model: "curl -fLO \"https://tmoobjxlwcwvxvjeppzq.supabase.co/storage/v1/object/public/web/{showcase/A08CCD3871.avatar,engines/expression-2/mac-arm64-1.0.0.engine}\"",
          run: "# In Xcode: Signing & Capabilities → your team → select your iPhone → Run",
        },
      },
      {
        key: "android",
        name: "Android",
        sub: "arm64-v8a · minSdk 26",
        href: "/sdk/android",
        setup: {
          install: "implementation(\"ai.bithuman:expression2-android:0.4.1\")",
          model: "val model = Expression2ModelStore(context).fetch(\"A02HCY0444\")   // ~158 MB the first time; never on the main thread",
          run: "./gradlew :app:installDebug",
        },
      },
      {
        key: "web",
        name: "Web",
        sub: "any modern browser",
        href: "/sdk/web",
        note: "`?render=local` moves the render into the tab; without it the avatar is served.",
        setup: {
          install: "# nothing to install",
          model: "# A74NWD9723 — or any code on /showcase",
          run: "open \"https://www.bithuman.ai/A74NWD9723?render=local\"",
        },
      },
      {
        key: "python",
        name: "Python",
        sub: "Python 3.10–3.14 · macOS arm64 · Linux x86_64 / aarch64",
        href: "/sdk/python",
        note: "One package runs both models. The `[expression-2]` extra is what opens a `.avatar`.",
        setup: {
          install: "pip install \"bithuman[expression-2]\"",
          model: "curl -fsSLO \"https://tmoobjxlwcwvxvjeppzq.supabase.co/storage/v1/object/public/web/showcase/{A23WJF0199.avatar,demo_sample.wav}\"",
          code: "# hello.py\nimport bithuman\n\nwith bithuman.open(\"A23WJF0199.avatar\") as avatar:      # an Essence 2 .imx or an Expression 2 .avatar — one call\n    for image in avatar.render(\"demo_sample.wav\"):     # (height, width, 3) uint8, RGB, at the avatar's own frame rate\n        print(image.shape)                             # hand it to your display — OpenCV wants image[:, :, ::-1]",
          run: "export BITHUMAN_API_SECRET=…        # free at https://www.bithuman.ai/developer/api-keys\npython hello.py",
        },
      },
    ],
  },
  {
    id: "essence-2",
    name: "Essence 2",
    what: "Your own portrait footage, animated — the identity you uploaded, lip-synced.",
    concept: "/concepts/essence-2",
    cards: [
      {
        key: "cli",
        name: "macOS & Linux",
        sub: "Apple Silicon · x86_64",
        href: "/sdk/cli",
        note: "The same CLI. `--model essence-2` picks the family when your agent has more than one.",
        setup: CLI_SETUP,
      },
      {
        key: "python",
        name: "Python",
        sub: "Python 3.10–3.14 · macOS arm64 · Linux x86_64 / aarch64",
        href: "/sdk/python",
        note: "The same package. Live frames need no extra; the `[offline]` extra is for rendering a whole clip to MP4.",
        setup: {
          install: "pip install bithuman",
          model: "# your agent's .imx — bithuman pull <CODE>, or GET /v1/agent/{code}/model/download",
          code: "# hello.py\nimport bithuman\n\nwith bithuman.open(\"agent.imx\") as avatar:               # an Essence 2 .imx or an Expression 2 .avatar — one call\n    for image in avatar.render(\"speech.wav\"):          # (height, width, 3) uint8, RGB, at the avatar's own frame rate\n        print(image.shape)",
          run: "export BITHUMAN_API_SECRET=…        # free at https://www.bithuman.ai/developer/api-keys\npython hello.py",
        },
      },
      {
        key: "ios",
        name: "iOS",
        sub: "iPhone or iPad",
        href: "/sdk/ios",
        elsewhere: "The same Swift package carries Essence 2 from 2.13.2, and it opens the `.imx` the download endpoint serves. The step-by-step is not written yet — the [iOS page](/sdk/ios) has the package, and the [cloud API](/api/overview) renders it meanwhile.",
      },
      {
        key: "android",
        name: "Android",
        sub: "arm64-v8a",
        href: "/sdk/android",
        elsewhere: "The Essence 2 Android SDK is published and runs on a handset; the step-by-step is not on the [Android page](/sdk/android) yet. Until it is, use the [CLI](/sdk/cli), the [Python library](/sdk/python) or the [cloud API](/api/overview).",
      },
      {
        key: "web",
        name: "Web",
        sub: "any modern browser",
        href: "/sdk/web",
        elsewhere: "The published in-browser package is a demo: one built-in identity, and it cannot render your own agent. Serve the avatar over the [cloud API](/api/overview) instead.",
      },
    ],
  },
];

/** `a [b](/c)` → HTML, so a note can carry one link without a markdown parser. */
const rich = (s: string) =>
  s
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---

<Base
  title="SDK — bitHuman docs"
  description="Run a bitHuman avatar on your device. Pick a model — Expression 2 or Essence 2 — then your platform: macOS, Linux, iOS, Android, Web, Python."
>
  <section class="sdk">
    <div class="container" data-behind>
      <h1 id="platforms">Run a bitHuman avatar on your device</h1>
      <p class="lede">Pick a model, then your platform.</p>

      <nav class="tabs" aria-label="Model">
        {models.map((m) => (
          <a class:list={["tab", `tab-${m.id}`]} href={`#${m.id}`}>{m.name}</a>
        ))}
      </nav>

      <div class="panes">
        {models.map((m) => (
          <section class="pane" id={m.id} aria-labelledby={`${m.id}-h`}>
            <p class="what">
              <strong id={`${m.id}-h`}>{m.name}</strong> — {m.what}{" "}
              <a href={m.concept}>How it works</a>
            </p>

            <div class="gallery">
              {m.cards.map((c) => (
                <article class="card">
                  <span class="mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={MARKS[c.key]} /></svg>
                  </span>

                  <h2 class="name">
                    {c.setup
                      ? <a href={`#${m.id}-${c.key}`} aria-haspopup="dialog">{c.name}</a>
                      : <a href={c.href}>{c.name}</a>}
                  </h2>
                  <p class="sub">{c.sub}</p>

                  {c.elsewhere
                    ? <p class="elsewhere" set:html={rich(c.elsewhere)} />
                    : <p class="cue" aria-hidden="true">Setup <span>→</span></p>}
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <p class="perf">Measured frame rates for every platform and both models are on the <a href="/sdk/performance">performance page</a>.</p>
    </div>

    {/* The panels. Full viewport, so a command has room to sit on one line.
        They are last in the document and opened by :target alone — no
        scripting is needed to open one, close one, link to one, or go back
        from one. */}
    {models.map((m) => m.cards.filter((c) => c.setup).map((c) => (
      <div
        class="panel"
        id={`${m.id}-${c.key}`}
        role="dialog"
        aria-labelledby={`${m.id}-${c.key}-title`}
        tabindex="-1"
      >
        <div class="panel-bar">
          <div class="panel-titles">
            <p class="panel-model">{m.name}</p>
            <h2 id={`${m.id}-${c.key}-title`}>{c.name}</h2>
          </div>
          <a class="panel-close" href={`#${m.id}`}>
            <span class="sr-only">Close</span>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
        </div>

        <div class="panel-inner">
          <p class="panel-sub">{c.sub}</p>
          {c.note && <p class="note" set:html={rich(c.note)} />}
          <ol class="steps">
            <li><span class="step">Install</span><Code code={c.setup!.install} /></li>
            <li><span class="step">Get a model</span><Code code={c.setup!.model} /></li>
            {c.setup!.code && <li><span class="step">Minimal code</span><Code code={c.setup!.code} /></li>}
            <li><span class="step">Run</span><Code code={c.setup!.run} /></li>
          </ol>
          <p class="ends">
            <a class="guide" href={c.href}>Full guide <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    )))}
  </section>
</Base>

<script>
  // The panel already opens, closes, carries a URL and answers the back button
  // with no scripting at all — that is :target doing the work, and it is the
  // behaviour a reader gets if this file never loads. What this adds is the
  // part CSS cannot do: ESC, focus moving into the panel and back to the card
  // that opened it, and the page behind going inert so Tab cannot wander out.
  (() => {
    const openPanel = () => document.querySelector(".panel:target") as HTMLElement | null;
    const main = document.getElementById("main");
    const behind = () => [
      ...Array.from(document.body.children).filter((el) => el !== main),
      ...Array.from(document.querySelectorAll("[data-behind]")),
    ] as HTMLElement[];
    let opener: HTMLElement | null = null;

    const sync = () => {
      const panel = openPanel();
      behind().forEach((el) => { el.inert = !!panel; });
      document.querySelectorAll(".panel[aria-modal]").forEach((el) => {
        if (el !== panel) el.removeAttribute("aria-modal");
      });
      if (panel) {
        // Only now is it modal: the trap below is what makes that true, and it
        // exists only when this script does.
        panel.setAttribute("aria-modal", "true");
        if (!panel.contains(document.activeElement)) panel.focus();
      } else if (opener) {
        opener.focus();
        opener = null;
      }
    };

    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement)?.closest?.("a[href^='#']") as HTMLAnchorElement | null;
      if (!a) return;
      const id = a.getAttribute("href")!.slice(1);
      if (id && document.getElementById(id)?.classList.contains("panel")) opener = a;
    });

    addEventListener("hashchange", sync);
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && openPanel()) { e.preventDefault(); history.back(); return; }
      if (e.key !== "Tab") return;
      const panel = openPanel();
      if (!panel) return;
      const stops = Array.from(
        panel.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter((el) => (el as HTMLElement).offsetParent !== null) as HTMLElement[];
      if (!stops.length) return;
      const first = stops[0], last = stops[stops.length - 1];
      const here = document.activeElement;
      if (!e.shiftKey && here === last) { e.preventDefault(); first.focus(); }
      else if (e.shiftKey && (here === first || here === panel)) { e.preventDefault(); last.focus(); }
    });
    sync();
  })();
</script>

<style>
  .sdk { padding-block: var(--space-8) var(--space-12); }
  .sdk h1 { font-size: var(--fh-2xl); max-width: 22ch; scroll-margin-top: calc(var(--nav-h) + 20px); }
  .lede { margin-top: var(--space-3); font-size: var(--ft-lg); color: var(--color-text-secondary); }

  /* Two links, one fragment each, so the chosen model has a URL and the back
     button returns to the other one. */
  .tabs { display: flex; gap: var(--space-1); margin-top: var(--space-6); border-bottom: 1px solid var(--color-border); }
  .tab {
    padding: 0.6rem var(--space-4);
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .tab:hover { color: var(--color-text); }

  .pane { display: none; }
  /* Expression 2 until the reader asks for the other one. Where :has() is
     unavailable both panes show, which is complete rather than broken. */
  .panes:not(:has(:target)) .pane:first-of-type { display: block; }
  .pane:target { display: block; }
  /* A panel is outside its pane in the document, so the pane it belongs to is
     matched by id prefix instead of by containment. */
  .sdk:has([id^="essence-2-"].panel:target) #essence-2,
  .sdk:has([id^="expression-2-"].panel:target) #expression-2 { display: block; }
  .sdk:not(:has(#essence-2:target)):not(:has([id^="essence-2-"].panel:target)) .tab-expression-2,
  .sdk:has(#essence-2:target) .tab-essence-2,
  .sdk:has([id^="essence-2-"].panel:target) .tab-essence-2 {
    color: var(--color-text);
    border-bottom-color: var(--color-primary);
  }

  .what { margin-top: var(--space-5); max-width: 62ch; color: var(--color-text-secondary); }
  .what strong { color: var(--color-text); }
  .what a { color: var(--color-primary); font-weight: var(--fw-medium); }

  .gallery {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(21rem, 100%), 1fr));
    /* Each card owns its height, so opening one grows only that one and leaves
       the cards beside it the shape they had. */
    align-items: start;
  }

  .card {
    position: relative;
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--r-2xl);
    background: var(--color-surface);
    scroll-margin-top: calc(var(--nav-h) + 16px);
    transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-sm); }

  .mark { display: block; color: var(--color-primary); }
  .mark svg { width: 22px; height: 22px; }

  .name { margin-top: var(--space-3); font-size: var(--fh-md); letter-spacing: -0.015em; }
  /* The whole card is the target, while the link's name stays just the platform. */
  .name a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .name a:focus-visible { outline: none; }
  .name a:focus-visible::after { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .sub { margin-top: 0.25rem; color: var(--color-text-tertiary); font-size: var(--ft-sm); }

  .cue { margin-top: var(--space-4); font-size: var(--ft-sm); font-weight: var(--fw-medium); color: var(--color-primary); }
  .cue span { display: inline-block; transition: transform var(--t-fast) var(--ease); }
  .card:hover .cue span { transform: translateX(3px); }

  .elsewhere { position: relative; z-index: 1; margin-top: var(--space-4); font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .elsewhere :global(a) { color: var(--color-primary); font-weight: var(--fw-medium); }


  .note { margin-top: var(--space-4); font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .note :global(code) { font-family: var(--font-mono); font-size: 0.86em; }

  .steps { list-style: none; margin: var(--space-4) 0 0; padding: 0; counter-reset: step; }
  .steps li { margin-top: var(--space-4); min-width: 0; }
  .steps li:first-child { margin-top: 0; }
  .step {
    counter-increment: step;
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--ft-xs);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-tertiary);
  }
  .step::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.5rem;
    border-radius: var(--r-full);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 0.65rem;
    letter-spacing: 0;
    vertical-align: -0.3rem;
  }
  .steps :global(.bh-code) { margin: 0; }

  .ends { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-5); }
  .guide { font-weight: var(--fw-medium); color: var(--color-primary); }
  .guide span { display: inline-block; transition: transform var(--t-fast) var(--ease); }
  .guide:hover span { transform: translateX(3px); }
  .close { font-size: var(--ft-sm); color: var(--color-text-tertiary); }
  .close:hover { color: var(--color-text); }


  /* ============================ the panel ============================
     Full viewport, because a shell command in a one-third column is the same
     unreadable as a clipped one. :target alone opens it, so this works with
     nothing running; the script beside it adds ESC and focus handling. */
  .panel { display: none; }
  .panel:target {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-bg);
  }
  .panel:focus { outline: none; }
  /* The page behind must not scroll under an open panel. */
  :global(html:has(.panel:target)),
  :global(body:has(.panel:target)) { overflow: hidden; }

  .panel-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }
  .panel-titles { min-width: 0; }
  .panel-model { font-size: var(--ft-xs); font-weight: var(--fw-medium); text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-primary); }
  .panel-bar h2 { margin-top: 0.1rem; font-size: var(--fh-md); letter-spacing: -0.015em; }
  .panel-close {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--r-full);
    font-size: var(--ft-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    background: var(--color-surface);
  }
  .panel-close:hover { color: var(--color-text); border-color: var(--color-border-strong); }
  .panel-close .sr-only { display: none; }
  @media (min-width: 701px) { .panel-close .sr-only { display: inline; } }

  .panel-inner {
    max-width: 1180px;
    margin-inline: auto;
    padding: var(--space-6) var(--space-5) var(--space-12);
  }
  .panel-sub { color: var(--color-text-tertiary); font-size: var(--ft-sm); }
  .panel .note { margin-top: var(--space-3); max-width: 70ch; }
  .panel .steps { margin-top: var(--space-6); }
  .panel .steps li { margin-top: var(--space-6); }
  .panel .step { font-size: var(--ft-sm); }
  /* Room for a long command to stay on one line. */
  .panel :global(.bh-code) { --code-fs: 0.9rem; }
  .panel .ends { justify-content: flex-start; margin-top: var(--space-8); }

  @media (max-width: 700px) {
    /* A phone IS the panel, so the bar does the work a desktop close button
       does: it stays put, names where you are, and the target is thumb-sized. */
    .panel-bar { padding: var(--space-3) var(--space-4); }
    .panel-bar h2 { font-size: var(--ft-lg); }
    .panel-close { padding: 0.65rem; }
    .panel-close svg { width: 20px; height: 20px; }
