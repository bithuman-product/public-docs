---
import Base from "../../layouts/Base.astro";
import PerfHeadline from "../../components/PerfHeadline.astro";
import { hubMeta } from "../../config/hubs";
import versions from "../../data/versions.json";

const V = versions.versions;

// One card per platform, with the artifact version from versions.json. The
// platform page is the one place its install, first frame and code live.
const platforms = [
  { name: "CLI", sub: "macOS (Apple silicon), Linux x86_64 and arm64", href: "/sdk/cli", ver: `CLI ${V.cli}`, note: "No code: a live avatar in your browser, or an MP4 from audio." },
  { name: "Python", sub: "Python 3.10–3.14", href: "/sdk/python", ver: `bithuman ${V.python}`, note: "Frames and MP4s from your own code; stream audio in, frames out." },
  { name: "Apple", sub: "iOS, iPadOS, macOS · Xcode 26+", href: "/sdk/apple", ver: `Swift package ${V.swift}`, note: "The Essence2 and Expression2 products, on the device." },
  { name: "Android", sub: "arm64-v8a · Maven Central", href: "/sdk/android", ver: `essence2-android ${V.essence2_android} · expression2-android ${V.expression2_android}`, note: "Both models on the handset." },
  { name: "Web", sub: "any modern browser", href: "/sdk/web", ver: "nothing to install", note: "One URL or one iframe; WebGPU when the device has it." },
  { name: "LiveKit", sub: "Python agents", href: "/sdk/livekit", ver: `livekit-plugins-bithuman ${V.livekit_plugin}`, note: "A face for a LiveKit voice agent." },
  { name: "MCP server", sub: "Claude, Cursor and other MCP clients", href: "/sdk/mcp", ver: `in the CLI ${V.cli}`, note: "bitHuman as tools for an AI agent." },
];

---

<Base title="SDKs — bitHuman docs" description={hubMeta("sdk").description}>
  <section class="sdk">
    <div class="container">
      <h1>SDKs</h1>
      <p class="lede">Run Essence 2 and Expression 2 on your own hardware or in your own app. Every platform takes the same API secret, and credits pay for session time, talking or idle. Not sure which model? <a href="/concepts/models">Models: which one?</a></p>

      <div class="gallery">
        {platforms.map((p) => (
          <a class="pcard" href={p.href}>
            <h2>{p.name}</h2>
            <p class="sub">{p.sub}</p>
            <p class="note">{p.note}</p>
            <p class="ver"><code>{p.ver}</code></p>
          </a>
        ))}
      </div>

      <h2 class="sec" id="performance">How fast it runs</h2>
      <PerfHeadline />

      <p class="more">Also: <a href="/api">the cloud API</a> · <a href="/guides/self-hosting">self-hosting</a> · <a href="/guides/pricing#offline-licensing">offline licence</a> · <a href="/downloads">downloads & versions</a> · references for the <a href="/sdk/cli/reference">CLI</a>, <a href="/sdk/python-api">Python</a>, <a href="/sdk/apple-api">Apple</a> and <a href="/sdk/android-api">Android</a>.</p>
    </div>
  </section>
</Base>

<style>
  .sdk { padding-block: var(--space-10); }
  .sdk h1 { font-size: var(--fh-3xl); }
  .lede { margin-top: var(--space-4); font-size: var(--ft-lg); color: var(--color-text-secondary); max-width: 64ch; }
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); margin-top: var(--space-8); }
  .pcard { display: flex; flex-direction: column; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--r-xl); background: var(--color-surface); color: inherit; }
  .pcard:hover { border-color: var(--color-primary); }
  .pcard h2 { font-size: var(--ft-lg); }
  .pcard .sub { font-size: var(--ft-xs); color: var(--color-text-tertiary); margin-top: 0.2rem; }
  .pcard .note { font-size: var(--ft-sm); color: var(--color-text-secondary); margin-top: var(--space-3); flex: 1; }
  .pcard .ver { margin-top: var(--space-3); font-size: var(--ft-xs); }
  .sec { font-size: var(--fh-lg); margin-top: var(--space-10); margin-bottom: var(--space-3); }
  .jobs { overflow-x: auto; }
  .jobs table { width: 100%; border-collapse: collapse; font-size: var(--ft-sm); }
  .jobs th, .jobs td { text-align: left; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--color-border); white-space: nowrap; }
  .jobs th { color: var(--color-text-secondary); font-weight: var(--fw-medium); }
  .more { margin-top: var(--space-6); font-size: var(--ft-sm); color: var(--color-text-secondary); }
  @media (max-width: 900px) { .gallery { grid-template-columns: 1fr; } }
</style>
