---
import Hub from "../../components/Hub.astro";

const groups = [
  {
    label: "Start here",
    featured: true,
    cards: [
      { title: "Which should I use?", desc: "Libraries vs CLI, on-device vs cloud, and the status of every binding.", href: "/sdk/overview" },
      { title: "Python", desc: "pip install bithuman — the GA on-device runtime + cloud client.", href: "/sdk/python", badge: "GA" },
    ],
  },
  {
    // Named for the platform, not for the language: the customer who asked
    // "when do the Android and iOS SDKs go live" could not find pages filed
    // under Swift and Kotlin.
    label: "Mobile — iOS & Android",
    cards: [
      { title: "iOS, iPadOS & macOS — Swift", desc: "One SwiftPM package (bitHumanKit). Expression 2 runs on any recent iPhone, but this is the gated rail: an Apple Developer team, an agent code and a key before the first frame. The Essence engines need an iPhone 16 Pro (A18 Pro) or an M-series iPad / M3 Mac.", href: "/sdk/swift", badge: "Preview" },
      { title: "Android — Kotlin", desc: "Three on-device AARs on Maven Central. expression-2 is the working rail and renders with no account, key or credits; essence-2 has no published host to fetch from and essence-1 cannot authenticate on a device. arm64-v8a only: an x86_64 emulator installs and then throws UnsatisfiedLinkError.", href: "/sdk/android", badge: "Beta" },
      { title: "Where the avatar comes from", desc: "There is no single answer — the two rails split here. Android + expression-2 needs no account, key or credits at all; every other phone rail, iOS included, needs a key and an agent code first. Plus the device floors.", href: "/sdk/overview#getting-an-avatar-model-onto-a-phone" },
      { title: "Verify the Android SDK", desc: "Every Android snippet re-run on a clean machine, with its negative control.", href: "/sdk/android-verify" },
      // Until 2026-09-09 this hub's served bytes linked NEITHER finished mobile
      // project, so the reference pages were the end of the road. These two are
      // the pages that end in a frame on a handset — they belong beside them.
      { title: "Android, end to end — the whole project", desc: "Every file of a working Kotlin app, printed in full: seven files, one WAV, no account, no API key, no credits. Measured 117 frames on a Galaxy S25+.", href: "/examples/kotlin-android-hello", badge: "Free" },
      { title: "iOS, end to end — the whole app", desc: "Every file of a working SwiftUI app that renders expression-2 on the iPhone you already have. 149 frames at 21.8 fps on an iPhone 15 — after the Apple Developer team, agent code and key.", href: "/examples/swift-ios-expression2" },
    ],
  },
  {
    label: "Languages",
    cards: [
      { title: "JavaScript / TypeScript", desc: "Cloud client over LiveKit for web and Node.", href: "/sdk/javascript", badge: "Preview" },
      { title: "WebAssembly (Browser)", desc: "Run agents fully in the browser via WASM — no server GPU.", href: "/sdk/wasm", badge: "New" },
    ],
  },
  {
    label: "Command line",
    cards: [
      { title: "bitHuman CLI", desc: "One binary runs the whole avatar stack — same engine as the libraries, no code.", href: "/sdk/cli/overview" },
      { title: "Install", desc: "One curl command — macOS (Apple Silicon) and Linux.", href: "/sdk/cli/install" },
      { title: "Commands", desc: "run, render, info, pull, list, doctor — the full surface.", href: "/sdk/cli/commands" },
      { title: "Configuration", desc: "Env vars, cache layout, and cloud vs on-device brain.", href: "/sdk/cli/configuration" },
      { title: "Local mode", desc: "Run the whole stack offline — STT, LLM, TTS, all on-device.", href: "/sdk/cli/local-mode", badge: "Offline" },
      { title: "For agents", desc: "The stable --json contract + built-in MCP server for driving the CLI from an AI agent.", href: "/sdk/cli/agents" },
    ],
  },
  {
    label: "Real-time",
    cards: [
      { title: "LiveKit transport", desc: "Connect an Apple app to a served or cloud agent — Session & Agent API.", href: "/sdk/livekit" },
      { title: "Voice agent + avatar", desc: "A realtime conversational agent with a live, lip-synced face.", href: "/examples/ai-conversation" },
    ],
  },
];
---
<Hub
  eyebrow="SDK"
  title="SDK"
  tagline="Embed lifelike, realtime visual agents on your own hardware — from Python, iOS, Android, macOS or the browser, or drive the whole stack from a single CLI command. On-device or over the cloud, one engine everywhere."
  ctas={[{ label: "New here? Start here", href: "/start" }, { label: "Android app, end to end", href: "/examples/kotlin-android-hello", variant: "secondary" }, { label: "iOS app, end to end", href: "/examples/swift-ios-expression2", variant: "secondary" }]}
  groups={groups}
/>
