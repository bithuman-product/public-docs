---
import Base from "../../layouts/Base.astro";
import { getEntry } from "astro:content";
import Code from "../../components/Code.astro";

// Six platforms, three lines each: install, get a free showcase model, run.
// Every line is a copy-paste excerpt of the platform page it links to — that
// page is the writer, this one quotes it. The performance line is not typed
// here at all: it is parsed at build time from /sdk/performance, the one
// writer for every frame-rate figure. Edit the platform page, never this file.

// /sdk/performance carries MORE THAN ONE table, and both use the same Platform
// names: the CLI table at the top has "macOS" and "Linux", and so does the
// "Python library" table further down — a different product measured on the
// same two machines. Keying a row by its Platform cell alone therefore let the
// second table overwrite the first, and the cards silently read the wrong
// product: the macOS card printed the Python row's "being re-measured" while
// the table above it said 159, and the macOS & Linux card printed the Python
// Linux 49/27 instead of the CLI's 44/29. A row is now addressed by the
// heading it lives under as well as its Platform, so a card names one product
// on one machine and a renamed heading fails the build instead of drifting.
/** Rows of every table on /sdk/performance, keyed "<heading>/<Platform>". */
async function performanceRows() {
  const perf = await getEntry("docs", "sdk/performance");
  if (!perf?.body) throw new Error("sdk/index: cannot read src/content/docs/sdk/performance.md");
  const rows = new Map<string, { hardware: string; expression2: string; essence2: string }>();
  let heading = ""; // the table before the first H2 is the CLI one
  for (const line of perf.body.split("\n")) {
    const h2 = /^##\s+(.+?)\s*$/.exec(line);
    if (h2) { heading = h2[1]; continue; }
    if (!line.startsWith("|")) continue;
    const cells = line.split("|").slice(1, -1).map((c) => c.trim());
    if (cells.length !== 4 || cells[0] === "Platform" || /^-+:?$/.test(cells[0])) continue;
    rows.set(`${heading}/${cells[0]}`, { hardware: cells[1], expression2: cells[2], essence2: cells[3] });
  }
  if (rows.size === 0) throw new Error("sdk/index: no rows parsed from the performance table");
  return rows;
}

// Since the owner's 2026-09-13 "-- is confusing" ruling, a cell on
// /sdk/performance is either a bare number, a number with a plain status
// ("12 · not yet real time"), or a status alone ("no published release yet").
// Only a bare number takes the " fps" suffix; anything else is already a
// sentence and is shown as it stands, so this page can never claim more than
// the table it reads.
const isNumber = (cell: string) => /^[0-9]+(\.[0-9]+)?$/.test(cell);

const rows = await performanceRows();

/** One machine's row, as the card shows it: hardware, then a cell per model. */
function perf(key: string) {
  const r = rows.get(key);
  if (!r) throw new Error(`sdk/index: /sdk/performance has no "${key}" row`);
  return {
    hardware: r.hardware,
    models: [
      { name: "Expression 2", cell: r.expression2 },
      { name: "Essence 2", cell: r.essence2 },
    ],
  };
}

const blocks = [
  {
    name: "macOS & Linux",
    sub: "Apple Silicon · x86_64 — one CLI, one command",
    href: "/sdk/cli",
    perfKeys: ["/macOS", "/Linux"],
    install: "curl -fsSL https://raw.githubusercontent.com/bithuman-product/homebrew-bithuman/main/install.sh | sh",
    model: "bithuman login                    # opens your browser; stores a per-device key on this machine\nbithuman pull marmalade           # prints ~/.cache/bithuman/showcase/marmalade.imx",
    run: "bithuman run \"$(bithuman pull marmalade)\"                                # live avatar in your browser",
  },
  {
    name: "iOS",
    sub: "a physical iPhone or iPad · Xcode 26+",
    href: "/sdk/ios",
    perfKeys: ["/iOS"],
    install: ".package(url: \"https://github.com/bithuman-product/homebrew-bithuman.git\", from: \"2.11.0\")\n// product: .product(name: \"Expression2\", package: \"homebrew-bithuman\")",
    model: "curl -fLO \"https://tmoobjxlwcwvxvjeppzq.supabase.co/storage/v1/object/public/web/{showcase/A08CCD3871.avatar,engines/expression-2/mac-arm64-1.0.0.engine}\"",
    run: "# In Xcode: Signing & Capabilities → your team → select your iPhone → Run",
  },
  {
    name: "Android",
    sub: "arm64-v8a · minSdk 26",
    href: "/sdk/android",
    perfKeys: ["/Android"],
    install: "implementation(\"ai.bithuman:expression2-android:0.4.1\")",
    model: "val model = Expression2ModelStore(context).fetch(\"A02HCY0444\")   // ~158 MB the first time; never on the main thread",
    run: "./gradlew :app:installDebug",
  },
  {
    name: "Web",
    sub: "any modern browser",
    href: "/sdk/web",
    perfKeys: ["/Web"],
    install: "# nothing to install",
    model: "# A74NWD9723 — or any code on /showcase",
    run: "open \"https://www.bithuman.ai/A74NWD9723?rendering_mode=browser\"",
  },
  {
    name: "Python",
    sub: "Python 3.10–3.14 · macOS arm64 · Linux x86_64 / aarch64",
    href: "/sdk/python",
    perfKeys: ["Python library/Linux", "Python library/macOS"],
    install: "pip install \"bithuman[expression-2]\"",
    model: "curl -fsSLO \"https://tmoobjxlwcwvxvjeppzq.supabase.co/storage/v1/object/public/web/showcase/{A23WJF0199.avatar,demo_sample.wav}\"",
    code: "# hello.py\nimport bithuman\n\nwith bithuman.open(\"A23WJF0199.avatar\") as avatar:      # an Essence 2 .imx or an Expression 2 .avatar — one call\n    for image in avatar.render(\"demo_sample.wav\"):     # (height, width, 3) uint8, RGB, at the avatar's own frame rate\n        print(image.shape)                             # hand it to your display — OpenCV wants image[:, :, ::-1]",
    run: "export BITHUMAN_API_SECRET=…        # free at https://www.bithuman.ai/developer/api-keys\npython hello.py",
  },
].map((b) => ({ ...b, perf: b.perfKeys.map(perf) }));
---

<Base
  title="SDK — bitHuman docs"
  description="Run a bitHuman avatar on your device. Pick a platform — macOS, Linux, iOS, Android, Web, Python: install, get a free model, run."
>
  <section class="sdk">
    <div class="container">
      <header class="sdk-head">
        <p class="eyebrow">SDK</p>
        <h1>Run a bitHuman avatar on your device</h1>
        <p class="lede">
          Pick a platform. Three commands each: install it, get a free showcase
          model, run it. Every line is copy-paste, and the platform page behind
          each card has the rest.
        </p>
      </header>

      <div class="grid">
        {blocks.map((b) => (
          <article class="block">
            <h2><a href={b.href}>{b.name}</a></h2>
            <p class="sub">{b.sub}</p>

            <ol class="steps">
              <li><span class="step">Install</span><Code code={b.install} /></li>
              <li><span class="step">Get a model</span><Code code={b.model} /></li>
              {b.code && <li><span class="step">Minimal code</span><Code code={b.code} /></li>}
              <li><span class="step">Run</span><Code code={b.run} /></li>
            </ol>

            <div class="foot">
              <div class="perf">
                {b.perf.map((m) => (
                  <div class="machine">
                    <p class="hw">{m.hardware}</p>
                    <dl>
                      {m.models.map((x) => (
                        <div class:list={["stat", { num: isNumber(x.cell) }]}>
                          <dt>{x.name}</dt>
                          <dd>{x.cell}{isNumber(x.cell) && <span class="unit"> fps</span>}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ))}
                <p class="perf-note">
                  Measured, unpaced — <a href="/sdk/performance">how each number was taken</a>
                </p>
              </div>
              <a class="guide" href={b.href}>Full guide <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .sdk { padding-block: var(--space-8) var(--space-12); }
  .sdk-head { max-width: 46rem; }
  .sdk-head h1 { font-size: var(--fh-2xl); margin-top: var(--space-2); max-width: 22ch; }
  .sdk-head .lede { margin-top: var(--space-3); font-size: var(--ft-lg); color: var(--color-text-secondary); }

  /* Two columns, not three: a card holds shell commands, and a 22rem column
     was narrower than the shortest of them. */
  .grid {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
  }
  .block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--r-2xl);
    background: var(--color-surface);
    transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .block:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-sm); }
  .block h2 { font-size: var(--fh-md); letter-spacing: -0.015em; }
  .block h2 a:hover { color: var(--color-primary); }
  .sub { margin-top: 0.25rem; color: var(--color-text-tertiary); font-size: var(--ft-sm); }

  .steps { list-style: none; margin: var(--space-5) 0 0; padding: 0; counter-reset: step; }
  .steps li { margin-top: var(--space-4); min-width: 0; }
  .steps li:first-child { margin-top: 0; }
  .step {
    counter-increment: step;
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--ft-xs);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-tertiary);
  }
  .step::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.5rem;
    border-radius: var(--r-full);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 0.65rem;
    letter-spacing: 0;
    vertical-align: -0.3rem;
  }
  .steps :global(.bh-code) { margin: 0; }

  /* Footer: the measured numbers, then the way in. The numbers are never typed
     on this page — every one comes from the /sdk/performance row named above. */
  .foot { margin-top: auto; padding-top: var(--space-5); }
  .perf {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    background: var(--color-surface-2);
  }
  .machine + .machine { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .hw { font-size: var(--ft-xs); font-weight: var(--fw-medium); text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-tertiary); }
  .machine dl { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin: var(--space-2) 0 0; }
  .stat dt { font-size: var(--ft-xs); color: var(--color-text-secondary); }
  .stat dd { margin: 0.1rem 0 0; font-size: var(--ft-sm); color: var(--color-text-secondary); }
  .stat.num dd { font-size: var(--fh-sm); font-weight: var(--fw-bold); color: var(--color-text); letter-spacing: -0.02em; }
  .stat .unit { font-size: var(--ft-sm); font-weight: var(--fw-regular); color: var(--color-text-tertiary); }
  .perf-note { margin-top: var(--space-3); font-size: var(--ft-xs); color: var(--color-text-tertiary); }
  .perf-note a { color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 2px; }
  .perf-note a:hover { color: var(--color-primary); }

  .guide {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-4);
    font-weight: var(--fw-medium);
    color: var(--color-primary);
  }
  .guide span { transition: transform var(--t-fast) var(--ease); }
  .guide:hover span { transform: translateX(3px); }

  @media (max-width: 560px) {
    .block { padding: var(--space-4); border-radius: var(--r-xl); }
    .sdk-head h1 { font-size: var(--fh-xl); }
  }
</style>
