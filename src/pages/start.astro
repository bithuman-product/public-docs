---
import Base from "../layouts/Base.astro";
import CodeTabs from "../components/CodeTabs.astro";
import LiveDemo from "../components/LiveDemo.astro";
import PathTable from "../components/PathTable.astro";
import PerfHeadline from "../components/PerfHeadline.astro";
import { hubMeta } from "../config/hubs";
import { PLATFORMS } from "../data/platforms";

const meta = hubMeta("start");
const next = (docs: string) => (docs.startsWith("/sdk/") ? `${docs}#first-frame` : docs);
---

<Base title="Get started — bitHuman docs" description={meta.description}>
  <section class="s-hero">
    <div class="container">
      <h1>Get started</h1>
      <p class="lede">Realtime talking avatars from one portrait: Essence 2 for photoreal people, Expression 2 for any character. Talk to one now, then pick how you run your own.</p>
    </div>
  </section>

  <section class="s-block">
    <div class="container s-demo">
      <LiveDemo />
      <div>
        <h2 id="api-secret">Your API secret</h2>
        <p>Everything except the web embed uses an API secret. Create one in the console, then export it:</p>
        <CodeTabs tabs={[{ label: "Shell", lang: "bash", code: `export BITHUMAN_API_SECRET="<your API secret>"` }]} />
        <p class="s-small"><a href="https://www.bithuman.ai/developer/api-keys">Create an API secret ↗</a> · <a href="/start/api-secret">How the API secret works</a></p>
      </div>
    </div>
  </section>

  <section class="s-block alt">
    <div class="container">
      <h2 id="choose-your-path">Choose your path</h2>
      <PathTable />
    </div>
  </section>

  <section class="s-block">
    <div class="container">
      <h2 id="run-it">Run it</h2>
      <p class="muted">Each block runs as pasted after you export your API secret.</p>
      {PLATFORMS.filter((p) => p.card).map((p) => (
        <article class="s-card" id={p.id}>
          <h3>{p.want} <span class="s-use">· {p.use}</span></h3>
          <CodeTabs tabs={[{ label: p.use.split(" (")[0], lang: p.card!.lang, code: p.card!.code }]} />
          <p class="s-expect"><strong>Expected:</strong> {p.card!.expect}</p>
          <p class="s-next"><a href={next(p.docs)}>Next: {p.use.split(" (")[0]} →</a></p>
        </article>
      ))}
      <article class="s-card" id="apps">
        <h3>Ship an app <span class="s-use">· Apple, Android</span></h3>
        <p>Add the dependency, then follow the platform page's first frame:</p>
        <CodeTabs tabs={PLATFORMS.filter((p) => p.id === "apple" || p.id === "android").map((p) => ({ label: p.id === "apple" ? "Swift" : "Kotlin", lang: p.id === "apple" ? "swift" : "kotlin", code: p.first }))} />
        <p class="s-next"><a href="/sdk/apple#first-frame">Apple →</a> · <a href="/sdk/android#first-frame">Android →</a> · <a href="/sdk/livekit">LiveKit →</a> · <a href="/sdk/mcp">MCP →</a></p>
      </article>
    </div>
  </section>

  <section class="s-block alt">
    <div class="container">
      <h2 id="performance">How fast it runs</h2>
      <PerfHeadline />
      <p class="s-small"><a href="/concepts/models">Which model?</a> · <a href="/guides/pricing">Pricing: credits pay for talking time; idle time is free</a> · <a href="/examples">Examples</a></p>
    </div>
  </section>
</Base>

<style>
  .s-hero { padding-block: var(--space-10) var(--space-6); border-bottom: 1px solid var(--color-border); }
  .s-hero h1 { font-size: var(--fh-3xl); }
  .s-hero .lede { margin-top: var(--space-4); font-size: var(--ft-lg); color: var(--color-text-secondary); max-width: 62ch; }
  .s-block { padding-block: var(--space-8); }
  .s-block.alt { background: var(--color-surface-2); border-block: 1px solid var(--color-border); }
  .s-block h2 { font-size: var(--fh-lg); margin-bottom: var(--space-3); }
  .s-demo { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: start; }
  .s-demo p { margin-block: var(--space-3); }
  .s-card { margin-top: var(--space-6); }
  .s-card h3 { font-size: var(--ft-lg); margin-bottom: var(--space-3); }
  .s-use { color: var(--color-text-tertiary); font-weight: var(--fw-regular); }
  .s-expect, .s-next, .s-small { margin-top: var(--space-3); font-size: var(--ft-sm); }
  .s-expect { color: var(--color-text-secondary); }
  @media (max-width: 900px) { .s-demo { grid-template-columns: 1fr; } }
</style>
