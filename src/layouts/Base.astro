---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Search from "../components/Search.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Open Graph object type: a docs page is an `article`, a hub is the site. */
  type?: "website" | "article";
  /** Per-page structured data, added to the site-wide graph as-is. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = "bitHuman Docs — Private On-Device AI Avatars in Real Time",
  description = "Build with bitHuman: turn a photo into a real-time AI avatar (up to 25 fps) that runs fully on-device. Private by design — audio, video, and prompts never leave your hardware. Self-host, deploy on-prem, or run air-gapped at the lowest per-minute cost.",
  // 1200×630 — the whole wordmark on the banner's own white, so a large-image
  // card shows all of it instead of the 3.58:1 banner cropped to 1.91:1.
  image = "/images/og-card.jpg",
  type = "website",
  jsonLd = [],
} = Astro.props;

const site = Astro.site ?? new URL("https://docs.bithuman.ai");
// One URL per page, and it is the slash-less one: the sitemap, /llms.txt, the
// nav and every redirect already spell it that way, and vercel.json's
// `trailingSlash: false` sends the other form here with a 308.
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", site).href;
const ogImage = new URL(image, site).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/bithuman-mark.png" />
    {/* The two plain-text renderings of this site, for AI agents. */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt" />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="bitHuman Docs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* JSON-LD: Organization + SoftwareApplication (site-wide), plus whatever the page adds */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        ...jsonLd,
        {
          "@type": "Organization",
          "@id": "https://www.bithuman.ai/#organization",
          "name": "bitHuman",
          "url": "https://www.bithuman.ai",
          "logo": "https://docs.bithuman.ai/bithuman-mark.png",
          "description": "bitHuman builds private, on-device AI avatars that turn any photo into a real-time video agent — self-hostable, deployable on-prem, and able to run fully air-gapped."
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://www.bithuman.ai/#software",
          "name": "bitHuman",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "macOS, Linux, iOS, iPadOS, Android, Web, Raspberry Pi OS",
          "url": "https://www.bithuman.ai",
          "publisher": { "@id": "https://www.bithuman.ai/#organization" },
          "description": "On-device AI avatar runtime and SDKs. Turn a photo into a real-time avatar (up to 25 fps) that runs fully on your own hardware — private by design, self-hostable, on-prem, and air-gapped-capable. Runs on CPU (including Raspberry Pi), NVIDIA GPU, and Apple Silicon.",
          "featureList": [
            "On-device inference — audio, video, and prompts never leave your hardware",
            "Real-time lip-sync — 25 fps (Essence 2), 20 fps (Expression 2)",
            "Runs on CPU (incl. Raspberry Pi), NVIDIA GPU, and Apple Silicon",
            "Self-hosted, on-prem, and air-gapped deployment",
            "Low per-minute cost, from 1 credit/min self-hosted"
          ],
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "description": "Free tier available; low per-minute cost from 1 credit/min self-hosted."
          }
        }
      ]
    })} />

    {/* Fonts: Roboto + Roboto Mono (bitHuman brand) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* LCP hero/showcase images are served from this CDN — warm the connection early. */}
    <link rel="preconnect" href="https://assets.bithuman.ai" crossorigin />
    {/* Load the font CSS non-render-blocking: preload it, then apply via the
         media="print"->all swap so first paint isn't gated on the Google Fonts
         round-trip. display=swap already handles the FOUT. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {/* No-FOUC theme init: set [data-theme] before paint */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("bh-theme");
          if (!t)
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Search />

    {/* theme toggle + scroll reveal */}
    <script is:inline>
      // Theme toggle
      window.__bhToggleTheme = function () {
        var el = document.documentElement;
        var next = el.getAttribute("data-theme") === "dark" ? "light" : "dark";
        el.setAttribute("data-theme", next);
        try {
          localStorage.setItem("bh-theme", next);
        } catch (e) {}
      };
      // Scroll reveal
      (function () {
        var all = document.querySelectorAll("[data-reveal]");
        // Fallback: if IntersectionObserver is unavailable, reveal everything
        // immediately so content is never stuck hidden (opacity:0).
        if (!("IntersectionObserver" in window)) {
          all.forEach(function (el) { el.classList.add("in"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        all.forEach(function (el) {
          io.observe(el);
        });
        // Backstop: never leave content hidden if observation stalls. What it
        // reveals is below the fold and unseen, so it snaps rather than fades:
        // a fade here left the page half-transparent to anything reading it
        // in that window (a contrast audit measured blended colours).
        setTimeout(function () {
          all.forEach(function (el) { el.style.transition = "none"; el.classList.add("in"); });
        }, 2500);
      })();
      // Mobile nav
      window.__bhToggleMenu = function () {
        document.documentElement.classList.toggle("nav-open");
      };
      // Every code block on the site — prose, platform cards, tabbed samples —
      // gets the same card: a bar naming the language and a Copy button that is
      // always visible. The button used to appear on hover only, which a phone
      // cannot do, and it lived inside the <pre>, so it scrolled away with the
      // code. The text is read at click time so a block filled in later (the
      // playground) copies what is on screen.
      (function () {
        document.querySelectorAll("pre").forEach(function (pre) {
          // The tabbed sample, the playground and the embed demo already draw a
          // bar with their own copy control; the API reference is a
          // third-party renderer. Everything else gets the card.
          if (pre.closest(".bh-code, .references-rendered, .ct-panel, .pg-code, .wd-code")) return;
          var code = pre.querySelector("code");
          if (!code) return;

          var card = document.createElement("div");
          card.className = "bh-code";
          var bar = document.createElement("div");
          bar.className = "bh-code-bar";
          var langName = pre.getAttribute("data-language");
          var btn = document.createElement("button");
          btn.className = "code-copy";
          btn.type = "button";
          btn.textContent = "Copy";
          btn.addEventListener("click", function () {
            navigator.clipboard.writeText(code.innerText).then(function () {
              btn.textContent = "Copied";
              btn.setAttribute("data-copied", "");
              setTimeout(function () {
                btn.textContent = "Copy";
                btn.removeAttribute("data-copied");
              }, 1400);
            }).catch(function () {});
          });
          if (langName) {
            var lang = document.createElement("span");
            lang.className = "bh-code-lang";
            lang.textContent = langName;
            bar.appendChild(lang);
          }
          bar.appendChild(btn);

          pre.replaceWith(card);
          card.appendChild(bar);
          card.appendChild(pre);
        });
      })();
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        background: var(--color-primary);
        color: var(--color-on-primary);
        padding: 0.6rem 1rem;
        border-radius: var(--r-md);
      }
      .skip-link:focus { left: 12px; top: 12px; }
    </style>
  </body>
</html>
