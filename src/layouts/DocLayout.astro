---
import Base from "./Base.astro";
import "../styles/prose.css";
import { SECTIONS, GROUP_ORDER, SIDEBAR_LINKS, type SectionId } from "../config/nav.ts";
import { HUBS } from "../config/hubs";
import { lastModified } from "../lib/git-lastmod";
import PageActions from "../components/PageActions.astro";
import Chip from "../components/Chip.astro";
import Availability from "../components/Availability.astro";
import VersionBadge from "../components/VersionBadge.astro";
import NextCards from "../components/NextCards.astro";
import LiveDemo from "../components/LiveDemo.astro";
import { RENDERS_LABEL } from "../data/labels";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  entry: any;
  all: any[];
  headings: Heading[];
}
const { entry, all, headings } = Astro.props;
const data = entry.data;
const section: SectionId = data.section;
const meta = SECTIONS[section] ?? { label: "Docs", home: "/" };

// The sidebar: this section's pages plus its .astro pages (SIDEBAR_LINKS),
// grouped in GROUP_ORDER, then by `order`. A page's label is its H1.
const slugOf = (e: any) => "/" + e.id.replace(/\/index$/, "").replace(/\.md$/, "");
type Item = { href: string; label: string; order: number };
const items: (Item & { group: string })[] = [
  ...all
    .filter((e) => e.data.section === section && !e.data.draft)
    .map((e) => ({ href: slugOf(e), label: e.data.title, order: e.data.order ?? 100, group: e.data.group || "" })),
  ...(SIDEBAR_LINKS[section] ?? []),
];
const groups: [string, Item[]][] = (GROUP_ORDER[section] ?? [])
  .map((g) => [g, items.filter((i) => i.group === g).sort((a, b) => a.order - b.order || a.label.localeCompare(b.label))] as [string, Item[]])
  .filter(([, list]) => list.length > 0);

const currentPath = slugOf(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// sequential prev/next across the section (in sidebar display order)
const flatNav = groups.flatMap(([, list]) => list);
const curIdx = flatNav.findIndex((i) => i.href === currentPath);
const prevPage = curIdx > 0 ? flatNav[curIdx - 1] : null;
const nextPage = curIdx >= 0 && curIdx < flatNav.length - 1 ? flatNav[curIdx + 1] : null;

// "Next" cards: the paths in `next`, named by their own H1 and description.
const describe = (href: string) => {
  const path = href.split("#")[0];
  const e = all.find((x) => slugOf(x) === path);
  if (e) return { href, title: e.data.title, line: e.data.description };
  const h = HUBS.find((x) => "/" + x.route === path || (x.route === "" && path === "/"));
  if (h) return { href, title: h.name, line: h.description };
  throw new Error(`${entry.id}: next names ${href}, which is not a docs page`);
};
const nextCards = (data.next ?? []).map(describe);

// Structured data for this page, from its own frontmatter and its last commit
// (the sitemap's <lastmod> source): nothing the page does not already say.
const pageUrl = `https://docs.bithuman.ai${currentPath}`;
const sourceFile = entry.filePath ?? `src/content/docs/${entry.id}.md`;
const modified = lastModified(sourceFile);
const modifiedLabel = modified ? new Date(modified).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }) : null;
const editUrl = `https://github.com/bithuman-product/public-docs/edit/main/${sourceFile}`;
const crumbs = [
  { name: "Docs", item: "https://docs.bithuman.ai/" },
  { name: meta.label, item: `https://docs.bithuman.ai${meta.home}` },
  { name: data.title, item: pageUrl },
];
const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "TechArticle",
    "@id": `${pageUrl}#article`,
    headline: data.title,
    ...(data.description ? { description: data.description } : {}),
    url: pageUrl,
    inLanguage: "en",
    ...(modified ? { dateModified: modified } : {}),
    author: { "@id": "https://www.bithuman.ai/#organization" },
    publisher: { "@id": "https://www.bithuman.ai/#organization" },
    isPartOf: { "@type": "WebSite", name: "bitHuman Docs", url: "https://docs.bithuman.ai/" },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.item })),
  },
];
if (section === "platforms" && data.type === "platform") {
  jsonLd.push({
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#software`,
    name: data.title,
    ...(data.description ? { description: data.description } : {}),
    url: pageUrl,
    applicationCategory: "DeveloperApplication",
    publisher: { "@id": "https://www.bithuman.ai/#organization" },
  });
}
const hasChips = !!(data.availability || data.renders?.length || data.needs?.length || data.artifacts?.length);
const demoModels = data.demo === "both" ? ["essence-2", "expression-2"] : data.demo ? [data.demo] : null;
// On a hub the comparison comes first and the demo closes the page (under its "Try it" section).
// Under the lede the demo's poster is the largest thing on screen, so it loads eagerly
// with high priority (a lazy image waits for layout and costs the page its LCP).
const demoAtEnd = data.type === "hub";
// Release notes are records and the generated references are lookups: both
// searchable, but ranked below the pages a reader starts from.
// An example page names its platform in its title ("iOS Expression 2"), so it
// ranks just below that platform's own page for the platform's name.
const weight = data.type === "changelog" ? "0.2" : data.type === "reference" && section === "platforms" ? "0.5" : data.type === "example" ? "0.6" : undefined;
---

<Base title={`${data.title} — bitHuman docs`} description={data.description} type="article" jsonLd={jsonLd} markdown={`${currentPath}.md`}>
  <div class="doc">
    {/* sidebar */}
    <aside class="doc-side" aria-label="Section pages" data-doc-side data-pagefind-ignore>
      <button class="side-toggle" data-side-toggle aria-expanded="false">
        <span>{meta.label}</span>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 5 7 8.5 10.5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <nav class="side-inner" aria-label={meta.label}>
        <a class="side-home" href={meta.home}>{meta.label}</a>
        {
          groups.map(([g, list]) => (
            <div class="side-group">
              {g && <p class="side-glabel">{g}</p>}
              <ul>
                {list.map((i) => (
                  <li>
                    <a href={i.href} class:list={["side-link", { active: i.href === currentPath }]} aria-current={i.href === currentPath ? "page" : undefined}>
                      {i.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    {/* content */}
    <article class="doc-main" data-pagefind-filter={`section:${meta.label}`}>
      <nav class="doc-crumb" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href="/">Docs</a> <span aria-hidden="true">/</span> <a href={meta.home}>{meta.label}</a>
        {data.group && data.group !== meta.label && (<Fragment> <span aria-hidden="true">/</span> <span class="crumb-cur">{data.group}</span></Fragment>)}
      </nav>
      <div class="prose" data-pagefind-weight={weight}>
        <div class="doc-h1"><h1 data-pagefind-meta={data.searchTitle ? `title:${data.searchTitle}` : undefined}>{data.title}</h1><PageActions md={`${currentPath}.md`} /></div>
        {data.description && <p class="doc-lede">{data.description}</p>}
        {hasChips && (
          <div class="chip-row doc-chips" data-pagefind-ignore>
            {data.availability && <Availability plan={data.availability} />}
            {(data.renders ?? []).map((r: keyof typeof RENDERS_LABEL) => <Chip kind="where" label={RENDERS_LABEL[r]} />)}
            {(data.needs ?? []).map((n: string) => <Chip kind="needs" label={n} />)}
            {(data.artifacts ?? []).map((a: any) => <VersionBadge artifact={a} />)}
          </div>
        )}
        {demoModels && !demoAtEnd && <div class="doc-demo"><LiveDemo models={demoModels as any} eager /></div>}
        <div class="doc-body"><slot /></div>
        {demoModels && demoAtEnd && <div class="doc-demo"><LiveDemo models={demoModels as any} /></div>}
      </div>
      <NextCards items={nextCards} />
      <footer class="doc-meta" data-pagefind-ignore>
        {modifiedLabel && <span>Last updated <time datetime={modified!}>{modifiedLabel}</time></span>}
        <a href={editUrl} rel="noopener">Edit this page on GitHub</a>
      </footer>
      {
        (prevPage || nextPage) && (
          <nav class="doc-pager" aria-label="Previous and next page" data-pagefind-ignore>
            {prevPage ? (
              <a class="pager" href={prevPage.href}>
                <span>← Previous</span>
                <strong>{prevPage.label}</strong>
              </a>
            ) : <span />}
            {nextPage && (
              <a class="pager next" href={nextPage.href}>
                <span>Next →</span>
                <strong>{nextPage.label}</strong>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {/* on-this-page TOC */}
    <aside class="doc-toc" aria-label="Page outline" data-pagefind-ignore>
      {
        toc.length > 0 && (
          <nav aria-label="On this page">
            <p class="toc-label">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class:list={[`toc-d${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </aside>
  </div>

  <script>
    import "../scripts/md-tabs";
    document.querySelectorAll("[data-side-toggle]").forEach((b) => {
      b.addEventListener("click", () => {
        const side = b.closest("[data-doc-side]");
        const open = side!.classList.toggle("open");
        b.setAttribute("aria-expanded", open ? "true" : "false");
      });
    });

    // "On this page" marks the section you are reading. The rail already drew a
    // transparent left border for it and nothing ever turned the border on, so
    // a reader halfway down a long page had no idea where they were.
    (() => {
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".doc-toc a[href^='#']")];
      if (links.length < 2) return;
      const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
      const headings = [...byId.keys()]
        .map((id) => document.getElementById(id))
        .filter((h): h is HTMLElement => !!h);
      if (!headings.length) return;

      const mark = () => {
        const line = window.scrollY + 140;
        let current = headings[0];
        for (const h of headings) if (h.offsetTop <= line) current = h;
        for (const a of links) a.classList.remove("here");
        byId.get(current.id)?.classList.add("here");
      };
      let queued = false;
      addEventListener("scroll", () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; mark(); });
      }, { passive: true });
      mark();
    })();
  </script>
</Base>

<style>
  .doc {
    max-width: var(--container-wide);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 200px;
    gap: var(--space-8);
    padding-inline: var(--space-5);
    align-items: start;
  }
  /* sidebar */
  .doc-side { position: sticky; top: var(--nav-h); height: calc(100vh - var(--nav-h)); overflow-y: auto; padding-block: var(--space-6); }
  .side-home { display: block; font-weight: var(--fw-bold); font-size: var(--ft-md); margin-bottom: var(--space-4); }
  .side-toggle { display: none; width: 100%; align-items: center; justify-content: space-between; padding: 0.65rem 0.85rem; border: 1px solid var(--color-border); border-radius: var(--r-md); background: var(--color-surface); color: var(--color-text); font: inherit; font-weight: var(--fw-medium); font-size: var(--ft-sm); }
  .side-toggle svg { transition: transform var(--t-fast) var(--ease); }
  .doc-side.open .side-toggle svg { transform: rotate(180deg); }
  .side-group { margin-bottom: var(--space-5); }
  .side-glabel { font-size: var(--ft-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-tertiary); margin-bottom: var(--space-2); }
  .side-group ul { list-style: none; padding: 0; margin: 0; }
  .side-link { display: block; padding: 0.32rem 0.6rem; margin-left: -0.6rem; border-radius: var(--r-md); font-size: var(--ft-sm); color: var(--color-text-secondary); border-left: 2px solid transparent; }
  .side-link:hover { color: var(--color-text); background: var(--color-surface-2); }
  .side-link.active { color: var(--color-primary); font-weight: var(--fw-medium); background: var(--color-primary-soft); border-left-color: var(--color-primary); }
  /* content */
  .doc-main { padding-block: var(--space-8); min-width: 0; }
  .doc-crumb { font-size: var(--ft-sm); color: var(--color-text-tertiary); margin-bottom: var(--space-4); }
  .doc-crumb a { color: var(--color-text-tertiary); }
  .doc-crumb a:hover { color: var(--color-primary); }
  .doc-crumb span { margin: 0 0.3rem; }
  .doc-crumb .crumb-cur { margin: 0; color: var(--color-text-secondary); }
  .doc-lede { font-size: var(--ft-lg); color: var(--color-text-secondary); margin-top: 0 !important; }
  .doc-chips { margin-top: calc(-1 * var(--s-2)) !important; }
  .doc-demo { margin-block: var(--s-6) var(--s-8); }
  .doc-demo :global(.ld) { max-width: 380px; margin-inline: 0; }
  .doc-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-4); margin-top: var(--s-8); font-size: var(--ft-sm); color: var(--color-text-tertiary); }
  .doc-meta a { color: var(--color-text-secondary); }
  .doc-meta a:hover { color: var(--color-primary); }
  .doc-pager { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-5); padding-top: var(--space-6); border-top: 1px solid var(--color-border); }
  .pager { display: flex; flex-direction: column; gap: 0.2rem; padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--r-lg); transition: all var(--t-fast) var(--ease); max-width: 48%; }
  .pager:hover { border-color: var(--color-primary); }
  .pager.next { text-align: right; align-items: flex-end; margin-left: auto; }
  .pager span { font-size: var(--ft-xs); color: var(--color-text-tertiary); }
  .pager strong { color: var(--color-primary); font-size: var(--ft-sm); }
  /* toc */
  .doc-toc { position: sticky; top: var(--nav-h); padding-block: var(--space-8); font-size: var(--ft-sm); min-width: 0; }
  .toc-label { font-size: var(--ft-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-tertiary); margin-bottom: var(--space-2); }
  .doc-toc ul { list-style: none; padding: 0; margin: 0; }
  /* A heading can be a file path. Without this the 200px rail was 328px wide
     and pushed the whole page sideways on a 1440px screen. */
  .doc-toc a { display: block; padding: 0.22rem 0; color: var(--color-text-tertiary); border-left: 2px solid transparent; padding-left: 0.6rem; overflow-wrap: anywhere; }
  .doc-toc a:hover { color: var(--color-text); }
  .doc-toc a.here { color: var(--color-text); border-left-color: var(--color-primary); }
  .toc-d3 a { padding-left: 1.3rem; font-size: var(--ft-xs); }

  @media (max-width: 1080px) { .doc { grid-template-columns: 230px minmax(0,1fr); } .doc-toc { display: none; } }
  @media (max-width: 820px) {
    .doc { grid-template-columns: 1fr; gap: 0; }
    .doc-side { position: static; height: auto; overflow: visible; padding-block: var(--space-4); border-bottom: 1px solid var(--color-border); }
    .side-toggle { display: flex; }
    .doc-side .side-inner { display: none; padding-top: var(--space-3); }
    .doc-side.open .side-inner { display: block; }
    .side-home { display: none; }
    .doc-main { padding-block: var(--space-6); }
  }
</style>
