---
import { endpointRoutes } from "../markdown/rehype-endpoints.mjs";
import Base from "./Base.astro";
import "../styles/prose.css";
import { SECTIONS, COLLAPSED_GROUPS, type SectionId } from "../config/nav.ts";
import { sidebarGroups, flatten, slugOf } from "../lib/sidebar";
import SideNav from "../components/SideNav.astro";
import { HUBS } from "../config/hubs";
import { lastModified } from "../lib/git-lastmod";
import PageActions from "../components/PageActions.astro";
import NextCards from "../components/NextCards.astro";
import LiveDemo from "../components/LiveDemo.astro";
import PerfExplorer from "../components/PerfExplorer.astro";
import CreditCalculator from "../components/CreditCalculator.astro";
import MatrixFilter from "../components/MatrixFilter.astro";
import Figure from "../components/Figure.astro";
import Gallery from "../components/Gallery.astro";
import Diagram from "../components/Diagram.astro";
import DataFlowExplorer from "../components/DataFlowExplorer.astro";
import Walkthrough from "../components/Walkthrough.astro";
import { widgetsIn } from "../lib/doc-blocks";
import ChangelogFilter from "../components/ChangelogFilter.astro";
import MovedAnchors from "../components/MovedAnchors.astro";
import { RENDERS_LABEL, PLAN_LABEL, versionLabel } from "../data/labels";
import Stuck from "../components/Stuck.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  entry: any;
  all: any[];
  headings: Heading[];
}
const { entry, all, headings } = Astro.props;
const data = entry.data;
const section: SectionId = data.section;
const meta = SECTIONS[section] ?? { label: "Docs", home: "/" };

// The sidebar: this tab's pages and links, grouped (src/lib/sidebar.ts).
const groups = sidebarGroups(all, section);
const collapsed = COLLAPSED_GROUPS[section] ?? [];

const currentPath = slugOf(entry);
// an API resource page with endpoint sections (docs v2 W5): two columns, no outline rail
const isEndpoints = endpointRoutes().has(currentPath);
// "On this page" lists H2s only, at most 8 (H3 ids stay on the page).
const toc = headings.filter((h) => h.depth === 2).slice(0, 8);

// sequential prev/next across the section (in sidebar display order)
const flatNav = flatten(groups);
const curIdx = flatNav.findIndex((i) => i.href === currentPath);
const prevPage = curIdx > 0 ? flatNav[curIdx - 1] : null;
const nextPage = curIdx >= 0 && curIdx < flatNav.length - 1 ? flatNav[curIdx + 1] : null;

// "Next" cards: the paths in `next`, named by their own H1 and description.
const describe = (href: string) => {
  const path = href.split("#")[0];
  const e = all.find((x) => slugOf(x) === path);
  if (e) return { href, title: e.data.title, line: e.data.description };
  const h = HUBS.find((x) => "/" + x.route === path || (x.route === "" && path === "/"));
  if (h) return { href, title: h.name, line: h.description };
  throw new Error(`${entry.id}: next names ${href}, which is not a docs page`);
};
const nextCards = (data.next ?? []).map(describe);

// Structured data for this page, from its own frontmatter and its last commit
// (the sitemap's <lastmod> source): nothing the page does not already say.
const pageUrl = `https://docs.bithuman.ai${currentPath}`;
const sourceFile = entry.filePath ?? `src/content/docs/${entry.id}.md`;
const modified = lastModified(sourceFile);
const modifiedLabel = modified ? new Date(modified).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }) : null;
const editUrl = `https://github.com/bithuman-product/public-docs/edit/main/${sourceFile}`;
// No analytics on the docs, so feedback is an issue: titled with the page, its URL in the body.
const issueUrl = `https://github.com/bithuman-product/public-docs/issues/new?${new URLSearchParams({
  title: `Docs: ${data.title}`,
  body: `Page: https://docs.bithuman.ai/${currentPath.replace(/^\//, "")}\n\nWhat was missing or wrong:\n`,
}).toString()}`;
// The Overview tab's home is the docs home itself, so its pages skip a second "/" crumb.
const crumbs = [
  { name: "Docs", item: "https://docs.bithuman.ai/" },
  ...(meta.home === "/" ? [] : [{ name: meta.label, item: `https://docs.bithuman.ai${meta.home}` }]),
  { name: data.title, item: pageUrl },
];
const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "TechArticle",
    "@id": `${pageUrl}#article`,
    headline: data.title,
    ...(data.description ? { description: data.description } : {}),
    url: pageUrl,
    inLanguage: "en",
    ...(modified ? { dateModified: modified } : {}),
    author: { "@id": "https://www.bithuman.ai/#organization" },
    publisher: { "@id": "https://www.bithuman.ai/#organization" },
    isPartOf: { "@type": "WebSite", name: "bitHuman Docs", url: "https://docs.bithuman.ai/" },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.item })),
  },
];
if (section === "platforms" && data.type === "platform") {
  jsonLd.push({
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#software`,
    name: data.title,
    ...(data.description ? { description: data.description } : {}),
    url: pageUrl,
    applicationCategory: "DeveloperApplication",
    publisher: { "@id": "https://www.bithuman.ai/#organization" },
  });
}
// The meta line under the lead replaces the chips: plain text, "·" between items.
// The plan and the versions keep their links (text colour).
const metaItems: { label: string; href?: string }[] = [
  ...(data.time ? [{ label: data.time }] : []),
  ...(data.availability ? [{ label: PLAN_LABEL[data.availability as keyof typeof PLAN_LABEL], href: "/pricing" }] : []),
  ...(data.renders ?? []).map((r: keyof typeof RENDERS_LABEL) => ({ label: RENDERS_LABEL[r] })),
  ...(data.needs ?? []).map((n: string) => ({ label: n })),
  ...(data.artifacts ?? []).map((a: any) => ({ label: versionLabel(a), href: "/downloads" })),
];
// The interactive blocks this page places bring their script and styles; other pages carry none.
const widgets = widgetsIn(entry.body ?? "");
const demoModels = data.demo === "both" ? ["essence-2", "expression-2"] : data.demo ? [data.demo] : null;
// On a hub the comparison comes first and the demo closes the page (under its "Try it" section).
// Under the lede the demo's poster is the largest thing on screen, so it loads eagerly
// with high priority (a lazy image waits for layout and costs the page its LCP).
const demoAtEnd = data.type === "hub";
// A quickstart (each platform page) and a troubleshooting page (each platform's, and
// /resources/troubleshooting, which is in the troubleshooting llms section) end with
// "Stuck?" (#support on Discord).
const stuck = data.type === "platform" || data.type === "troubleshooting" || data.llms === "troubleshooting";
// Release notes are records and the generated references are lookups: both
// searchable, but ranked below the pages a reader starts from.
// An example page names its platform in its title ("iOS Expression 2"), so it
// ranks just below that platform's own page for the platform's name.
// The browser tab and search engines show the search title when a page has one (the H1 stays the sidebar label).
const weight = data.type === "changelog" ? "0.2" : (data.type === "reference" || data.type === "troubleshooting" || data.type === "platform-app") && section === "platforms" ? "0.5" : data.type === "example" ? "0.6" : undefined;
---

<Base title={`${data.searchTitle ?? data.title} — bitHuman docs`} description={data.description} type="article" jsonLd={jsonLd} markdown={`${currentPath}.md`}>
  {/* Below 768 px the section's pages sit in the header drawer, under the tabs. */}
  <nav class="drawer-side" slot="drawer" aria-label={meta.label}>
    <SideNav groups={groups} current={currentPath} collapsed={collapsed} label={meta.label} />
  </nav>
  <div class:list={["doc", { "doc-ep": isEndpoints }]}>
    {/* sidebar: the current tab only */}
    <aside class="doc-side" aria-label="Section pages" data-doc-side data-pagefind-ignore>
      <nav class="side-inner" aria-label={meta.label}>
        <SideNav groups={groups} current={currentPath} collapsed={collapsed} label="" />
      </nav>
    </aside>

    {/* content */}
    <article class="doc-main" data-pagefind-filter={`section:${meta.label}`}>
      {/* No desktop breadcrumbs (the JSON-LD BreadcrumbList stays); a phone gets "‹ Section". */}
      <div class="prose" data-pagefind-weight={weight}>
        <a class="doc-back" href={meta.home} data-pagefind-ignore>‹ {meta.label}</a>
        <header class="doc-head">
          <h1 data-pagefind-meta={data.searchTitle ? `title:${data.searchTitle}` : undefined}>{data.title}</h1>
          {data.description && <p class="doc-lede" data-subtitle>{data.description}</p>}
          {metaItems.length > 0 && (
            <p class="doc-metaline" data-pagefind-ignore>
              {metaItems.map((m, i) => (
                <Fragment>{i > 0 && <span class="dm-sep" aria-hidden="true"> · </span>}{m.href ? <a href={m.href}>{m.label}</a> : <span>{m.label}</span>}</Fragment>
              ))}
            </p>
          )}
          <div class="doc-head-actions"><PageActions md={`${currentPath}.md`} /></div>
        </header>
        {demoModels && !demoAtEnd && <div class="doc-demo"><LiveDemo models={demoModels as any} eager /></div>}
        <div class="doc-body"><slot /></div>
        {stuck && <Stuck />}
        {data.moved && <MovedAnchors moved={data.moved} />}
        {demoModels && demoAtEnd && <div class="doc-demo"><LiveDemo models={demoModels as any} /></div>}
      </div>
      <NextCards items={nextCards} />
      {
        (prevPage || nextPage) && (
          <nav class="doc-pager" aria-label="Previous and next page" data-pagefind-ignore>
            {prevPage ? (
              <a class="pager" href={prevPage.href}>
                <span>Previous</span>
                <strong>‹ {prevPage.label}</strong>
              </a>
            ) : <span />}
            {nextPage && (
              <a class="pager next" href={nextPage.href}>
                <span>Next</span>
                <strong>{nextPage.label} ›</strong>
              </a>
            )}
          </nav>
        )
      }
      <footer class="doc-meta" data-pagefind-ignore>
        {modifiedLabel && <span>Updated <time datetime={modified!}>{modifiedLabel}</time></span>}
        {modifiedLabel && <span aria-hidden="true">·</span>}
        <a href={editUrl} rel="noopener">Edit</a>
        <span aria-hidden="true">·</span>
        <a href={issueUrl} rel="noopener">Report an issue</a>
      </footer>
    </article>
    {widgets.has("perf-explorer") && <PerfExplorer />}
    {widgets.has("calculator") && <CreditCalculator />}
    {widgets.has("matrix-filter") && <MatrixFilter />}
    {widgets.has("figure") && <Figure />}
    {widgets.has("gallery") && <Gallery />}
    {widgets.has("diagram") && <Diagram />}
    {widgets.has("dataflow") && <DataFlowExplorer />}
    {widgets.has("walkthrough") && <Walkthrough />}
    {widgets.has("changelog") && <ChangelogFilter />}

    {/* on-this-page TOC (≥1280 px): H2s only, then "Copy page" */}
    <aside class="doc-toc" aria-label="Page outline" data-pagefind-ignore>
      {
        toc.length > 0 && (
          <nav aria-label="On this page">
            <p class="toc-label">On this page</p>
            <ul>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )
      }
      <div class="toc-actions"><PageActions md={`${currentPath}.md`} /></div>
    </aside>
  </div>

  <script>
    import "../scripts/tabs-sync";

    // "On this page" marks the section you are reading. The rail already drew a
    // transparent left border for it and nothing ever turned the border on, so
    // a reader halfway down a long page had no idea where they were.
    (() => {
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".doc-toc a[href^='#']")];
      if (links.length < 2) return;
      const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
      const headings = [...byId.keys()]
        .map((id) => document.getElementById(id))
        .filter((h): h is HTMLElement => !!h);
      if (!headings.length) return;

      const mark = () => {
        const line = window.scrollY + 140;
        let current = headings[0];
        for (const h of headings) if (h.offsetTop <= line) current = h;
        for (const a of links) a.classList.remove("here");
        byId.get(current.id)?.classList.add("here");
      };
      let queued = false;
      addEventListener("scroll", () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; mark(); });
      }, { passive: true });
      mark();
    })();
  </script>
</Base>

<style>
  .doc {
    max-width: var(--container-wide);
    margin-inline: auto;
    display: grid;
    grid-template-columns: var(--side-w) minmax(0, 1fr) var(--toc-w);
    gap: var(--s-12);
    padding-inline: var(--s-6);
    align-items: start;
  }
  /* sidebar: group labels 14/500 text, items 14/400 text-2 in 32 px rows, the
     active item a surface-2 pill */
  .doc-side { position: sticky; top: var(--nav-h); max-height: calc(100vh - var(--nav-h)); overflow-y: auto; padding-block: var(--s-8); }
  :global(.side-group) { margin-bottom: var(--s-6); }
  :global(.side-glabel) { font-size: var(--ft-sm); font-weight: var(--fw-medium); line-height: var(--lh-14); color: var(--color-text); margin-bottom: var(--s-1); }
  :global(.side-group ul) { list-style: none; padding: 0; margin: 0; }
  :global(.side-link) { display: flex; align-items: center; min-height: 32px; padding: var(--s-1) var(--s-3); margin-left: calc(-1 * var(--s-3)); border-radius: var(--r-6); font-size: var(--ft-sm); line-height: var(--lh-14); color: var(--color-text-secondary); transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease); }
  :global(.side-link:hover) { color: var(--color-text); }
  :global(.side-link.active) { color: var(--color-text); background: var(--color-surface-3); }
  :global(.side-sub) { list-style: none; margin: 0 0 var(--s-1) var(--s-3) !important; padding-left: var(--s-3) !important; border-left: 1px solid var(--color-border); }
  :global(.side-fold > summary) { cursor: pointer; list-style: none; }
  :global(.side-fold > summary::-webkit-details-marker) { display: none; }
  :global(.side-fold > summary::after) { content: " ▸"; color: var(--color-text-tertiary); }
  :global(.side-fold[open] > summary::after) { content: " ▾"; }
  :global(.side-ext) { color: var(--color-text-tertiary); }
  /* the drawer copy (below 768 px only) */
  .drawer-side { display: flex; flex-direction: column; }
  .drawer-side :global(.side-group) { margin: 0; }
  .drawer-side :global(.side-group + .side-group) { margin-top: var(--s-2); }
  .drawer-side :global(.side-link) { margin-left: 0; padding-inline: var(--s-3); font-size: var(--ft-md); }
  /* content */
  .doc-main { padding-block: var(--s-8) var(--s-12); min-width: 0; max-width: var(--wide-w); }
  /* the crumb sits in the prose text track, so it lines up with the H1 */
  .prose > .doc-back { display: none; justify-self: start; font-size: var(--ft-sm); color: var(--color-text-secondary); text-decoration: none; margin: 0 0 var(--s-3); }
  .prose > .doc-back:hover { color: var(--color-text); }
  /* page head to body is 32: nothing in the head or at the top of the body adds to it */
  .doc-head { margin-bottom: var(--s-8); }
  .doc-head > :global(:last-child), .doc-head > :global(p) { margin-bottom: 0 !important; }
  .doc-body > :global(:first-child) { margin-top: 0 !important; }
  .doc-head :global(h1) { font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: var(--fw-bold); letter-spacing: -0.01em; margin: 0; }
  .doc-lede { margin-top: var(--s-3) !important; font-size: var(--ft-lg); line-height: var(--lh-18); color: var(--color-text-secondary); max-width: var(--text-w); }
  .doc-metaline { margin-top: var(--s-3) !important; font-size: var(--ft-sm); line-height: var(--lh-14); color: var(--color-text-tertiary); }
  .doc-metaline a { color: var(--color-text-tertiary); text-decoration: none; }
  .doc-metaline a:hover { color: var(--color-text); }
  .doc-head-actions { margin-top: var(--s-4); }
  .doc-demo { margin-block: var(--s-6) var(--s-8); }
  /* a demo right under the head keeps the same 32 (grid margins do not collapse) */
  .doc-head + .doc-demo { margin-top: 0; }
  .doc-demo :global(.ld) { max-width: 380px; margin-inline: 0; }
  .doc-pager { display: flex; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-12); }
  .pager { display: flex; flex-direction: column; gap: var(--s-1); max-width: 48%; color: var(--color-text); }
  .pager.next { text-align: right; align-items: flex-end; margin-left: auto; }
  .pager span { font-size: var(--ft-xs); color: var(--color-text-tertiary); }
  .pager strong { font-size: var(--ft-sm); font-weight: var(--fw-medium); }
  .pager:hover strong { text-decoration: underline; text-underline-offset: 3px; }
  .doc-meta { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-8); padding-top: var(--s-4); border-top: 1px solid var(--color-border); font-size: var(--ft-xs); line-height: var(--lh-12); color: var(--color-text-tertiary); }
  .doc-meta a { color: var(--color-text-tertiary); }
  .doc-meta a:hover { color: var(--color-text); }
  /* toc */
  .doc-toc { position: sticky; top: var(--nav-h); padding-block: var(--s-8); font-size: var(--ft-sm); min-width: 0; }
  .toc-label { font-size: var(--ft-sm); font-weight: var(--fw-medium); color: var(--color-text); margin-bottom: var(--s-2); }
  .doc-toc ul { list-style: none; padding: 0; margin: 0; }
  /* A heading can be a file path: wrap it inside the 200 px rail. */
  .doc-toc a { display: block; padding: var(--s-1) 0 var(--s-1) var(--s-3); line-height: var(--lh-14); color: var(--color-text-secondary); border-left: 2px solid transparent; overflow-wrap: anywhere; transition: color var(--t-fast) var(--ease); }
  .doc-toc a:hover { color: var(--color-text); }
  .doc-toc a.here { color: var(--color-text); border-left-color: var(--color-text); }
  .toc-actions { margin-top: var(--s-6); }
  .doc-head-actions { display: none; }

  /* endpoint pages (docs v2 W5): the code column takes the outline rail's place */
  @media (min-width: 1280px) {
    .doc.doc-ep { max-width: 1440px; grid-template-columns: var(--side-w) minmax(0, 1fr); }
    .doc-ep .doc-toc { display: none; }
    .doc-ep .doc-main { max-width: none; }
    .doc-ep .doc-head-actions { display: block; }
  }
  /* 1024–1279: no TOC; "Copy page" moves to the end of the page head */
  @media (max-width: 1279px) {
    .doc { grid-template-columns: var(--side-w) minmax(0, 1fr); }
    .doc-toc { display: none; }
    .doc-head-actions { display: block; }
  }
  /* below 1024: the sidebar goes; 768–1023 keeps the tab row, below 768 the drawer holds it */
  @media (max-width: 1023px) {
    .doc { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .doc-side { display: none; }
    .prose > .doc-back { display: inline-block; }
  }
  @media (max-width: 767px) {
    .doc { padding-inline: var(--s-4); }
    .doc-main { padding-block: var(--s-6) var(--s-8); }
  }
</style>
